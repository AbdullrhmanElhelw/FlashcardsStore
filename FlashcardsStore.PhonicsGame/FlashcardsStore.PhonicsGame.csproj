<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>FlashcardsStore.PhonicsGame</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>

		<ApplicationTitle>ألعاب فونكس - خلود النادي</ApplicationTitle>
		<ApplicationId>com.kholoudelnady.phonicsgame</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<AndroidManifestPlaceholders>usesCleartextTraffic=false</AndroidManifestPlaceholders>
		<PublishReadyToRun>false</PublishReadyToRun>

		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<AndroidManifestPlaceholders>usesCleartextTraffic=true</AndroidManifestPlaceholders>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#18061A" BaseSize="128,128" />
		<MauiSplashScreen Include="Resources\Splash\splash_logo.png" Color="#260B18" BaseSize="250,250" />
		<MauiFont Include="Resources\Fonts\*" />
		<EmbeddedResource Include="Resources\Localization\*.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
