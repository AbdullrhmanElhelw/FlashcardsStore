@inject SpeechService Speech
@inject ActivationService Activation
@inject GameProgressService Progress
@inject IJSRuntime JS
@implements IDisposable

<div class="shell">
    <!-- Top Bar -->
    <header class="topbar">
        <div>
            <div class="brand-title">ألعاب الفونكس 🎈</div>
            <div class="brand-sub">أكاديمية خلود النادي</div>
        </div>
        <div class="pill-row">
            <div class="stat-pill">⭐ @Progress.TotalStars</div>
            @if (Activation.IsActivated)
            {
                <span class="btn-activated-badge">✅ مفعّل</span>
            }
            else
            {
                <button class="btn-activate-pill" @onclick="OpenActivationModal">🔓 كود التفعيل</button>
            }
        </div>
    </header>

    <main class="container">
        @if (_activeStage is null)
        {
            <!-- Mode Selector -->
            <div class="mode-tabs">
                <div class="mode-tab @(_selectedMode == GameMode.WordBuilder ? "active" : "")"
                     @onclick="() => _selectedMode = GameMode.WordBuilder">
                    <span class="mode-tab-icon">🧩</span>
                    <div class="mode-tab-title">تركيب الكلمة</div>
                    <div class="mode-tab-sub">اسحب الحروف وركّبها</div>
                </div>
                <div class="mode-tab @(_selectedMode == GameMode.SoundMatch ? "active" : "")"
                     @onclick="() => _selectedMode = GameMode.SoundMatch">
                    <span class="mode-tab-icon">🔊</span>
                    <div class="mode-tab-title">طابق الصوت بالصورة</div>
                    <div class="mode-tab-sub">اسمع واختار الصح</div>
                </div>
            </div>

            <!-- Stages List -->
            <div class="stages-grid">
                @foreach (var stage in PhonicsCurriculum.Stages)
                {
                    var unlocked = stage.IsFree || Activation.IsActivated;
                    var completedCount = stage.Words.Count(w => _completedWords.Contains(w.Word));
                    var pct = stage.Words.Count > 0 ? (int)Math.Round(completedCount * 100.0 / stage.Words.Count) : 0;

                    <div class="stage-card @(unlocked ? "" : "locked")"
                         style="background: linear-gradient(135deg, @stage.GradientStart, @stage.GradientEnd);"
                         @onclick="() => StartStage(stage)">
                        <div class="stage-icon-bubble">@stage.BadgeIcon</div>
                        <div class="stage-info">
                            <div class="stage-title">@stage.TitleAr</div>
                            <div class="stage-sub">@stage.TitleEn • @stage.SubtitleAr</div>
                            <div class="stage-progress-bar">
                                <div class="stage-progress-fill" style="width: @pct%"></div>
                            </div>
                        </div>
                        <div class="stage-action-badge">
                            @if (unlocked)
                            {
                                <span>العب (@completedCount/@stage.Words.Count)</span>
                            }
                            else
                            {
                                <span>🔒 مقفول</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (_stageFinished)
        {
            <div class="picture-stage" style="padding: 32px 20px;">
                <div style="font-size: 72px; margin-bottom: 10px;">🏆</div>
                <h2 style="margin: 0 0 8px; color: var(--plum);">أحسنت يا بطل!</h2>
                <p style="color: var(--muted); margin: 0 0 20px;">
                    أتممت @_activeStage.TitleAr بنجاح وجمعت @_stageStars نجمة جديدة!
                </p>
                <button class="btn-primary" @onclick="ExitStage">العودة للمراحل</button>
            </div>
        }
        else
        {
            <!-- Active Game Header -->
            <div class="game-header">
                <button class="btn-back" @onclick="ExitStage">← المراحل</button>
                <div class="progress-dots">
                    @for (var i = 0; i < _activeStage.Words.Count; i++)
                    {
                        var cls = i < _wordIndex ? "done" : (i == _wordIndex ? "current" : "");
                        <span class="progress-dot @cls"></span>
                    }
                </div>
                <div class="stat-pill" style="background: var(--plum); font-size: 13px;">🔥 @_streak</div>
            </div>

            @if (_selectedMode == GameMode.WordBuilder)
            {
                <!-- Word Builder Mode -->
                <div class="picture-stage">
                    <div class="picture-circle" style="background: @_currentWord.BgColor;">
                        @_currentWord.Emoji
                    </div>
                    <div class="arabic-hint">@_currentWord.ArabicMeaning</div>
                    <div class="audio-controls">
                        <button class="btn-speak" @onclick="SpeakCurrentWord">🔊 اسمع الكلمة</button>
                        <button class="btn-speak slow" @onclick="SpeakCurrentWordSlow">🐢 نطق بطيء</button>
                    </div>
                </div>

                <!-- Letter Slots -->
                <div class="slots-row">
                    @for (var i = 0; i < _slots.Length; i++)
                    {
                        var slotIdx = i;
                        var tileIdx = _slots[slotIdx];
                        var isVowelSlot = !_currentWord.IsSightWord && _currentWord.Word.Length == 3 && slotIdx == 1;
                        var hasLetter = tileIdx >= 0;
                        var slotClass = "letter-slot";
                        if (isVowelSlot) slotClass += " vowel-slot";
                        if (hasLetter) slotClass += " filled";
                        if (_wordSolved) slotClass += " correct";
                        else if (_builderWrongFlash) slotClass += " wrong";

                        <div class="@slotClass"
                             data-slot-index="@slotIdx"
                             @onclick="() => ClearSlot(slotIdx)">
                            @(hasLetter ? _tiles[tileIdx].Letter : "")
                        </div>
                    }
                </div>

                <!-- Letter Tiles Bank -->
                <div class="tiles-bank">
                    @for (var i = 0; i < _tiles.Count; i++)
                    {
                        var tileIdx = i;
                        var tile = _tiles[tileIdx];
                        var tileClass = "letter-tile" + (IsVowel(tile.Letter) ? " vowel-tile" : "") + (tile.Used ? " used" : "");

                        <div class="@tileClass"
                             @onpointerdown="(e) => HandleTilePointerDown(tileIdx, e)">
                            @tile.Letter
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Sound Match Mode -->
                <div class="picture-stage">
                    <div style="font-size: 56px; margin-bottom: 6px;">🎧</div>
                    <div class="arabic-hint">اسمع الكلمة واختار الصورة الصح</div>
                    <div class="audio-controls">
                        <button class="btn-speak" @onclick="SpeakCurrentWord">🔊 اسمع الكلمة</button>
                        <button class="btn-speak slow" @onclick="SpeakCurrentWordSlow">🐢 ببطء</button>
                    </div>
                </div>

                <div class="match-grid">
                    @foreach (var opt in _matchOptions)
                    {
                        var isRight = _wordSolved && opt.Word == _currentWord.Word;
                        var isWrong = _wrongMatchWord == opt.Word;
                        var cardClass = "match-card" + (isRight ? " correct" : "") + (isWrong ? " wrong" : "");

                        <div class="@cardClass" @onclick="() => SelectMatchOption(opt)">
                            <span class="match-emoji">@opt.Emoji</span>
                            <div class="match-ar">@opt.ArabicMeaning</div>
                            @if (isRight)
                            {
                                <div style="margin-top: 4px; font-weight: 900; color: #059669; direction: ltr;">@opt.Word.ToUpperInvariant()</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_wordSolved)
            {
                <div class="celebrate-banner">
                    <div>
                        <div style="font-size: 16px; font-weight: 900;">ممتاز! 🌟 (@_currentWord.Word.ToUpperInvariant())</div>
                        <div style="font-size: 12px; opacity: 0.9;">+1 نجمة ذهبية</div>
                    </div>
                    <button class="btn-next" @onclick="NextWord">التالي ←</button>
                </div>
            }
        }
    </main>
</div>

<!-- Activation Modal -->
@if (_showActivationModal)
{
    <div class="modal-backdrop" @onclick="CloseActivationModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div style="font-size: 44px;">🔑</div>
            <h3 style="margin: 6px 0; color: var(--plum);">تفعيل جميع المراحل</h3>
            <p style="font-size: 13px; color: var(--muted); margin: 0 0 8px;">
                أدخل كود التفعيل الموجود مع باقة الفلاش كاردز أو الاشتراك الرمزي لفتح المراحل من 3 إلى 6.
            </p>

            <input class="code-input"
                   placeholder="KHO-XXXX-XXXX"
                   @bind="_activationCodeInput"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(_activationFeedback))
            {
                <div style="font-size: 13px; font-weight: 700; margin-bottom: 10px; color: @(_activationSuccess ? "#059669" : "#E11D48");">
                    @_activationFeedback
                </div>
            }

            <button class="btn-primary" disabled="@_isActivating" @onclick="SubmitActivationAsync">
                @(_isActivating ? "جاري التحقق..." : "تفعيل الكود الآن")
            </button>

            <a class="btn-whatsapp"
               href="https://wa.me/201099887766?text=%D8%A3%D9%87%D9%84%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D9%83%D9%88%D8%AF%20%D8%AA%D9%81%D8%B9%D9%8A%D9%84%20%D9%84%D8%AA%D8%B7%D8%A8%D9%8A%D9%82%20%D8%A3%D9%84%D8%B9%D8%A7%D8%A8%20%D8%A7%D9%84%D9%81%D9%88%D9%86%D9%83%D8%B3"
               target="_blank">
                💬 اطلب كود تفعيل عبر واتساب
            </a>

            <button class="btn-close-link" @onclick="CloseActivationModal">إغلاق</button>
        </div>
    </div>
}

@code {
    private enum GameMode { WordBuilder, SoundMatch }

    private sealed class TileItem
    {
        public char Letter { get; init; }
        public bool Used { get; set; }
    }

    private readonly Random _rng = new();
    private DotNetObjectReference<AppRoot>? _dotNetRef;

    private GameMode _selectedMode = GameMode.WordBuilder;
    private HashSet<string> _completedWords = new(StringComparer.OrdinalIgnoreCase);

    private PhonicsStage? _activeStage;
    private int _wordIndex;
    private int _stageStars;
    private int _streak;
    private bool _stageFinished;
    private bool _wordSolved;

    // Word Builder state
    private int[] _slots = [];
    private List<TileItem> _tiles = [];
    private bool _builderWrongFlash;

    // Sound Match state
    private List<PhonicsWord> _matchOptions = [];
    private string? _wrongMatchWord;

    // Activation modal state
    private bool _showActivationModal;
    private string _activationCodeInput = string.Empty;
    private string _activationFeedback = string.Empty;
    private bool _activationSuccess;
    private bool _isActivating;

    private PhonicsWord _currentWord => _activeStage!.Words[_wordIndex];

    protected override void OnInitialized()
    {
        _completedWords = Progress.GetCompletedWords();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("phonicsDrag.register", _dotNetRef);
        }
    }

    private async Task StartStage(PhonicsStage stage)
    {
        if (!stage.IsFree && !Activation.IsActivated)
        {
            OpenActivationModal();
            return;
        }

        _activeStage = stage;
        _wordIndex = 0;
        _stageStars = 0;
        _streak = 0;
        _stageFinished = false;
        await SetupCurrentWordAsync();
    }

    private void ExitStage()
    {
        _activeStage = null;
        _stageFinished = false;
        _completedWords = Progress.GetCompletedWords();
    }

    private async Task SetupCurrentWordAsync()
    {
        _wordSolved = false;
        _builderWrongFlash = false;
        _wrongMatchWord = null;

        var word = _currentWord.Word.ToLowerInvariant();

        if (_selectedMode == GameMode.WordBuilder)
        {
            _slots = Enumerable.Repeat(-1, word.Length).ToArray();
            var letters = word.ToCharArray().ToList();

            // Add 2 distractor letters for gentle challenge
            const string distractors = "bcdfghlmnprst";
            while (letters.Count < word.Length + 2)
            {
                var candidate = distractors[_rng.Next(distractors.Length)];
                if (!letters.Contains(candidate))
                    letters.Add(candidate);
            }

            _tiles = letters
                .OrderBy(_ => _rng.Next())
                .Select(c => new TileItem { Letter = char.ToUpperInvariant(c), Used = false })
                .ToList();
        }
        else
        {
            var pool = PhonicsCurriculum.Stages
                .SelectMany(s => s.Words)
                .Where(w => !string.Equals(w.Word, _currentWord.Word, StringComparison.OrdinalIgnoreCase))
                .OrderBy(_ => _rng.Next())
                .Take(3)
                .ToList();

            pool.Add(_currentWord);
            _matchOptions = pool.OrderBy(_ => _rng.Next()).ToList();
        }

        await InvokeAsync(StateHasChanged);
        await SpeakCurrentWord();
    }

    private async Task HandleTilePointerDown(int tileIdx, PointerEventArgs e)
    {
        if (_wordSolved || tileIdx < 0 || tileIdx >= _tiles.Count || _tiles[tileIdx].Used)
            return;

        var letter = _tiles[tileIdx].Letter;
        await JS.InvokeVoidAsync("phonicsDrag.startDrag", tileIdx, letter.ToString(), IsVowel(letter), e.ClientX, e.ClientY);
    }

    [JSInvokable]
    public async Task OnTileTapped(int tileIdx)
    {
        if (_wordSolved || tileIdx < 0 || tileIdx >= _tiles.Count || _tiles[tileIdx].Used)
            return;

        var emptySlot = Array.FindIndex(_slots, s => s < 0);
        if (emptySlot >= 0)
        {
            await PlaceTileInSlotAsync(tileIdx, emptySlot);
        }
    }

    [JSInvokable]
    public async Task OnTileDroppedOnSlot(int tileIdx, int slotIdx)
    {
        if (_wordSolved || tileIdx < 0 || tileIdx >= _tiles.Count || _tiles[tileIdx].Used)
            return;

        if (slotIdx < 0 || slotIdx >= _slots.Length)
            return;

        await PlaceTileInSlotAsync(tileIdx, slotIdx);
    }

    private async Task PlaceTileInSlotAsync(int tileIdx, int slotIdx)
    {
        if (_slots[slotIdx] >= 0)
        {
            _tiles[_slots[slotIdx]].Used = false;
        }

        _slots[slotIdx] = tileIdx;
        _tiles[tileIdx].Used = true;

        await JS.InvokeVoidAsync("phonicsAudio.pop");
        _ = Speech.SpeakLetterAsync(_tiles[tileIdx].Letter);

        if (_slots.All(s => s >= 0))
        {
            var built = new string(_slots.Select(idx => char.ToLowerInvariant(_tiles[idx].Letter)).ToArray());
            if (string.Equals(built, _currentWord.Word, StringComparison.OrdinalIgnoreCase))
            {
                await MarkWordSolvedAsync();
            }
            else
            {
                _builderWrongFlash = true;
                _streak = 0;
                await JS.InvokeVoidAsync("phonicsAudio.wrong");
                await InvokeAsync(StateHasChanged);
                await Task.Delay(550);

                for (var i = 0; i < _slots.Length; i++)
                {
                    if (_slots[i] >= 0)
                        _tiles[_slots[i]].Used = false;
                    _slots[i] = -1;
                }
                _builderWrongFlash = false;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearSlot(int slotIdx)
    {
        if (_wordSolved || slotIdx < 0 || slotIdx >= _slots.Length || _slots[slotIdx] < 0)
            return;

        _tiles[_slots[slotIdx]].Used = false;
        _slots[slotIdx] = -1;
        await JS.InvokeVoidAsync("phonicsAudio.pop");
    }

    private async Task SelectMatchOption(PhonicsWord option)
    {
        if (_wordSolved) return;

        if (string.Equals(option.Word, _currentWord.Word, StringComparison.OrdinalIgnoreCase))
        {
            await MarkWordSolvedAsync();
        }
        else
        {
            _wrongMatchWord = option.Word;
            _streak = 0;
            await JS.InvokeVoidAsync("phonicsAudio.wrong");
            StateHasChanged();
            await Task.Delay(450);
            _wrongMatchWord = null;
        }
    }

    private async Task MarkWordSolvedAsync()
    {
        _wordSolved = true;
        _streak++;
        _stageStars++;
        Progress.RecordWordCompleted(_currentWord.Word, 1, _streak);
        _completedWords = Progress.GetCompletedWords();

        await JS.InvokeVoidAsync("phonicsAudio.success");
        await Speech.SpeakAsync($"Great job! {_currentWord.Word}", pitch: 1.15f);
    }

    private async Task NextWord()
    {
        if (_activeStage is null) return;

        if (_wordIndex + 1 < _activeStage.Words.Count)
        {
            _wordIndex++;
            await SetupCurrentWordAsync();
        }
        else
        {
            _stageFinished = true;
            await JS.InvokeVoidAsync("phonicsAudio.success");
        }
    }

    private Task SpeakCurrentWord() => Speech.SpeakAsync(_currentWord.Word, pitch: 1.05f);

    private async Task SpeakCurrentWordSlow()
    {
        var letters = string.Join(", ", _currentWord.Word.ToCharArray());
        await Speech.SpeakAsync($"{letters}. {_currentWord.Word}", pitch: 1.0f);
    }

    private static bool IsVowel(char c)
        => "AEIOUaeiou".IndexOf(c) >= 0;

    private void OpenActivationModal()
    {
        _activationFeedback = string.Empty;
        _activationSuccess = false;
        _showActivationModal = true;
    }

    private void CloseActivationModal() => _showActivationModal = false;

    private async Task SubmitActivationAsync()
    {
        _isActivating = true;
        _activationFeedback = string.Empty;

        var result = await Activation.ActivateAsync(_activationCodeInput);
        _activationSuccess = result.Success;
        _activationFeedback = result.MessageAr;
        _isActivating = false;

        if (result.Success)
        {
            await JS.InvokeVoidAsync("phonicsAudio.success");
            await Task.Delay(900);
            _showActivationModal = false;
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
