@inherits PhonicsComponentBase<AppShellViewModel>

@if (Vm.CurrentScreen == AppScreen.Splash)
{
    <SplashScreen />
}
else if (Vm.CurrentScreen == AppScreen.Onboarding)
{
    <OnboardingView />
}
else
{
    <div class="shell">
        <TopBar />
        <main class="container">
            @if (Vm.CurrentScreen == AppScreen.Home)
            {
                <HomeView />
            }
            else if (Vm.CurrentScreen == AppScreen.Playing)
            {
                <GameArenaView />
            }
            else if (Vm.CurrentScreen == AppScreen.Soundboard)
            {
                <SoundboardView />
            }
            else if (Vm.CurrentScreen == AppScreen.StoryPlayer)
            {
                <StoryPlayerView />
            }
            else if (Vm.CurrentScreen == AppScreen.Shop)
            {
                <ShopView />
            }
            else if (Vm.CurrentScreen == AppScreen.Dictionary)
            {
                <DictionaryView />
            }
            else if (Vm.CurrentScreen == AppScreen.ParentReport)
            {
                <ParentReportView />
            }
        </main>
    </div>
    <ActivationModal />
    <ProfileModal />
}
