@inject PhonicsGameViewModel Vm
@inject IJSRuntime JS
@implements IDisposable

@if (Vm.CurrentScreen == AppScreen.Splash)
{
    <SplashScreen />
}
else if (Vm.CurrentScreen == AppScreen.Onboarding)
{
    <OnboardingView />
}
else
{
    <div class="shell">
        <TopBar />
        <main class="container">
            @if (Vm.CurrentScreen == AppScreen.Home)
            {
                <HomeView />
            }
            else if (Vm.CurrentScreen == AppScreen.Playing)
            {
                <GameArenaView />
            }
            else if (Vm.CurrentScreen == AppScreen.Soundboard)
            {
                <SoundboardView />
            }
            else if (Vm.CurrentScreen == AppScreen.StoryPlayer)
            {
                <StoryPlayerView />
            }
            else if (Vm.CurrentScreen == AppScreen.Shop)
            {
                <ShopView />
            }
        </main>
    </div>
    <ActivationModal />
    <ProfileModal />
}

@code {
    protected override void OnInitialized()
    {
        Vm.StateChanged += OnVmChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Vm.InitializeAsync(JS);
        }
    }

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Vm.StateChanged -= OnVmChanged;
    }
}
