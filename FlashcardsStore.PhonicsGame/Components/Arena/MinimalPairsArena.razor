@inherits PhonicsComponentBase<GameArenaViewModel>

@if (Vm.CurrentMinimalPair is not null)
{
    var pair = Vm.CurrentMinimalPair;
    var shortRight = Vm.WordSolved && !Vm.MinimalTargetIsLong;
    var longRight = Vm.WordSolved && Vm.MinimalTargetIsLong;
    var shortWrong = Vm.MinimalWrongWord == pair.ShortWord;
    var longWrong = Vm.MinimalWrongWord == pair.LongWord;

    <div class="picture-stage">
        <div class="icon-svg" style="width:54px;height:54px;margin:0 auto 10px;color:var(--plum);">
            @((MarkupString)UiIcons.Headphones)
        </div>
        <div class="arabic-hint">@Loc.T("MinimalPrompt")</div>
        <div class="audio-controls">
            <button class="btn-speak" @onclick="Vm.SpeakCurrentMinimalPairAsync">
                <span class="icon-svg" style="width:16px;height:16px;">@((MarkupString)UiIcons.Volume)</span>
                <span>@Loc.T("ListenWord")</span>
            </button>
        </div>
    </div>

    <div class="match-grid">
        <button class="match-card @(shortRight ? "correct" : "") @(shortWrong ? "wrong" : "")"
                @onclick="() => Vm.SelectMinimalOptionAsync(false)">
            <div style="font-size:28px;font-weight:900;color:var(--plum);direction:ltr;">@pair.ShortWord.ToUpperInvariant()</div>
            @if (Loc.IsArabic)
            {
                <div style="font-size:12px;color:var(--muted);margin-top:4px;">@pair.ShortArabic</div>
            }
        </button>
        <button class="match-card @(longRight ? "correct" : "") @(longWrong ? "wrong" : "")"
                @onclick="() => Vm.SelectMinimalOptionAsync(true)">
            <div style="font-size:28px;font-weight:900;color:#D97706;direction:ltr;">@pair.LongWord.ToUpperInvariant()</div>
            @if (Loc.IsArabic)
            {
                <div style="font-size:12px;color:var(--muted);margin-top:4px;">@pair.LongArabic</div>
            }
        </button>
    </div>

    @if (Vm.WordSolved)
    {
        <div class="celebrate-banner">
            <div style="font-weight:900;">@Loc.T("GreatJob") (@pair.ShortWord ↔ @pair.LongWord)</div>
            <button class="btn-next" @onclick="Vm.NextMinimalPairAsync">@Loc.T("NextWord")</button>
        </div>
    }
}
