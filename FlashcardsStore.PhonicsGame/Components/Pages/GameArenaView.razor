@inherits PhonicsComponentBase<GameArenaViewModel>

@if (Vm.StageFinished)
{
    <CertificateCard />
}
else if (Vm.ActiveStage is not null)
{
    <div class="game-header">
        <button class="btn-back" @onclick="Shell.GoHome">
            <span class="icon-svg" style="width:15px;height:15px;">
                @((MarkupString)(Loc.IsArabic ? UiIcons.ChevronRight : UiIcons.ChevronLeft))
            </span>
            <span>@Loc.T("BackToStages")</span>
        </button>
        <div class="progress-dots">
            @for (var i = 0; i < Vm.ActiveStage.Words.Count; i++)
            {
                var cls = i < Vm.WordIndex ? "done" : (i == Vm.WordIndex ? "current" : "");
                <span class="progress-dot @cls"></span>
            }
        </div>
        <div class="stat-pill" style="background: var(--plum); font-size: 13px;">
            <span class="icon-svg" style="width:14px;height:14px;color:#FB923C;">@((MarkupString)UiIcons.Flame)</span>
            <span>@Vm.Streak</span>
        </div>
    </div>

    @switch (Vm.SelectedMode)
    {
        case GameMode.WordBuilder:
            <WordBuilderArena />
            break;
        case GameMode.SoundMatch:
            <SoundMatchArena />
            break;
        case GameMode.MemoryMatch:
            <MemoryMatchArena />
            break;
        case GameMode.SentenceBuilder:
            <SentenceBuilderArena />
            break;
        case GameMode.RhymingMatch:
            <RhymingMatchArena />
            break;
        case GameMode.MinimalPairs:
            <MinimalPairsArena />
            break;
    }

    @if (Vm.WordSolved
         && Vm.SelectedMode != GameMode.SentenceBuilder
         && Vm.SelectedMode != GameMode.RhymingMatch
         && Vm.SelectedMode != GameMode.MinimalPairs)
    {
        <div class="celebrate-banner">
            <div>
                <div style="font-size: 16px; font-weight: 900; display:flex; align-items:center; gap:6px;">
                    <span>@Loc.T("GreatJob")</span>
                    <span>(@Vm.CurrentWord.Word.ToUpperInvariant())</span>
                </div>
                <div style="font-size: 12px; opacity: 0.9;">@Loc.T("OneStarEarned")</div>
            </div>
            <button class="btn-next" @onclick="Vm.NextWordAsync">
                <span>@Loc.T("NextWord")</span>
                <span class="icon-svg" style="width:15px;height:15px;">
                    @((MarkupString)(Loc.IsArabic ? UiIcons.ChevronLeft : UiIcons.ChevronRight))
                </span>
            </button>
        </div>
    }
}
