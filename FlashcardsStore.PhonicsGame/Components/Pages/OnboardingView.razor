@inherits PhonicsComponentBase<OnboardingViewModel>

<div class="onb-screen">
    <div class="onb-top">
        <div class="onb-brand-mini">
            <img src="images/logo_gold.png" alt="Logo" />
            <span>@Loc.T("AcademyName")</span>
        </div>
        <button class="onb-skip" @onclick="Vm.CompleteOnboarding">@Loc.T("Skip")</button>
    </div>

    <div class="onb-body">
        @if (Vm.SlideIndex == 0)
        {
            <div class="onb-art-card" style="width:128px;height:128px;padding:30px;margin-bottom:18px;">
                <span class="icon-svg" style="width:100%;height:100%;">@((MarkupString)UiIcons.Globe)</span>
            </div>
            <h2 class="onb-title">@Loc.T("OnbLangTitle")</h2>
            <p class="onb-desc" style="margin-bottom:18px;">@Loc.T("OnbLangDesc")</p>

            <div class="onb-lang-grid">
                <div class="onb-lang-card @(Loc.IsArabic ? "selected" : "")" @onclick='() => Vm.SetLanguageAsync("ar")'>
                    <div class="onb-lang-code">ع</div>
                    <div class="onb-lang-name">العربية</div>
                </div>
                <div class="onb-lang-card @(!Loc.IsArabic ? "selected" : "")" @onclick='() => Vm.SetLanguageAsync("en")'>
                    <div class="onb-lang-code">En</div>
                    <div class="onb-lang-name">English</div>
                </div>
            </div>
        }
        else if (Vm.SlideIndex == 1)
        {
            <h2 class="onb-title">@Loc.T("OnbOverviewTitle")</h2>
            <p class="onb-desc" style="margin-bottom:16px;">@Loc.T("OnbOverviewDesc")</p>

            <div class="onb-feat-list">
                <div class="onb-feat-item">
                    <span class="onb-feat-icon icon-svg">@((MarkupString)UiIcons.Puzzle)</span>
                    <span>@Loc.T("OnbFeat1")</span>
                </div>
                <div class="onb-feat-item">
                    <span class="onb-feat-icon icon-svg">@((MarkupString)UiIcons.BookOpen)</span>
                    <span>@Loc.T("OnbFeat2")</span>
                </div>
                <div class="onb-feat-item">
                    <span class="onb-feat-icon icon-svg">@((MarkupString)UiIcons.Volume)</span>
                    <span>@Loc.T("OnbFeat3")</span>
                </div>
                <div class="onb-feat-item">
                    <span class="onb-feat-icon icon-svg">@((MarkupString)UiIcons.Mic)</span>
                    <span>@Loc.T("OnbFeat4")</span>
                </div>
            </div>
        }
        else if (Vm.SlideIndex == 2)
        {
            <h2 class="onb-title">@Loc.T("OnbFocusTitle")</h2>
            <p class="onb-desc" style="margin-bottom:16px;">@Loc.T("OnbFocusDesc")</p>

            <div class="onb-goal-list">
                <div class="onb-goal-item @(Vm.Focus == "words" ? "selected" : "")"
                     @onclick='() => Vm.Focus = "words"'>
                    <span class="icon-svg" style="width:22px;height:22px;color:var(--plum);">@((MarkupString)UiIcons.Puzzle)</span>
                    <span>@Loc.T("FocusWords")</span>
                </div>
                <div class="onb-goal-item @(Vm.Focus == "stories" ? "selected" : "")"
                     @onclick='() => Vm.Focus = "stories"'>
                    <span class="icon-svg" style="width:22px;height:22px;color:#EA580C;">@((MarkupString)UiIcons.BookOpen)</span>
                    <span>@Loc.T("FocusStories")</span>
                </div>
                <div class="onb-goal-item @(Vm.Focus == "sentences" ? "selected" : "")"
                     @onclick='() => Vm.Focus = "sentences"'>
                    <span class="icon-svg" style="width:22px;height:22px;color:#2563EB;">@((MarkupString)UiIcons.Sparkles)</span>
                    <span>@Loc.T("FocusSentences")</span>
                </div>
            </div>
        }
        else if (Vm.SlideIndex == 3)
        {
            <h2 class="onb-title">@Loc.T("OnbStep2Title")</h2>
            <p class="onb-desc" style="margin-bottom:14px;">@Loc.T("OnbStep2Desc")</p>

            <input class="profile-name-input"
                   maxlength="24"
                   placeholder="@Loc.T("ProfileNamePlaceholder")"
                   @bind="Vm.NameInput"
                   @bind:event="oninput" />

            <div class="avatar-grid" style="margin-bottom:0;">
                @foreach (var av in AvatarArtwork.Avatars)
                {
                    var selected = Vm.AvatarInput == av.Key;
                    <div class="avatar-opt @(selected ? "selected" : "")"
                         @onclick="() => Vm.AvatarInput = av.Key">
                        <div class="avatar-opt-svg">@((MarkupString)AvatarArtwork.GetSvg(av.Key))</div>
                        <div class="avatar-opt-lbl">@(Loc.IsArabic ? av.LabelAr : av.LabelEn)</div>
                    </div>
                }
            </div>
        }
        else
        {
            <h2 class="onb-title">@Loc.T("OnbStep3Title")</h2>
            <p class="onb-desc" style="margin-bottom:16px;">@Loc.T("OnbStep3Desc")</p>

            <div class="onb-goal-list">
                @foreach (var goal in new[] { (5, "Goal5Label"), (10, "Goal10Label"), (15, "Goal15Label") })
                {
                    var selected = Vm.GoalMinutes == goal.Item1;
                    <div class="onb-goal-item @(selected ? "selected" : "")"
                         @onclick="() => Vm.GoalMinutes = goal.Item1">
                        <span class="icon-svg" style="width:20px;height:20px;color:#F59E0B;">@((MarkupString)UiIcons.Flame)</span>
                        <span>@Loc.T(goal.Item2)</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="onb-footer">
        <div class="onb-dots">
            @for (var i = 0; i < 5; i++)
            {
                var idx = i;
                <span class="onb-dot @(Vm.SlideIndex == idx ? "active" : "")"
                      @onclick="() => Vm.SetSlide(idx)"></span>
            }
        </div>
        <button class="btn-primary" @onclick="Vm.NextSlide">
            @(Vm.SlideIndex == 4 ? Loc.T("StartPlaying") : Loc.T("Next"))
        </button>
    </div>
</div>
