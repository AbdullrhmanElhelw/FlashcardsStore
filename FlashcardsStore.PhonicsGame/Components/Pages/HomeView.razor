@inherits PhonicsComponentBase<HomeViewModel>

@{
    var displayName = string.IsNullOrWhiteSpace(Vm.Profile.Name)
        ? Loc.T("DefaultHeroName")
        : Vm.Profile.Name;
}

<div class="hero-card">
    <div style="display:flex;align-items:center;gap:10px;cursor:pointer;" @onclick="Modals.OpenProfileModal">
        <div class="hero-avatar-btn">
            @((MarkupString)AvatarArtwork.GetSvg(Vm.Profile.AvatarKey))
        </div>
        <div>
            <div class="hero-greeting">
                <span>@(Loc.IsArabic ? $"أهلاً {displayName}!" : $"Hello, {displayName}!")</span>
                <span class="icon-svg" style="width:15px;height:15px;color:#F59E0B;">@((MarkupString)UiIcons.Sparkles)</span>
            </div>
            <div class="hero-sub">@Loc.T("HeroSub")</div>
        </div>
    </div>
    <div class="hero-stats">
        <div class="hero-chip">
            <div class="hero-chip-val">@Vm.CompletedWords.Count/@Vm.TotalWordsCount</div>
            <div class="hero-chip-lbl">@Loc.T("WordsMastered")</div>
        </div>
        <div class="hero-chip">
            <div class="hero-chip-val">
                <span class="icon-svg" style="width:14px;height:14px;color:#EA580C;">@((MarkupString)UiIcons.Flame)</span>
                <span>@Vm.TotalXp</span>
            </div>
            <div class="hero-chip-lbl">@Loc.T("XpLabel")</div>
        </div>
    </div>
</div>

<!-- Daily Challenge Card -->
<div class="daily-card @(Vm.IsDailyDoneToday ? "done" : "")" @onclick="Vm.StartDailyChallengeAsync">
    <div style="display:flex;align-items:center;gap:11px;">
        <div class="daily-icon">
            <span class="icon-svg" style="width:22px;height:22px;">@((MarkupString)UiIcons.Calendar)</span>
        </div>
        <div>
            <div class="daily-title">@Loc.T("DailyTitle")</div>
            <div class="daily-sub">@Loc.T("DailySub")</div>
        </div>
    </div>
    <div class="daily-badge">
        @(Vm.IsDailyDoneToday ? Loc.T("DailyDone") : Loc.T("DailyStart"))
    </div>
</div>

@if (Vm.WeakWords.Count > 0)
{
    <div class="weak-card" @onclick="Vm.StartWeakWordsReviewAsync">
        <div style="display:flex;align-items:center;gap:11px;">
            <div class="weak-icon">
                <span class="icon-svg" style="width:20px;height:20px;">@((MarkupString)UiIcons.RefreshCw)</span>
            </div>
            <div>
                <div style="font-size:13.5px;font-weight:900;color:#881337;">@Loc.T("WeakWordsTitle") (@Vm.WeakWords.Count)</div>
                <div style="font-size:11px;font-weight:600;color:#9F1239;">@Loc.T("WeakWordsSub")</div>
            </div>
        </div>
        <div class="weak-badge">@Loc.T("WeakWordsBtn")</div>
    </div>
}

<!-- Achievements Strip -->
<div class="achievements-strip">
    @foreach (var badge in Vm.GetAchievements())
    {
        <div class="ach-pill @(badge.Unlocked ? "unlocked" : "")">
            <span class="icon-svg" style="width:14px;height:14px;">@((MarkupString)UiIcons.Award)</span>
            <span>@(Loc.IsArabic ? badge.TitleAr : badge.TitleEn)</span>
        </div>
    }
</div>

<!-- Jolly Phonics Cards (Picture + Action + Tracing) & Picture Dictionary -->
<div class="extra-modes-row" style="grid-template-columns:1fr 1fr;margin-bottom:14px;">
    <div class="soundboard-cta" style="margin-bottom:0;" @onclick="Vm.OpenSoundboard">
        <div style="display:flex;align-items:center;gap:9px;">
            <div class="icon-svg" style="width:34px;height:34px;padding:6px;border-radius:10px;background:rgba(255,255,255,0.14);color:#FDE047;">
                @((MarkupString)UiIcons.BookOpen)
            </div>
            <div>
                <div style="font-size:12.5px;font-weight:900;">@Loc.T("SoundboardTitle")</div>
                <div style="font-size:10px;color:#FDE68A;">@Loc.T("SoundboardMiniSub")</div>
            </div>
        </div>
    </div>
    <div class="soundboard-cta" style="margin-bottom:0;background:linear-gradient(135deg,#0F766E,#14B8A6);" @onclick="Vm.OpenDictionary">
        <div style="display:flex;align-items:center;gap:9px;">
            <div class="icon-svg" style="width:34px;height:34px;padding:6px;border-radius:10px;background:rgba(255,255,255,0.16);color:#fff;">
                @((MarkupString)UiIcons.Search)
            </div>
            <div>
                <div style="font-size:12.5px;font-weight:900;">@Loc.T("DictTitle")</div>
                <div style="font-size:10px;color:#CCFBF1;">@Vm.TotalWordsCount @Loc.T("WordsMastered")</div>
            </div>
        </div>
    </div>
</div>

<!-- Game Mode Selector: Blend, Listen & Pick, Record Voice, Trace & Write -->
<div class="mode-tabs" style="grid-template-columns:repeat(2,1fr);">
    <div class="mode-tab @(Vm.SelectedMode == GameMode.WordBuilder ? "active" : "")"
         @onclick="() => Vm.SetMode(GameMode.WordBuilder)">
        <div class="mode-tab-icon icon-svg">@((MarkupString)UiIcons.Puzzle)</div>
        <div class="mode-tab-title">@Loc.T("ModeBuilderTitle")</div>
        <div class="mode-tab-sub">@Loc.T("ModeBuilderSub")</div>
    </div>
    <div class="mode-tab @(Vm.SelectedMode == GameMode.SoundMatch ? "active" : "")"
         @onclick="() => Vm.SetMode(GameMode.SoundMatch)">
        <div class="mode-tab-icon icon-svg">@((MarkupString)UiIcons.Headphones)</div>
        <div class="mode-tab-title">@Loc.T("ModeMatchTitle")</div>
        <div class="mode-tab-sub">@Loc.T("ModeMatchSub")</div>
    </div>
    <div class="mode-tab @(Vm.SelectedMode == GameMode.SpeakRepeat ? "active" : "")"
         @onclick="() => Vm.SetMode(GameMode.SpeakRepeat)">
        <div class="mode-tab-icon icon-svg">@((MarkupString)UiIcons.Mic)</div>
        <div class="mode-tab-title">@Loc.T("ModeRepeatTitle")</div>
        <div class="mode-tab-sub">@Loc.T("ModeRepeatSub")</div>
    </div>
    <div class="mode-tab @(Vm.SelectedMode == GameMode.TraceWrite ? "active" : "")"
         @onclick="() => Vm.SetMode(GameMode.TraceWrite)">
        <div class="mode-tab-icon icon-svg">@((MarkupString)UiIcons.Sparkles)</div>
        <div class="mode-tab-title">@Loc.T("ModeTraceTitle")</div>
        <div class="mode-tab-sub">@Loc.T("ModeTraceSub")</div>
    </div>
</div>

<!-- 4 Jolly Phonics Progression Phases -->
<div class="section-heading">
    <span>@Loc.T("LearningPathTitle")</span>
</div>

<div class="cat-tabs">
    @foreach (var cat in new[] { ("letters", "CatLetters"), ("blending", "CatBlending"), ("digraphs", "CatDigraphs"), ("silent", "CatSilent") })
    {
        <button class="cat-tab @(Vm.SelectedCategory == cat.Item1 ? "active" : "")"
                @onclick="() => Vm.SetCategory(cat.Item1)">
            @Loc.T(cat.Item2)
        </button>
    }
</div>

<div class="duo-path">
    @{
        var firstActiveFound = false;
        var filteredStages = Vm.GetFilteredStages();
    }
    @for (var i = 0; i < filteredStages.Count; i++)
    {
        var stage = filteredStages[i];
        var unlocked = stage.IsFree || Vm.IsActivated;
        var completedCount = stage.Words.Count(w => Vm.CompletedWords.Contains(w.Word));
        var isDone = completedCount >= stage.Words.Count;
        var isCurrent = unlocked && !isDone && !firstActiveFound;
        if (isCurrent) firstActiveFound = true;

        var posClass = (i % 4) switch
        {
            1 => "pos-right",
            3 => "pos-left",
            _ => "pos-center"
        };

        <div class="duo-node-wrap @posClass">
            @if (isCurrent)
            {
                <div class="duo-start-callout">@Loc.T("StartNodeTag")</div>
            }

            <button class="duo-node-btn @(unlocked ? "" : "locked") @(isCurrent ? "active-node" : "")"
                    style="background: linear-gradient(145deg, @stage.GradientStart, @stage.GradientEnd);"
                    @onclick="() => Vm.StartStageAsync(stage)">
                <div class="duo-node-inner">
                    @((MarkupString)WordArtwork.GetSvg(stage.BadgeKey, stage.GradientEnd))
                </div>
                @if (!unlocked)
                {
                    <div class="duo-lock-badge">@((MarkupString)UiIcons.Lock)</div>
                }
            </button>

            <div class="duo-node-label">
                <div class="duo-node-title">@(Loc.IsArabic ? stage.TitleAr : stage.TitleEn)</div>
                <div class="duo-node-prog">@completedCount / @stage.Words.Count</div>
            </div>
        </div>
    }
</div>

<!-- Courses & Flashcards Store Integration -->
<div class="store-cta-card" @onclick="Vm.OpenStoreCoursesAsync">
    <div style="display:flex;align-items:center;gap:12px;flex:1;">
        <div class="store-cta-icon icon-svg">
            @((MarkupString)UiIcons.ShoppingBag)
        </div>
        <div>
            <div style="font-size:14px;font-weight:900;color:#fff;">@Loc.T("StoreTitle")</div>
            <div style="font-size:11px;color:#FDE68A;">@Loc.T("StoreSub")</div>
        </div>
    </div>
    <div class="store-cta-btn">@Loc.T("StoreBtn")</div>
</div>
