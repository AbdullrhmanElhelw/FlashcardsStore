@inject ILocalizationService Loc

<div class="splash-screen">
    <div class="splash-logo-ring">
        <img src="images/logo_gold.png" alt="Kholoud Elnady Academy" />
    </div>
    <h1 class="splash-title">@Loc.T("AppTitle")</h1>
    <div class="splash-academy">@Loc.T("AcademyName")</div>
    <p class="splash-sub">@Loc.T("SplashSubtitle")</p>
    <div class="splash-loader">
        <div class="splash-loader-bar"></div>
    </div>
</div>
