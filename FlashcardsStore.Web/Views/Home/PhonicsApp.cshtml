@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@inject FlashcardsStore.Application.Interfaces.Services.IStoreSettingsService SettingsService
@{
    var isRtl = Loc.IsRtl;
    ViewData["Title"] = isRtl ? "تطبيق ألعاب Jolly Phonics — أكاديمية خلود النادي" : "Jolly Phonics Game App — Kholoud Elnady Academy";
    var waLink = SettingsService.GetWhatsAppLink(isRtl
        ? "مرحباً مس خلود، أريد الاستفسار عن كروت وتطبيق ألعاب Jolly Phonics"
        : "Hello Miss Kholoud, I want to ask about the Jolly Phonics Flashcards & App");
}

<section class="bg-gradient-to-b from-[#2B071C] via-[#3A0A26] to-[#1A0412] text-white py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
            <div class="space-y-5 text-start">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-400/15 border border-amber-400/35 text-amber-300 text-xs font-extrabold">
                    @(isRtl ? "رفيق الكروت المطبوعة الرسمي" : "Official Printed Flashcards Companion")
                </span>
                <h1 class="text-3xl sm:text-5xl font-black leading-tight">
                    @(isRtl ? "تطبيق ألعاب Jolly Phonics للأطفال" : "Jolly Phonics Kids Game App")
                </h1>
                <p class="text-base sm:text-lg text-amber-100/90 leading-relaxed">
                    @(isRtl
                        ? "رحلة تأسيس ممتعة تبدأ من أصوات S A T I P N حتى القراءة والدمج والكتابة على السطور — مصممة للعمل مع كروت الفلاش كاردز المطبوعة وكورسات أكاديمية خلود النادي."
                        : "A joyful foundation journey from S A T I P N sounds to blending, reading, and guided letter tracing — built to pair with our printed flashcards and courses.")
                </p>

                <div class="flex flex-wrap gap-3 pt-2">
                    <a asp-controller="Catalog" asp-action="Index"
                       class="px-6 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm shadow-lg transition">
                        @(isRtl ? "اطلب الكروت واحصل على كود التفعيل" : "Order Flashcards & Get Activation Code")
                    </a>
                    <a href="@waLink" target="_blank" rel="noopener noreferrer"
                       class="px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-bold text-sm transition">
                        @(isRtl ? "احجز كورس التأسيس عبر واتساب" : "Book Course via WhatsApp")
                    </a>
                </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-3xl p-6 sm:p-8 space-y-4">
                <div class="text-sm font-extrabold text-amber-300">
                    @(isRtl ? "ماذا يتعلم الطفل داخل التطبيق؟" : "What Does Your Child Learn?")
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                    <div class="bg-white/10 rounded-2xl p-4">
                        <div class="font-black text-white">1. @(isRtl ? "أصوات S A T I P N" : "Jolly Phonics S A T I P N")</div>
                        <div class="text-xs text-amber-100/80 mt-1">@(isRtl ? "42 صوتاً بالصورة والحركة والنطق الصحيح للصوت (ssss) وليس اسم الحرف." : "42 phoneme sounds with picture, physical action, and true phoneme pronunciation.")</div>
                    </div>
                    <div class="bg-white/10 rounded-2xl p-4">
                        <div class="font-black text-white">2. @(isRtl ? "الدمج وتقطيع الأصوات" : "Blending & Segmenting")</div>
                        <div class="text-xs text-amber-100/80 mt-1">@(isRtl ? "دمج حرفين ثم كلمات CVC، وتقطيع الكلمة لأصوات، وتمييز مكان الصوت." : "2-letter and CVC blending, phoneme counting, and first/middle/last sound spotting.")</div>
                    </div>
                    <div class="bg-white/10 rounded-2xl p-4">
                        <div class="font-black text-white">3. @(isRtl ? "تتبع الكلمة على السطور" : "Guided Stroke Tracing")</div>
                        <div class="text-xs text-amber-100/80 mt-1">@(isRtl ? "كتابة الكلمات والحروف بالأسهم الإرشادية على شبكة الـ 4 سطور." : "4-line handwriting grid with numbered green stroke arrows and per-letter checking.")</div>
                    </div>
                    <div class="bg-white/10 rounded-2xl p-4">
                        <div class="font-black text-white">4. @(isRtl ? "تكامل مع الكروت المطبوعة" : "Paired with Flashcards")</div>
                        <div class="text-xs text-amber-100/80 mt-1">@(isRtl ? "كل طلب كروت من المتجر يصدر معه كود تفعيل تلقائي يفتح كل المراحل على جهازين." : "Every flashcards order automatically generates an activation code for 2 devices.")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8 text-start">
    <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
            @(isRtl ? "كيف تحصل على التفعيل الكامل؟" : "How to Unlock the Full App?")
        </h2>
        <p class="text-sm text-slate-600">
            @(isRtl ? "3 خطوات بسيطة لربط كروت الفلاش كاردز بالتطبيق" : "3 simple steps to connect your flashcards with the app")
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-2">
            <div class="w-10 h-10 rounded-xl bg-[#2B071C] text-amber-300 font-black flex items-center justify-center">1</div>
            <h3 class="font-extrabold text-slate-900">@(isRtl ? "اطلب باقة الكروت أو الكورس" : "Order Flashcards or Course")</h3>
            <p class="text-xs text-slate-600 leading-relaxed">@(isRtl ? "اختر باقة Jolly Phonics المناسبة من المتجر وأكمل الطلب." : "Choose your Jolly Phonics flashcards bundle from our store and complete checkout.")</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-2">
            <div class="w-10 h-10 rounded-xl bg-[#2B071C] text-amber-300 font-black flex items-center justify-center">2</div>
            <h3 class="font-extrabold text-slate-900">@(isRtl ? "استلم كود التفعيل فوراً" : "Get Your Code Instantly")</h3>
            <p class="text-xs text-slate-600 leading-relaxed">@(isRtl ? "يظهر كود التفعيل (KHO-XXXX-XXXX) في صفحة تأكيد الطلب مباشرة." : "Your activation code (KHO-XXXX-XXXX) appears right on the order confirmation page.")</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-2">
            <div class="w-10 h-10 rounded-xl bg-[#2B071C] text-amber-300 font-black flex items-center justify-center">3</div>
            <h3 class="font-extrabold text-slate-900">@(isRtl ? "فعّل التطبيق والعب" : "Activate & Play")</h3>
            <p class="text-xs text-slate-600 leading-relaxed">@(isRtl ? "أدخل الكود داخل التطبيق لفتح جميع المراحل والقصص والألعاب وتقرير ولي الأمر." : "Enter the code inside the app to unlock all stages, drills, and the parent report.")</p>
        </div>
    </div>
</section>
