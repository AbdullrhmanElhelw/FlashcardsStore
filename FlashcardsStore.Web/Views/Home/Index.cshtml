@model IReadOnlyList<ProductCardViewModel>
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@inject FlashcardsStore.Application.Interfaces.Services.IStoreSettingsService SettingsService
@{
    ViewData["Title"] = Loc.Get("BrandSubtitle") + " - " + Loc.Get("BrandName");
    var categories = ViewBag.Categories as IReadOnlyList<CategoryDto> ?? new List<CategoryDto>();
    var featured = ViewBag.FeaturedProducts as IReadOnlyList<ProductCardViewModel> ?? Model ?? Array.Empty<ProductCardViewModel>();
    var heroProduct = featured.FirstOrDefault();
    var isRtl = Loc.IsRtl;
    var nextArrow = isRtl ? "←" : "→";
    var homeWhatsAppUrl = SettingsService.GetWhatsAppLink(isRtl ? "مرحباً مس خلود، أود الاستفسار عن بطاقات الفلاش كاردز" : "Hello Miss Kholoud, I would like to inquire about flashcards");
}

<!-- ==========================================================================
     1. Cinematic Hero Section with Interactive 3D Card Preview
     ========================================================================== -->
<section class="relative overflow-hidden bg-gradient-to-b from-[#FAF8F5] via-[#FFFDFB] to-[#F5F1E8] py-12 lg:py-20 border-b border-amber-200/60">
    <!-- Ambient Gold Glows -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-amber-200/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-10 w-96 h-96 bg-amber-100/35 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
            
            <!-- Hero Text Column -->
            <div class="lg:col-span-7 space-y-6 text-start">
                <!-- Eyebrow Badge -->
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/95 border border-amber-300/80 shadow-xs text-xs font-black text-[#8D6711]">
                    <svg class="w-4 h-4 text-[#D4AF37]" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span>@Loc.Get("HeroEyebrow")</span>
                </div>

                <!-- Main Title -->
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 leading-[1.3] tracking-tight">
                    @Loc.Get("HeroTitle1")
                    <span class="block text-[#8D6711] mt-2">
                        @Loc.Get("HeroTitle2")
                    </span>
                </h1>

                <!-- Subtitle -->
                <p class="text-sm sm:text-base lg:text-lg text-slate-600 leading-relaxed max-w-2xl font-medium">
                    @Loc.Get("HeroSubtitle")
                </p>

                <!-- Action CTAs -->
                <div class="pt-2 flex flex-wrap items-center gap-3.5">
                    <a asp-controller="Catalog" asp-action="Index" class="btn-gold-primary px-8 py-3.5 rounded-xl shadow-lg shadow-[#D4AF37]/25 flex items-center gap-2.5 font-black text-sm">
                        <svg class="w-5 h-5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        <span>@Loc.Get("HeroCtaExplore")</span>
                    </a>

                    <a href="@homeWhatsAppUrl" 
                       target="_blank"
                       rel="noopener noreferrer"
                       class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow-sm flex items-center gap-2 transition">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.761.815 2.796.815 3.18 0 5.766-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm9.969 5.766c0 5.421-4.409 9.83-9.83 9.83-1.637 0-3.174-.403-4.524-1.111l-5.646 1.479 1.509-5.508c-.808-1.408-1.269-3.04-1.269-4.69 0-5.421 4.409-9.83 9.83-9.83 5.421 0 9.83 4.409 9.83 9.83z"/>
                        </svg>
                        <span>@Loc.Get("HeroCtaWhatsApp")</span>
                    </a>

                    <a href="https://github.com/AbdullrhmanElhelw/FlashcardsStore/releases/latest/download/com.kholoudelnady.flashcards-Signed.apk"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="px-5 py-3.5 rounded-xl bg-[#18061A] hover:bg-[#290A2E] text-[#D4AF37] border border-[#D4AF37]/40 font-extrabold text-sm shadow-sm flex items-center gap-2 transition">
                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>@Loc.Get("DownloadAppShort") (APK)</span>
                    </a>
                </div>

                <!-- Trust Metrics Chips -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-slate-200/80 text-start">
                    <div class="bg-white/80 backdrop-blur-sm p-3 rounded-xl border border-slate-200/70">
                        <span class="block text-lg font-black text-slate-900">+5,000</span>
                        <span class="text-[11px] text-slate-500 font-bold">@Loc.GetLocalized("طفل وأسرة مستفيدة", "Happy Families")</span>
                    </div>
                    <div class="bg-white/80 backdrop-blur-sm p-3 rounded-xl border border-slate-200/70">
                        <span class="block text-lg font-black text-slate-900">150+</span>
                        <span class="text-[11px] text-slate-500 font-bold">@Loc.GetLocalized("مدرسة وحضانة معتمدة", "Partner Schools")</span>
                    </div>
                    <div class="bg-white/80 backdrop-blur-sm p-3 rounded-xl border border-slate-200/70">
                        <span class="block text-lg font-black text-[#8D6711]">350 @Loc.GetLocalized("جم", "gsm")</span>
                        <span class="text-[11px] text-slate-500 font-bold">@Loc.GetLocalized("كوشيه بسلوفان حراري", "Laminated Cardstock")</span>
                    </div>
                    <div class="bg-white/80 backdrop-blur-sm p-3 rounded-xl border border-slate-200/70">
                        <span class="block text-lg font-black text-emerald-600">100%</span>
                        <span class="text-[11px] text-slate-500 font-bold">@Loc.GetLocalized("مقاوم للماء والتلف", "Waterproof & Durable")</span>
                    </div>
                </div>
            </div>

            <!-- Visual Interactive Hero Card Showcase (3D Depth) -->
            <div class="lg:col-span-5 flex justify-center">
                <div class="relative w-full max-w-sm sm:max-w-md">
                    <!-- Layered Realistic Flashcard Mockup -->
                    <div class="relative">
                        <div class="absolute -top-3 -left-3 w-full h-full rounded-[28px] bg-amber-100/60 border border-amber-300/40 transform -rotate-3 transition-transform"></div>
                        
                        <div class="relative bg-white rounded-[28px] p-5 sm:p-6 border-2 border-amber-200/90 shadow-2xl shadow-slate-900/10 space-y-4 text-start">
                            @if (heroProduct != null)
                            {
                                var heroImg = (heroProduct.ImageUrl ?? "")
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                    .FirstOrDefault() ?? "/images/cards/card-phonics-1.svg";
                                var heroName = Loc.GetLocalized(heroProduct.NameAr, heroProduct.Name);
                                var heroCat = Loc.GetLocalized(heroProduct.CategoryNameAr, heroProduct.CategoryName);
                                var heroAudience = Loc.TranslateTargetAudience(heroProduct.TargetAudience);

                                <!-- Card Header -->
                                <div class="flex items-center justify-between border-b border-slate-100 pb-3 gap-2">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
                                        <span class="text-xs font-black text-slate-900 tracking-wide truncate">@heroCat</span>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-full bg-amber-50 text-[#8D6711] font-black text-[11px] border border-amber-200 shrink-0">
                                        @Loc.Get("CardsCountLabel", heroProduct.CardCount)
                                    </span>
                                </div>

                                <!-- Real Featured Product Artwork -->
                                <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@heroProduct.Slug"
                                   class="block bg-gradient-to-br from-[#FAF8F5] to-[#F3ECE0] rounded-2xl p-4 border border-amber-200/60 overflow-hidden group">
                                    <img src="@heroImg" alt="@heroName"
                                         class="w-full h-52 sm:h-56 object-contain mx-auto transition-transform duration-500 group-hover:scale-105" />
                                </a>

                                <!-- Real Product Title, Audience & Price -->
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between gap-2 text-[11px] font-bold text-slate-500">
                                        <span class="truncate">@heroAudience</span>
                                        <span class="text-[#8D6711] font-black text-base shrink-0">
                                            @heroProduct.Price.ToString("F0") <small class="text-xs">@Loc.Get("Currency")</small>
                                        </span>
                                    </div>
                                    <h3 class="text-base sm:text-lg font-black text-slate-900 leading-snug line-clamp-2">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@heroProduct.Slug" class="hover:text-[#8D6711] transition-colors">
                                            @heroName
                                        </a>
                                    </h3>
                                </div>

                                <!-- Quick Actions -->
                                <div class="pt-3 border-t border-slate-100 flex items-center gap-2.5">
                                    @if (heroProduct.InStock)
                                    {
                                        <button type="button"
                                                hx-post="/Cart/AddToCart?productId=@heroProduct.Id&quantity=1"
                                                hx-target="#cart-drawer-container"
                                                hx-swap="innerHTML"
                                                class="btn-gold-primary flex-1 py-2.5 px-4 rounded-xl font-black text-xs flex items-center justify-center gap-1.5 shadow-sm">
                                            <svg class="w-4 h-4 text-slate-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                            </svg>
                                            <span>@Loc.Get("AddToCart")</span>
                                        </button>
                                    }
                                    <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@heroProduct.Slug"
                                       class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition text-center">
                                        @Loc.Get("Details")
                                    </a>
                                </div>
                            }
                            else
                            {
                                <!-- Fallback Preview when Catalog is empty -->
                                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                                        <span class="text-xs font-black text-slate-900 tracking-wider font-mono">@Loc.Get("HeroPhonicsMastery")</span>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-full bg-amber-50 text-[#8D6711] font-black text-[11px] border border-amber-200">
                                        @Loc.Get("HeroCardPill")
                                    </span>
                                </div>

                                <div class="bg-gradient-to-br from-[#18061A] to-[#2D0A35] rounded-2xl p-5 text-center text-white relative overflow-hidden shadow-inner">
                                    <div class="absolute -top-6 -right-6 w-24 h-24 bg-[#D4AF37]/20 rounded-full blur-xl"></div>
                                    <span class="inline-block text-[11px] font-bold text-[#F6ECC9] uppercase tracking-widest bg-white/10 px-3 py-0.5 rounded-full mb-2">
                                        @Loc.Get("HeroSoundPreviewTitle")
                                    </span>
                                    <div class="text-5xl sm:text-6xl font-black text-white font-mono my-2 tracking-tight">
                                        Aa
                                    </div>
                                    <div class="text-xs sm:text-sm font-black text-[#D4AF37] font-mono">
                                        /æ/ as in Apple
                                    </div>
                                </div>

                                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-bold">
                                    <span class="flex items-center gap-1 text-emerald-600 font-black">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>@Loc.Get("HeroCardLamination")</span>
                                    </span>
                                    <span class="text-[#8D6711] font-mono text-[11px]">
                                        @Loc.Get("BrandName")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- ==========================================================================
     5. Featured Packs Preview (معاينة باقات مختارة مع زر الذهاب لصفحة المتجر)
     ========================================================================== -->
<section class="py-16 bg-[#FAF8F5] border-b border-amber-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 text-start">
            <div>
                <span class="text-xs font-black text-[#8D6711] uppercase tracking-wider">FEATURED PACKS SELECTION</span>
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">
                    @Loc.Get("FeaturedSectionTitle")
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">
                    @Loc.Get("FeaturedSectionSubtitle")
                </p>
            </div>

            <!-- Link to full store catalog -->
            <a asp-controller="Catalog" asp-action="Index" class="btn-gold-primary px-6 py-3 rounded-xl text-xs sm:text-sm font-black shadow-md flex items-center gap-2 whitespace-nowrap self-start md:self-auto">
                <span>@Loc.Get("ViewAllStorePacks")</span>
                <svg class="w-4 h-4 @(isRtl ? "" : "rotate-180")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                </svg>
            </a>
        </div>

        <!-- Quick Category Browse Pills -->
        @if (categories.Any())
        {
            <div class="flex flex-wrap items-center gap-2">
                @foreach (var cat in categories)
                {
                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.Id"
                       class="px-4 py-2 rounded-xl bg-white border border-amber-200/80 hover:border-[#D4AF37] hover:bg-amber-50 text-xs sm:text-sm font-bold text-slate-800 shadow-2xs transition">
                        @Loc.GetLocalized(cat.NameAr, cat.Name)
                    </a>
                }
            </div>
        }

        <!-- Featured Product Cards Grid (Compact: 2 on mobile, 4 on desktop) -->
        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6">
            @foreach (var card in featured.Take(8))
            {
                <partial name="_ProductCard" model="card" />
            }
        </div>

        <!-- Callout Banner to Shopping Page -->
        <div class="bg-gradient-to-r from-[#18061A] via-[#2D0A35] to-[#18061A] rounded-2xl p-6 sm:p-8 text-white text-center sm:text-start flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl border border-amber-300/30">
            <div class="space-y-1.5 max-w-xl">
                <h3 class="text-lg sm:text-xl font-black text-[#FBF6E5]">@Loc.Get("CalloutTitle")</h3>
                <p class="text-xs sm:text-sm text-slate-300 font-medium">
                    @Loc.Get("CalloutSubtitle")
                </p>
            </div>

            <a asp-controller="Catalog" asp-action="Index" class="btn-gold-primary px-8 py-3.5 rounded-xl font-black text-sm shadow-lg whitespace-nowrap">
                <span>@Loc.Get("CalloutCta")</span>
                <span>@nextArrow</span>
            </a>
        </div>

    </div>
</section>




<!-- ==========================================================================
     2. The Methodology & Philosophy: Why Flashcards? (فكرة المتجر وبنعمل إيه)
     ========================================================================== -->
<section class="py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-12">
        
        <div class="max-w-3xl mx-auto space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-[#8D6711] font-bold text-xs border border-amber-200">
                <span>@Loc.Get("MethodologyEyebrow")</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-black text-slate-900 leading-tight">
                @Loc.Get("MethodologyTitle")
            </h2>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-medium">
                @Loc.Get("MethodologySubtitle")
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-start">
            <!-- Pillar 1 -->
            <div class="bg-[#FAF8F5] rounded-2xl p-7 border border-amber-200/70 shadow-xs hover:border-amber-400 hover:shadow-md transition group">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-[#8D6711] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-2">@Loc.Get("PillarActiveRecallTitle")</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
                    @Loc.Get("PillarActiveRecallDesc")
                </p>
            </div>

            <!-- Pillar 2 -->
            <div class="bg-[#FAF8F5] rounded-2xl p-7 border border-amber-200/70 shadow-xs hover:border-amber-400 hover:shadow-md transition group">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-[#8D6711] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-2">@Loc.Get("PillarSpacedRepetitionTitle")</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
                    @Loc.Get("PillarSpacedRepetitionDesc")
                </p>
            </div>

            <!-- Pillar 3 -->
            <div class="bg-[#FAF8F5] rounded-2xl p-7 border border-amber-200/70 shadow-xs hover:border-amber-400 hover:shadow-md transition group">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-[#8D6711] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                    </svg>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-2">@Loc.Get("PillarSensoryAudioTitle")</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
                    @Loc.Get("PillarSensoryAudioDesc")
                </p>
            </div>
        </div>

    </div>
</section>


<!-- ==========================================================================
     3. Physical Durability & Quality Specifications (مواصفات الخامات الفاخرة)
     ========================================================================== -->
<section class="py-16 bg-[#FAF8F5] border-b border-amber-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
            <span class="text-xs font-black text-[#8D6711] uppercase tracking-wider">@Loc.Get("SpecsEyebrow")</span>
            <h2 class="text-2xl sm:text-4xl font-black text-slate-900">
                @Loc.Get("SpecsTitle")
            </h2>
            <p class="text-sm sm:text-base text-slate-600 font-medium">
                @Loc.Get("SpecsSubtitle")
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs text-start space-y-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-[#8D6711] border border-amber-200 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <h4 class="text-base font-black text-slate-900">@Loc.Get("SpecPaperTitle")</h4>
                <p class="text-xs text-slate-500 leading-relaxed font-medium">
                    @Loc.Get("SpecPaperDesc")
                </p>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs text-start space-y-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
                <h4 class="text-base font-black text-slate-900">@Loc.Get("SpecWaterproofTitle")</h4>
                <p class="text-xs text-slate-500 leading-relaxed font-medium">
                    @Loc.Get("SpecWaterproofDesc")
                </p>
