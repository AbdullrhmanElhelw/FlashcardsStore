@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@inject FlashcardsStore.Application.Interfaces.Services.IStoreSettingsService SettingsService
@{
    var isRtl = Loc.IsRtl;
    ViewData["Title"] = isRtl ? "تطبيق متجر الفلاش كاردز — أكاديمية خلود النادي" : "Flashcards Store Mobile App — Kholoud Elnady Academy";
    var waLink = SettingsService.GetWhatsAppLink(isRtl
        ? "مرحباً مس خلود، أريد تحميل أو الاستفسار عن تطبيق متجر الفلاش كاردز"
        : "Hello Miss Kholoud, I want to ask about the Flashcards Store mobile app");
}

<section class="bg-gradient-to-b from-[#2B071C] via-[#3A0A26] to-[#1A0412] text-white py-14 sm:py-20 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 space-y-5 text-start">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-400/15 border border-amber-400/35 text-amber-300 text-xs font-extrabold">
                    @(isRtl ? "التطبيق الرسمي للمتجر — Kholoud Elnady Store App" : "Official Store App — Kholoud Elnady Store")
                </span>
                <h1 class="text-3xl sm:text-5xl font-black leading-tight">
                    @(isRtl ? "تطبيق متجر بطاقات الفلاش كاردز" : "Flashcards Store Mobile App")
                </h1>
                <p class="text-base sm:text-lg text-amber-100/90 leading-relaxed">
                    @(isRtl
                        ? "تصفحي كل باقات الكروت التعليمية (فونكس، جرامر، مفردات، استراتيجيات التدريس)، أضيفي للسلة، وتابعي شحن طلبك خطوة بخطوة من موبايلك — مع كود تفعيل تلقائي لتطبيق الألعاب!"
                        : "Browse all educational flashcard bundles, add to cart, save favorites, and track your shipment step-by-step from your phone — with an instant activation code for the Phonics Game app!")
                </p>

                <div class="flex flex-wrap gap-3 pt-1">
                    <a asp-controller="Catalog" asp-action="Index"
                       class="px-6 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm shadow-lg transition">
                        @(isRtl ? "تصفح المتجر الآن" : "Browse Web Store")
                    </a>
                    <a asp-controller="Home" asp-action="PhonicsApp"
                       class="px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-bold text-sm transition">
                        @(isRtl ? "تطبيق ألعاب الفونكس للأطفال ←" : "Kids Phonics Game App →")
                    </a>
                </div>

                <!-- QR Code Card -->
                <div class="mt-4 inline-flex items-center gap-4 bg-white text-slate-900 rounded-2xl p-4 shadow-xl border-2 border-amber-300/70">
                    <img src="~/images/store-app/qr-store-app.png"
                         asp-append-version="true"
                         alt="QR Code - Store App"
                         class="w-24 h-24 rounded-xl border border-slate-200 shrink-0" />
                    <div class="space-y-1 text-start">
                        <div class="text-xs font-black text-amber-700 uppercase tracking-wide">
                            @(isRtl ? "امسح الكود بموبايلك" : "Scan with your phone")
                        </div>
                        <div class="text-sm font-extrabold text-[#2B071C]">
                            @(isRtl ? "افتح صفحة تطبيق المتجر فوراً" : "Open the Store App page instantly")
                        </div>
                        <p class="text-[11px] text-slate-500 leading-snug max-w-xs">
                            @(isRtl
                                ? "وجّه كاميرا الموبايل نحو الـ QR Code لفتح التطبيق ومشاركته مع أولياء الأمور والمعلمات."
                                : "Point your phone camera at the QR code to open or share the Store App.")
                        </p>
                    </div>
                </div>
            </div>

            <!-- Featured Phone Mockup -->
            <div class="lg:col-span-5 flex justify-center">
                <div class="w-[270px] sm:w-[290px] bg-slate-950 rounded-[2.6rem] p-3 shadow-2xl border-[3px] border-amber-400/40 relative">
                    <div class="w-20 h-4 bg-slate-950 rounded-b-2xl mx-auto mb-1"></div>
                    <img src="~/images/store-app/store-home.png"
                         asp-append-version="true"
                         alt="Flashcards Store App Home Screen"
                         class="w-full rounded-[2rem] object-cover shadow-inner" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Real Store App Screenshots Showcase Gallery -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8">
    <div class="text-center space-y-2">
        <span class="text-xs font-extrabold text-amber-700 bg-amber-50 px-3 py-1 rounded-full">
            @(isRtl ? "صور حقيقية من تطبيق المتجر" : "Real Screenshots from the Store App")
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
            @(isRtl ? "تجربة تسوّق سهلة وسريعة على الموبايل" : "Smooth Mobile Shopping Experience")
        </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm flex flex-col items-center text-center space-y-3">
            <div class="w-full max-w-[210px] bg-slate-900 rounded-[2rem] p-2 shadow-lg">
                <img src="~/images/store-app/store-home.png" asp-append-version="true" alt="Store Home" class="w-full rounded-[1.5rem]" />
            </div>
            <div>
                <h3 class="font-extrabold text-slate-900 text-sm">@(isRtl ? "1. الرئيسية والباقات" : "1. Home & Bundles")</h3>
                <p class="text-xs text-slate-500 mt-0.5">@(isRtl ? "تصفح كل الكروت والأقسام مع بحث فوري وعروض الشحن." : "Browse all flashcard packs with instant search and offers.")</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm flex flex-col items-center text-center space-y-3">
            <div class="w-full max-w-[210px] bg-slate-900 rounded-[2rem] p-2 shadow-lg">
                <img src="~/images/store-app/store-wishlist.png" asp-append-version="true" alt="Wishlist" class="w-full rounded-[1.5rem]" />
            </div>
            <div>
                <h3 class="font-extrabold text-slate-900 text-sm">@(isRtl ? "2. المفضلة" : "2. Wishlist")</h3>
                <p class="text-xs text-slate-500 mt-0.5">@(isRtl ? "احفظي الباقات المفضلة للرجوع إليها في أي وقت." : "Save your favorite flashcard packs for later.")</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm flex flex-col items-center text-center space-y-3">
            <div class="w-full max-w-[210px] bg-slate-900 rounded-[2rem] p-2 shadow-lg">
                <img src="~/images/store-app/store-cart.png" asp-append-version="true" alt="Cart & Checkout" class="w-full rounded-[1.5rem]" />
            </div>
            <div>
                <h3 class="font-extrabold text-slate-900 text-sm">@(isRtl ? "3. سلة المشتريات" : "3. Shopping Cart")</h3>
                <p class="text-xs text-slate-500 mt-0.5">@(isRtl ? "إتمام الطلب بسهولة مع حساب مصاريف الشحن لكل المحافظات." : "Easy checkout with shipping calculation across all governorates.")</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm flex flex-col items-center text-center space-y-3">
            <div class="w-full max-w-[210px] bg-slate-900 rounded-[2rem] p-2 shadow-lg">
                <img src="~/images/store-app/store-track.png" asp-append-version="true" alt="Order Tracking" class="w-full rounded-[1.5rem]" />
            </div>
            <div>
                <h3 class="font-extrabold text-slate-900 text-sm">@(isRtl ? "4. تتبع الطلبات" : "4. Order Tracking")</h3>
                <p class="text-xs text-slate-500 mt-0.5">@(isRtl ? "متابعة فورية لحالة الطلب والشحن برقم الطلب أو الهاتف." : "Track your order and shipping status live.")</p>
            </div>
        </div>
    </div>

    <div class="text-center pt-4">
        <a href="@waLink" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow transition">
            @(isRtl ? "تواصل معنا عبر واتساب لنسخة التطبيق" : "Contact us on WhatsApp for App Link")
        </a>
    </div>
</section>
