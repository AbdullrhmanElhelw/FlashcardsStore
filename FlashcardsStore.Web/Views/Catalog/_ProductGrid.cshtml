@using FlashcardsStore.Application.Common
@model PagedResult<ProductCardViewModel>
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc

@if (Model == null || Model.Items.Count == 0)
{
    <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-slate-200 shadow-xs">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-[#B88E23] mb-4">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
        <h3 class="text-base sm:text-lg font-black text-slate-900">@Loc.Get("NoProductsFound")</h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-1.5 max-w-md mx-auto leading-relaxed font-medium">
            @Loc.Get("NoProductsFoundDesc")
        </p>
        <a asp-controller="Catalog" asp-action="Index" class="btn-gold-primary inline-flex mt-5 px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black shadow-md">
            @Loc.Get("ViewAllPacks")
        </a>
    </div>
}
else
{
    @foreach (var product in Model.Items)
    {
        <partial name="_ProductCard" model="product" />
    }
}

@* When loaded via HTMX live filtering, update pagination and count via Out-of-Band swaps *@
@if (Context.Request.Headers.ContainsKey("HX-Request"))
{
    <div id="catalog-pagination-container" hx-swap-oob="true">
        <partial name="_Pagination" model="Model" />
    </div>
    <span id="catalog-total-count" hx-swap-oob="true" class="text-xs font-bold text-[#8D6711] bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
        @Loc.Get("PacksCount", Model?.TotalCount ?? 0)
    </span>
}
