@model IReadOnlyList<ProductCardViewModel>
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@{
    ViewData["Title"] = Loc.Get("WishlistTitle") + " - " + Loc.Get("BrandName");
    var isRtl = Loc.IsRtl;
    var idsString = ViewBag.IdsString as string ?? "";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12"
     x-data="{
         localItems: JSON.parse(localStorage.getItem('fc_wishlist') || '[]'),
         init() {
             var currentUrlIds = '@idsString';
             if (!currentUrlIds && this.localItems.length > 0) {
                 window.location.replace('/Wishlist?ids=' + this.localItems.join(','));
             }
         },
         clearWishlist() {
             if (confirm('@Loc.GetLocalized("هل أنت متأكد من رغبتك في مسح كافة العناصر المحفوظة في المفضلة؟", "Are you sure you want to remove all items from your wishlist?")')) {
                 localStorage.setItem('fc_wishlist', '[]');
                 window.location.replace('/Wishlist?ids=');
             }
         }
     }">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-bold text-slate-500 mb-6">
        <a asp-controller="Home" asp-action="Index" class="hover:text-[#8D6711] transition-colors">@Loc.Get("BreadcrumbHome")</a>
        <span>/</span>
        <span class="text-slate-900 font-extrabold">@Loc.Get("NavWishlist")</span>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-amber-200/80 pb-6 mb-8 gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-xs font-bold text-[#8D6711] mb-2">
                <svg class="w-3.5 h-3.5 text-rose-500 fill-current" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                <span>@Loc.Get("NavWishlist")</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">@Loc.Get("WishlistTitle")</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">@Loc.Get("WishlistSubtitle")</p>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-[#8D6711] bg-amber-50 px-3 py-2 rounded-xl border border-amber-200">
                    @Loc.Get("WishlistTotalItems", Model.Count)
                </span>
                <button type="button" @@click="clearWishlist()" class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline px-2 py-1">
                    @Loc.Get("WishlistClearAll")
                </button>
            </div>
        }
    </div>

    <!-- Content: Grid or Empty State -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            @foreach (var card in Model)
            {
                <partial name="_ProductCard" model="card" />
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="max-w-md mx-auto py-16 px-4 text-center">
            <div class="w-20 h-20 mx-auto rounded-3xl bg-amber-50 border-2 border-amber-200 text-rose-500 flex items-center justify-center mb-6 shadow-sm">
                <svg class="w-10 h-10 fill-current opacity-80" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
            </div>

            <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-2">@Loc.Get("WishlistEmptyTitle")</h2>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-6 font-medium">
                @Loc.Get("WishlistEmptyDesc")
            </p>

            <a asp-controller="Catalog" asp-action="Index" class="btn-gold-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl font-black text-sm shadow-md">
                <svg class="w-4 h-4 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span>@Loc.Get("BrowsePacks")</span>
            </a>
        </div>
    }

</div>
