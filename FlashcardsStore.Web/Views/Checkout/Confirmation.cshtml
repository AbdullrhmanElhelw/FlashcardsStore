@model OrderDetailDto
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@{
    ViewData["Title"] = Loc.Get("OrderConfirmationTitle", Model.OrderNumber);
    var isRtl = Loc.IsRtl;
    var nextArrow = isRtl ? "←" : "→";
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-xl text-center space-y-6 relative overflow-hidden">
        <div class="absolute top-0 right-1/2 translate-x-1/2 w-96 h-32 bg-[#D4AF37]/5 blur-3xl pointer-events-none"></div>
        
        <div class="w-20 h-20 bg-emerald-500/10 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-inner border border-emerald-500/20">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
        </div>

        <div class="space-y-2">
            <span class="text-xs font-bold text-slate-400">@Loc.Get("OrderConfirmedSub")</span>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">@Loc.Get("OrderConfirmedTitle")</h1>
            <p class="text-sm text-slate-500 max-w-lg mx-auto">
                @Loc.Get("OrderNumberSaved", "") <strong class="font-mono text-[#290A2E] text-base font-black">@Model.OrderNumber</strong>
            </p>
        </div>

        <div class="inline-block">
            <partial name="_OrderStatusBadge" model="Model.Status" />
        </div>

        @if (ViewBag.PhonicsCode is string phonicsCode && !string.IsNullOrWhiteSpace(phonicsCode))
        {
            <div class="p-5 rounded-3xl bg-gradient-to-l from-[#2B071C] to-[#521036] text-white max-w-xl mx-auto shadow-lg space-y-2">
                <div class="text-xs font-bold text-amber-300">هدية طلبك — كود تفعيل تطبيق ألعاب Jolly Phonics</div>
                <div class="flex items-center justify-center gap-3">
                    <span id="orderPhonicsCode" class="font-mono text-2xl font-black tracking-wider text-white" dir="ltr">@phonicsCode</span>
                    <button type="button"
                            onclick="navigator.clipboard.writeText('@phonicsCode'); this.textContent='تم النسخ ✓';"
                            class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-extrabold cursor-pointer">
                        نسخ الكود
                    </button>
                </div>
                <p class="text-[11px] text-amber-100/90">
                    أدخل هذا الكود داخل تطبيق ألعاب الفونكس لفتح جميع المراحل والأصوات والقصص على جهازين.
                </p>
            </div>
        }

        <!-- WhatsApp Direct Action Button (especially critical for WhatsAppDirect orders) -->
        <div class="p-6 rounded-3xl bg-emerald-50/70 border border-emerald-200/80 max-w-xl mx-auto space-y-3">
            <div class="flex items-center justify-center gap-2 text-emerald-800 font-extrabold text-sm">
                <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.761.815 2.796.815 3.18 0 5.766-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm9.969 5.766c0 5.421-4.409 9.83-9.83 9.83-1.637 0-3.174-.403-4.524-1.111l-5.646 1.479 1.509-5.508c-.808-1.408-1.269-3.04-1.269-4.69 0-5.421 4.409-9.83 9.83-9.83 5.421 0 9.83 4.409 9.83 9.83z" />
                </svg>
                <span>@Loc.Get("WhatsAppConfirmPrompt")</span>
            </div>
            <p class="text-xs text-emerald-700 leading-relaxed">
                @Loc.Get("WhatsAppConfirmDesc")
            </p>
            <a href="@Model.WhatsAppDirectLink" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow-md transition-all">
                <span>@Loc.Get("WhatsAppSendNow")</span>
                <span class="font-mono text-base">@nextArrow</span>
            </a>
        </div>

        <!-- Order Summary Card -->
        <div class="text-start border-t border-slate-100 pt-8 max-w-2xl mx-auto space-y-6">
            <h3 class="text-base font-extrabold text-slate-900 border-b border-slate-100 pb-2">@Loc.Get("OrderDetailsHeader")</h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                    <span class="text-slate-400 block mb-0.5">@Loc.Get("CustomerNameLabel")</span>
                    <span class="font-bold text-slate-900 text-sm">@Model.CustomerName</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">@Loc.Get("CustomerPhoneLabel")</span>
                    <span class="font-bold text-slate-900 text-sm font-mono" dir="ltr">@Model.CustomerPhone</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">@Loc.Get("DeliveryAddressLabel")</span>
                    <span class="font-bold text-slate-900 text-sm">@Model.Governorate - @Model.City - @Model.ShippingAddress</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">@Loc.Get("PaymentMethodLabel")</span>
                    <span class="font-bold text-slate-900 text-sm">
                        @(Model.PaymentMethod == PaymentMethod.WalletTransfer ? Loc.Get("WalletMethodTitle") : Loc.Get("WhatsAppMethodTitle"))
                    </span>
                </div>
            </div>

            <!-- Items Table -->
            <div class="border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                <table class="w-full text-start text-xs">
                    <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
                        <tr>
                            <th class="p-3 text-start">@Loc.Get("TableCardHeader")</th>
                            <th class="p-3 text-center">@Loc.Get("TableQtyHeader")</th>
                            <th class="p-3 text-end">@Loc.Get("TablePriceHeader")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.Items)
                        {
                            var itemName = Loc.GetLocalized(item.ProductNameAr, item.ProductName);
                            var itemSub = isRtl ? item.ProductName : item.ProductNameAr;

                            <tr>
                                <td class="p-3 font-semibold text-slate-800 text-start">
                                    @itemName
                                    <span class="block text-[11px] text-slate-400 en-card-content">@itemSub</span>
                                </td>
                                <td class="p-3 text-center font-bold text-slate-700">@item.Quantity</td>
                                <td class="p-3 text-end font-black text-slate-900">@item.SubTotal.ToString("F0") @Loc.Get("Currency")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-slate-50 font-bold border-t border-slate-200">
                        <tr>
                            <td colspan="2" class="p-3 text-slate-600 text-start">@Loc.Get("ShippingFeeLabel")</td>
                            <td class="p-3 text-end text-slate-900">@Model.ShippingFee.ToString("F2") @Loc.Get("Currency")</td>
                        </tr>
                        <tr>
                            <td colspan="2" class="p-3 text-base text-slate-900 font-black text-start">@Loc.Get("GrandTotalLabel")</td>
                            <td class="p-3 text-end text-base text-[#290A2E] font-black">@Model.GrandTotal.ToString("F2") @Loc.Get("Currency")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Footer Actions -->
            <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
                <a asp-controller="Order" asp-action="Track" asp-route-orderNumber="@Model.OrderNumber" asp-route-phone="@Model.CustomerPhone" 
                   class="px-6 py-2.5 rounded-xl bg-slate-100 text-slate-800 hover:bg-slate-200 font-bold text-sm transition-all">
                    @Loc.Get("TrackThisOrder")
                </a>

                <a asp-controller="Catalog" asp-action="Index" 
                   class="btn-gold-primary px-6 py-2.5 rounded-xl font-bold text-sm text-slate-950 transition-all">
                    @Loc.Get("ReturnToCatalog")
                </a>
            </div>

        </div>

    </div>

</div>
