@model CartViewModel
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@{
    var isRtl = Loc.IsRtl;
    var arrowPath = isRtl ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7";
}

<div class="bg-white rounded-2xl p-6 border border-[#D4AF37]/25 shadow-sm space-y-4">
    <h3 class="text-base font-extrabold text-[#18061A] border-b border-[#FAF5EE] pb-3">@Loc.Get("CartSummaryTitle")</h3>

    <div class="space-y-2.5 text-sm">
        <div class="flex items-center justify-between text-[#6B5D6E]">
            <span>@Loc.Get("CartPacksCountLabel")</span>
            <span class="font-bold text-[#18061A]">@Loc.Get("PacksCount", Model.TotalItems)</span>
        </div>
        <div class="flex items-center justify-between text-[#6B5D6E]">
            <span>@Loc.Get("CartProductsValue")</span>
            <span class="font-bold text-[#18061A]">@Model.SubTotal.ToString("F2") @Loc.Get("Currency")</span>
        </div>
        <div class="flex items-center justify-between text-[#6B5D6E]">
            <span>@Loc.Get("CartEstimatedShipping")</span>
            <span class="font-bold text-[#18061A]">@Model.ShippingFee.ToString("F2") @Loc.Get("Currency")</span>
        </div>
    </div>

    <div class="pt-4 border-t border-[#F3EFEA] flex items-center justify-between">
        <span class="text-base font-extrabold text-[#18061A]">@Loc.Get("TotalAmount")</span>
        <span class="text-2xl font-black text-[#18061A]">@Model.GrandTotal.ToString("F2") <small class="text-sm font-bold text-[#D4AF37]">@Loc.Get("Currency")</small></span>
    </div>

    @if (!Model.IsEmpty)
    {
        <a asp-controller="Checkout" asp-action="Index" 
           class="btn-gold-primary w-full py-3.5 px-4 text-center flex items-center justify-center gap-2 shadow-md">
            <span>@Loc.Get("CartCheckoutNow")</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@arrowPath" />
            </svg>
        </a>
    }
    else
    {
        <button type="button" disabled class="w-full py-3 px-4 rounded-xl bg-[#FAF8F5] border border-[#E6DFD5] text-[#8C7B8E] font-bold text-center cursor-not-allowed">
            @Loc.Get("CartEmpty")
        </button>
    }
</div>
