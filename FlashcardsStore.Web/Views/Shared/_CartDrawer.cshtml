@inject FlashcardsStore.Web.Common.CartSessionManager CartManager
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc

@{
    var cart = (Model as CartViewModel) ?? CartManager.GetCartViewModel();
    var isRtl = Loc.IsRtl;
    var enterStart = isRtl ? "-translate-x-full" : "translate-x-full";
    var leaveEnd = isRtl ? "-translate-x-full" : "translate-x-full";
}

<!-- Alpine.js Slide-Out Cart Drawer -->
<div x-show="$store.cart.isOpen" 
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0"
     class="cart-drawer-overlay"
     style="display: none;"
     @@click.self="$store.cart.close()">

    <div class="cart-drawer-panel"
         x-show="$store.cart.isOpen"
         x-cloak
         style="display: none;"
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="@enterStart"
         x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="translate-x-0"
         x-transition:leave-end="@leaveEnd">

        <!-- Drawer Header -->
        <div class="p-5 border-b border-amber-200/80 flex items-center justify-between bg-white">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-amber-50 text-[#8D6711] border border-amber-200 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 leading-tight">@Loc.Get("CartTitle")</h3>
                    <span class="text-xs font-bold text-slate-500">
                        @Loc.Get("SelectedPacks", cart.TotalItems)
                    </span>
                </div>
            </div>
            <button type="button" 
                    @@click="$store.cart.close()" 
                    class="w-9 h-9 flex items-center justify-center rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 border border-slate-200/60 transition"
                    title="@Loc.GetLocalized("إغلاق", "Close")">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Drawer Scrollable Items Container -->
        <div class="flex-grow overflow-y-auto p-4 space-y-3">
            @if (cart.IsEmpty)
            {
                <div class="text-center py-20 text-slate-400 space-y-4">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-[#8D6711]">
                        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                        </svg>
                    </div>
                    <p class="font-extrabold text-slate-800 text-base">@Loc.Get("CartEmpty")</p>
                    <p class="text-xs text-slate-500 max-w-xs mx-auto">@Loc.Get("CartEmptyDesc")</p>
                </div>
            }
            else
            {
                @foreach (var item in cart.Items)
                {
                    var itemName = Loc.GetLocalized(item.ProductNameAr, item.ProductName);

                    <div class="cart-item-row bg-white rounded-2xl border border-amber-200/70 p-3.5 shadow-xs hover:border-amber-400 transition-all flex items-center gap-3">
                        <img src="@item.PrimaryImageUrl" alt="@itemName" class="w-16 h-16 rounded-xl object-contain p-1 border border-slate-200/80 bg-slate-50 flex-shrink-0" />
                        
                        <div class="flex-grow min-w-0">
                            <h4 class="text-xs sm:text-sm font-black text-slate-900 leading-snug">@itemName</h4>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="text-xs font-black text-[#8D6711]">@item.UnitPrice.ToString("F0") @Loc.Get("Currency")</span>
                                <span class="text-[10px] text-slate-400">@Loc.Get("PricePerPack")</span>
                            </div>
                        </div>

                        <!-- Quantity Actions -->
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <button type="button" 
                                    hx-post="/Cart/UpdateQuantity?productId=@item.ProductId&quantity=@(item.Quantity - 1)"
                                    hx-target="#cart-drawer-container"
                                    hx-swap="innerHTML"
                                    title="@Loc.GetLocalized("تقليل", "Decrease")"
                                    class="cart-quantity-btn">
                                -
                            </button>
                            <span class="w-6 text-center text-xs sm:text-sm font-black text-slate-900">@item.Quantity</span>
                            <button type="button" 
                                    hx-post="/Cart/UpdateQuantity?productId=@item.ProductId&quantity=@(item.Quantity + 1)"
                                    hx-target="#cart-drawer-container"
                                    hx-swap="innerHTML"
                                    title="@Loc.GetLocalized("زيادة", "Increase")"
                                    class="cart-quantity-btn">
                                +
                            </button>
                            <button type="button" 
                                    hx-post="/Cart/RemoveItem?productId=@item.ProductId"
                                    hx-target="#cart-drawer-container"
                                    hx-swap="innerHTML"
                                    title="@Loc.GetLocalized("حذف", "Remove")" 
                                    class="cart-delete-btn mx-1 text-slate-400 hover:text-rose-600">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Drawer Footer -->
        <div class="p-5 border-t border-amber-200/80 bg-white space-y-3.5 shadow-lg">
            <div class="flex items-center justify-between text-slate-600 text-sm">
                <span class="font-bold">@Loc.Get("SubTotal")</span>
                <span class="font-black text-slate-900 text-xl">@cart.SubTotal.ToString("F2") <small class="text-xs font-bold text-[#8D6711]">@Loc.Get("Currency")</small></span>
            </div>
            <p class="text-[11px] text-slate-500 font-medium">@Loc.Get("ShippingNote")</p>

            <div class="space-y-2 pt-1">
                @if (!cart.IsEmpty)
                {
                    <a asp-controller="Checkout" asp-action="Index" 
                       @@click="$store.cart.close()"
                       class="btn-gold-primary w-full py-3.5 px-4 text-center text-sm font-black shadow-lg shadow-amber-300/40 rounded-xl flex items-center justify-center gap-2">
                        <span>@Loc.Get("CheckoutButton")</span>
                        <svg class="w-4 h-4 @(isRtl ? "" : "rotate-180")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                        </svg>
                    </a>
                }
                else
                {
                    <button type="button" disabled class="w-full py-3.5 px-4 rounded-xl bg-slate-100 text-slate-400 font-bold text-sm cursor-not-allowed text-center">
                        @Loc.Get("CheckoutButton")
                    </button>
                }

                <a asp-controller="Cart" asp-action="Index" 
                   @@click="$store.cart.close()"
                   class="block w-full py-2 px-3 text-slate-600 hover:text-slate-900 font-bold text-xs text-center transition">
                    @Loc.Get("ViewFullCart")
                </a>
            </div>
        </div>

    </div>
</div>
