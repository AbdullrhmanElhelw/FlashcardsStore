@inject FlashcardsStore.Web.Common.CartSessionManager CartManager
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@{
    var initialCartCount = CartManager.GetCartViewModel().TotalItems;
    var isRtl = Loc.IsRtl;
    var targetCulture = isRtl ? "en-US" : "ar-EG";
    var switchLabel = isRtl ? "English" : "العربية";
    var switchTitle = isRtl ? "Switch to English" : "التحويل للغة العربية";
}
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-slate-200/90 shadow-sm transition-all w-full max-w-full overflow-x-clip"
        x-init="$nextTick(() => { if ($store && $store.cart) { $store.cart.count = @initialCartCount; } })">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20 gap-3 sm:gap-4">

            <!-- Store Brand & Luxury Emblem Logo -->
            <div class="flex items-center flex-shrink-0">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 sm:gap-3 group">
                    <img src="~/images/brand/logo.png" 
                         alt="Kholoud Elnady English Academy" 
                         class="h-10 w-10 sm:h-12 sm:w-12 object-contain rounded-xl border border-amber-200/70 shadow-xs group-hover:scale-105 transition-transform duration-300 shrink-0" />
                    <div>
                        <span class="block text-sm sm:text-base lg:text-lg font-black text-slate-900 leading-tight tracking-tight group-hover:text-[#B88E23] transition-colors whitespace-nowrap">
                            @Loc.Get("BrandName")
                        </span>
                        <span class="block text-[10px] sm:text-[11px] font-bold text-[#8D6711] tracking-wide whitespace-nowrap">
                            @Loc.Get("BrandSubtitle")
                        </span>
                    </div>
                </a>
            </div>

            <!-- Desktop Navigation Links (Clean, Spacious, Executive) -->
            <nav class="hidden lg:flex items-center gap-1 xl:gap-2 font-bold text-sm text-slate-700">
                <a asp-controller="Home" asp-action="Index" 
                   class="px-3 py-2 rounded-xl hover:text-slate-950 hover:bg-slate-100/80 transition-colors whitespace-nowrap">
                    @Loc.Get("NavHome")
                </a>

                <a asp-controller="Catalog" asp-action="Index" 
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl hover:text-[#8D6711] hover:bg-amber-50/80 transition-colors whitespace-nowrap">
                    <svg class="w-4 h-4 text-[#B88E23]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span>@Loc.Get("NavCatalog")</span>
                </a>

                <!-- Interactive Categories Dropdown -->
                <div class="relative" x-data="{ catDropdownOpen: false }" @@click.away="catDropdownOpen = false">
                    <button type="button"
                            @@click="catDropdownOpen = !catDropdownOpen"
                            class="inline-flex items-center gap-1 px-3 py-2 rounded-xl hover:text-[#8D6711] hover:bg-amber-50/80 transition-colors whitespace-nowrap font-bold text-sm text-slate-700">
                        <span>@Loc.GetLocalized("الأقسام التعليمية", "Categories")</span>
                        <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" :class="{ 'rotate-180': catDropdownOpen }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <div x-show="catDropdownOpen"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                         x-transition:leave="transition ease-in duration-150"
                         x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                         x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                         class="absolute @(isRtl ? "right-0" : "left-0") mt-2 w-72 sm:w-80 rounded-2xl bg-white border border-slate-200 shadow-2xl shadow-slate-900/15 p-2 z-50 space-y-1"
                         style="background-color: #ffffff !important; display: none;">

                        <!-- Phonics -->
                        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="1"
                           @@click="catDropdownOpen = false"
                           class="flex items-center gap-3.5 p-2.5 rounded-xl hover:bg-amber-50/70 transition-colors group">
                            <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200/80 text-[#8D6711] flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-amber-100 transition-all">
                                <svg class="w-5 h-5 text-[#B88E23]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                </svg>
                            </div>
                            <div class="leading-tight">
                                <span class="block text-xs sm:text-sm font-black text-slate-900 group-hover:text-[#8D6711] transition-colors">@Loc.Get("NavPhonics")</span>
                                <span class="block text-[11px] font-medium text-slate-500 mt-0.5">@Loc.GetLocalized("صوتيات ومخارج الحروف", "Sounds & Pronunciation")</span>
                            </div>
                        </a>

                        <!-- Grammar -->
                        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="2"
                           @@click="catDropdownOpen = false"
                           class="flex items-center gap-3.5 p-2.5 rounded-xl hover:bg-sky-50/70 transition-colors group">
                            <div class="w-9 h-9 rounded-xl bg-sky-50 border border-sky-200/80 text-sky-700 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-sky-100 transition-all">
                                <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </div>
                            <div class="leading-tight">
                                <span class="block text-xs sm:text-sm font-black text-slate-900 group-hover:text-sky-700 transition-colors">@Loc.Get("NavGrammar")</span>
                                <span class="block text-[11px] font-medium text-slate-500 mt-0.5">@Loc.GetLocalized("قواعد وتكوين الجمل", "Grammar & Sentences")</span>
                            </div>
                        </a>

                        <!-- Vocabulary -->
                        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="3"
                           @@click="catDropdownOpen = false"
                           class="flex items-center gap-3.5 p-2.5 rounded-xl hover:bg-emerald-50/70 transition-colors group">
                            <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-emerald-100 transition-all">
                                <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <div class="leading-tight">
                                <span class="block text-xs sm:text-sm font-black text-slate-900 group-hover:text-emerald-700 transition-colors">@Loc.Get("NavVocabulary")</span>
                                <span class="block text-[11px] font-medium text-slate-500 mt-0.5">@Loc.GetLocalized("مفردات مصورة وحصيلة لغوية", "Illustrated Word Lists")</span>
                            </div>
                        </a>

                        <!-- Sight Words -->
                        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="4"
                           @@click="catDropdownOpen = false"
                           class="flex items-center gap-3.5 p-2.5 rounded-xl hover:bg-purple-50/70 transition-colors group">
                            <div class="w-9 h-9 rounded-xl bg-purple-50 border border-purple-200/80 text-purple-700 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-purple-100 transition-all">
                                <svg class="w-5 h-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </div>
                            <div class="leading-tight">
                                <span class="block text-xs sm:text-sm font-black text-slate-900 group-hover:text-purple-700 transition-colors">@Loc.Get("NavSightWords")</span>
                                <span class="block text-[11px] font-medium text-slate-500 mt-0.5">@Loc.GetLocalized("طلاقة وسرعة القراءة", "Reading Fluency")</span>
                            </div>
                        </a>

                        <!-- View All Footer Link -->
                        <div class="pt-1.5 border-t border-slate-100">
                            <a asp-controller="Catalog" asp-action="Index"
                               @@click="catDropdownOpen = false"
                               class="flex items-center justify-between p-2.5 rounded-xl text-xs font-black text-[#8D6711] bg-amber-50/80 hover:bg-amber-100 transition-colors">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-[#8D6711]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                                    </svg>
                                    <span>@Loc.Get("ViewAllPacks")</span>
                                </div>
                                <svg class="w-4 h-4 text-[#8D6711]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="@(isRtl ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7")" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Track Order Button -->
                <a asp-controller="Order" asp-action="Track" 
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl hover:text-slate-950 hover:bg-slate-100/80 transition-colors whitespace-nowrap font-bold text-sm text-slate-700">
                    <svg class="w-4 h-4 text-[#B88E23]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>@Loc.Get("NavTrackOrder")</span>
                </a>
            </nav>

            <!-- Actions: Language Switcher + WhatsApp + Cart Button + Admin + Mobile Toggle -->
            <div class="flex items-center gap-1.5 sm:gap-2.5 flex-shrink-0">

                <!-- Language Switcher Toggle -->
                <form asp-controller="Culture" asp-action="SetCulture" method="post" class="inline-flex items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="@targetCulture" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" 
                            class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200/90 text-xs font-bold text-slate-700 bg-slate-50 hover:bg-amber-50 hover:border-amber-300 hover:text-[#8D6711] transition shadow-xs whitespace-nowrap"
                            title="@switchTitle">
                        <svg class="w-3.5 h-3.5 text-[#8D6711] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                        </svg>
                        <span class="font-extrabold">@switchLabel</span>
                    </button>
                </form>

                <!-- Direct WhatsApp Contact (Desktop) -->
                <a href="https://wa.me/201099887766?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D9%85%D8%B3%20%D8%AE%D9%84%D9%88%D8%AF%D8%8C%20%D9%84%D8%AF%D9%8A%20%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 font-bold text-xs border border-emerald-200/80 whitespace-nowrap transition-colors shadow-xs"
                   title="@Loc.GetLocalized("تواصل واتساب", "WhatsApp Support")">
                    <svg class="w-3.5 h-3.5 fill-current text-emerald-600 shrink-0" viewBox="0 0 24 24">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.761.815 2.796.815 3.18 0 5.766-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm9.969 5.766c0 5.421-4.409 9.83-9.83 9.83-1.637 0-3.174-.403-4.524-1.111l-5.646 1.479 1.509-5.508c-.808-1.408-1.269-3.04-1.269-4.69 0-5.421 4.409-9.83 9.83-9.83 5.421 0 9.83 4.409 9.83 9.83z"/>
                    </svg>
                    <span>@Loc.GetLocalized("واتساب", "WhatsApp")</span>
                </a>

                <!-- Cart Drawer Toggle -->
                <button type="button" 
                        @@click="$store.cart.open()"
                        hx-get="/Cart/Drawer"
                        hx-target="#cart-drawer-container"
                        hx-swap="innerHTML"
                        class="relative flex items-center gap-1.5 sm:gap-2 px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-gradient-to-r from-[#D4AF37] to-[#B88E23] text-slate-950 font-black hover:opacity-95 shadow-md shadow-[#D4AF37]/20 whitespace-nowrap transition-all duration-200">
                    <svg class="w-4 h-4 text-slate-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span class="text-xs font-black">@Loc.Get("NavCart")</span>
                    <span id="navbar-cart-badge"
                          class="inline-flex items-center justify-center px-1.5 py-0.5 text-[11px] font-black bg-slate-950 text-[#F6ECC9] rounded-full border border-[#D4AF37]/40"
                          x-text="$store.cart.count">
                        @initialCartCount
                    </span>
                </button>

                <!-- Mobile Menu Hamburger Button (visible below lg) -->
                <button type="button"
                        @@click="mobileMenuOpen = !mobileMenuOpen"
                        class="lg:hidden p-2 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition-colors shrink-0"
                        aria-label="@Loc.GetLocalized("القائمة", "Menu")">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path x-show="!mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        <path x-show="mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" style="display: none;" />
                    </svg>
                </button>

            </div>

        </div>
    </div>

    <!-- Mobile Slide-Down Navigation Menu -->
    <div x-show="mobileMenuOpen" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 -translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-4"
         class="lg:hidden border-t border-slate-200 bg-white shadow-xl px-4 pt-3 pb-5 space-y-1.5"
         style="background-color: #ffffff !important; display: none;">
        <a asp-controller="Home" asp-action="Index" 
           @@click="mobileMenuOpen = false"
           class="block px-3 py-2.5 rounded-xl font-bold text-sm text-slate-800 hover:bg-slate-100">
            @Loc.Get("NavHome")
        </a>
        <a asp-controller="Catalog" asp-action="Index" 
           @@click="mobileMenuOpen = false"
           class="block px-3 py-2.5 rounded-xl font-bold text-sm text-[#8D6711] bg-amber-50 border border-amber-200/80 hover:bg-amber-100">
            @Loc.Get("NavCatalog")
        </a>
        <div class="px-3 pt-2 text-[11px] font-black text-slate-400 uppercase tracking-wider">
            @Loc.GetLocalized("الأقسام التعليمية", "Categories")
        </div>
        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="1" 
           @@click="mobileMenuOpen = false"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold text-sm text-slate-700 hover:bg-amber-50 hover:text-[#B88E23]">
            <div class="w-7 h-7 rounded-lg bg-amber-50 border border-amber-200 text-[#8D6711] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-[#B88E23]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                </svg>
            </div>
            <span>@Loc.Get("NavPhonics")</span>
        </a>
        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="2" 
           @@click="mobileMenuOpen = false"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold text-sm text-slate-700 hover:bg-sky-50 hover:text-sky-700">
            <div class="w-7 h-7 rounded-lg bg-sky-50 border border-sky-200 text-sky-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <span>@Loc.Get("NavGrammar")</span>
        </a>
        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="3" 
           @@click="mobileMenuOpen = false"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700">
            <div class="w-7 h-7 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
            <span>@Loc.Get("NavVocabulary")</span>
        </a>
        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="4" 
           @@click="mobileMenuOpen = false"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold text-sm text-slate-700 hover:bg-purple-50 hover:text-purple-700">
            <div class="w-7 h-7 rounded-lg bg-purple-50 border border-purple-200 text-purple-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            </div>
            <span>@Loc.Get("NavSightWords")</span>
        </a>
        <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
            <a asp-controller="Order" asp-action="Track" 
               @@click="mobileMenuOpen = false"
               class="flex items-center gap-2 px-3 py-2.5 rounded-xl font-bold text-sm text-slate-800 bg-slate-100">
                <svg class="w-4 h-4 text-[#B88E23]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span>@Loc.Get("NavTrackOrder")</span>
            </a>
