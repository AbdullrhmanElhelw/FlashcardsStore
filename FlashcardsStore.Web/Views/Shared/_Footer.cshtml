@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@inject FlashcardsStore.Application.Interfaces.Services.IStoreSettingsService SettingsService
@{
    var footerSettings = SettingsService.GetCachedSettings();
}

<footer class="bg-[#100312] text-[#FBF6E5]/80 pt-16 pb-12 border-t border-[#D4AF37]/20 mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 text-start">

            <!-- Brand Info & Official Logo -->
            <div class="space-y-4">
                <div class="flex items-center gap-3.5">
                    <img src="~/images/brand/logo.png" 
                         alt="Kholoud Elnady English Academy" 
                         class="h-14 w-14 object-contain rounded-xl border border-[#D4AF37]/30 shadow-lg" />
                    <div>
                        <span class="block text-lg font-black text-gold-gradient tracking-wide">
                            KHOLOUD ELNADY
                        </span>
                        <span class="block text-xs font-bold text-[#D4AF37]">
                            ENGLISH ACADEMY
                        </span>
                    </div>
                </div>
                <p class="text-sm text-[#FBF6E5]/70 leading-relaxed">
                    @Loc.Get("FooterDescription")
                </p>
                <div class="flex items-center gap-2 pt-2">
                    <span class="text-xs bg-[#290A2E] text-[#D4AF37] border border-[#D4AF37]/30 px-3 py-1 rounded-full font-bold">
                        @Loc.Get("CertifiedLanguages")
                    </span>
                    <span class="text-xs bg-[#290A2E] text-[#D4AF37] border border-[#D4AF37]/30 px-3 py-1 rounded-full font-bold">
                        @Loc.Get("CurriculumAligned")
                    </span>
                </div>
            </div>

            <!-- Categories Quick Links -->
            <div>
                <h4 class="text-white font-extrabold text-base mb-5 border-s-2 border-[#D4AF37] ps-3">
                    @Loc.Get("CategoriesTitle")
                </h4>
                <ul class="space-y-2.5 text-sm">
                    <li><a asp-controller="Home" asp-action="Index" class="hover:text-[#D4AF37] font-bold text-white transition flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37]"></span> @Loc.Get("NavHome")</a></li>
                    <li><a asp-controller="Catalog" asp-action="Index" class="hover:text-[#D4AF37] font-bold text-amber-300 transition flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> @Loc.Get("NavCatalog")</a></li>
                    <li class="pt-1"><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="1" class="hover:text-[#D4AF37] transition">@Loc.Get("NavPhonics")</a></li>
                    <li><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="2" class="hover:text-[#D4AF37] transition">@Loc.Get("NavGrammar")</a></li>
                    <li><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="3" class="hover:text-[#D4AF37] transition">@Loc.Get("NavVocabulary")</a></li>
                    <li><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="4" class="hover:text-[#D4AF37] transition">@Loc.Get("NavSightWords")</a></li>
                </ul>
            </div>

            <!-- Egyptian Payments & Shipping -->
            <div>
                <h4 class="text-white font-extrabold text-base mb-5 border-s-2 border-[#D4AF37] ps-3">
                    @(Loc.IsRtl ? "الدفع والشحن في مصر" : "Payment & Shipping in Egypt")
                </h4>
                <div class="space-y-3.5 text-sm text-[#FBF6E5]/70">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[#D4AF37] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        <span>@(Loc.IsRtl ? "فودافون كاش ومحافظ المحمول المصرية" : "Vodafone Cash & Egyptian Mobile Wallets")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[#D4AF37] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <span>@(Loc.IsRtl ? "تحويل فوري عبر تطبيق إنستاباي (InstaPay)" : "Instant Transfers via InstaPay App")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[#D4AF37] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                        <span>@(Loc.IsRtl ? "شحن سريع لكافة المحافظات حتى باب المنزل" : "Fast doorstep shipping to all Egypt governorates")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[#D4AF37] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span>@(Loc.IsRtl ? "كوشيه 350 جم فاخر مع تغليف سلوفان حراري" : "Premium 350gsm cardstock with waterproof thermal lamination")</span>
                    </div>
                </div>
            </div>

            <!-- Support & Contact -->
            <div>
                <h4 class="text-white font-extrabold text-base mb-5 border-s-2 border-[#D4AF37] ps-3">
                    @Loc.Get("ContactTitle")
                </h4>
                <p class="text-sm text-[#FBF6E5]/70 mb-4 leading-relaxed">
                    @(Loc.IsRtl ? "أسعار خاصة للحضانات والمدارس والمعلمات للكميات التعليمية." : "Special educational packages and wholesale pricing for nurseries, schools and teachers.")
                </p>
                <div class="space-y-3 text-sm">
                    <p class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <span dir="ltr" class="font-mono text-white font-bold">@footerSettings.ContactPhone</span>
                    </p>
                    <p class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                        <a href="@SettingsService.GetWhatsAppLink()" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-bold">
                            @Loc.Get("WhatsAppSupport")
                        </a>
                    </p>
                    <p class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span>@(Loc.IsRtl ? footerSettings.StoreAddressAr : footerSettings.StoreAddressEn)</span>
                    </p>
                    <div class="pt-3 flex items-center gap-3">
                        <div class="bg-white p-1.5 rounded-xl shrink-0 shadow-sm">
                            <img src="~/images/app-download-qr.png" alt="Android App QR" class="w-16 h-16 rounded-lg" />
                        </div>
                        <div class="space-y-1.5">
                            <a href="https://github.com/AbdullrhmanElhelw/FlashcardsStore/releases/latest/download/com.kholoudelnady.flashcards-Signed.apk"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#D4AF37]/15 hover:bg-[#D4AF37]/25 text-[#D4AF37] border border-[#D4AF37]/40 font-bold text-xs transition">
                                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                </svg>
                                <span>@Loc.Get("DownloadAndroidApp")</span>
                            </a>
                            <p class="text-[11px] text-[#FBF6E5]/60">
                                @Loc.GetLocalized("امسح الـ QR لتحميل التطبيق", "Scan QR to download app")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="border-t border-[#D4AF37]/20 mt-14 pt-8 flex flex-col sm:flex-row items-center justify-between text-sm text-[#FBF6E5]/60 gap-4">
            <p>© @DateTime.UtcNow.Year @Loc.Get("BrandName"). @Loc.Get("AllRightsReserved")</p>
            <div class="flex items-center gap-4">
                <p class="text-[#D4AF37] text-xs">Clean N-Tier Architecture • ASP.NET Core 10</p>
                <!-- Scroll to Top Button -->
                <button type="button"
                        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
                        title="@Loc.Get("BackToTop")"
                        class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-[#290A2E] border border-[#D4AF37]/30 text-[#D4AF37] hover:bg-[#D4AF37] hover:text-[#18061A] transition-all shadow-md">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</footer>
