@model ProductCardViewModel
@inject FlashcardsStore.Application.Interfaces.Services.ILocalizationService Loc
@{
    var imageList = (Model.ImageUrl ?? "")
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var firstImage = imageList.FirstOrDefault() ?? "/images/cards/card-phonics-1.svg";
    var backImage = !string.IsNullOrWhiteSpace(Model.BackImageUrl) ? Model.BackImageUrl.Trim() : null;

    var isRtl = Loc.IsRtl;
    var primaryTitle = isRtl ? Model.NameAr : (string.IsNullOrWhiteSpace(Model.Name) ? Model.NameAr : Model.Name);
    var secondaryTitle = isRtl ? Model.Name : Model.NameAr;
    var categoryDisplay = Loc.GetLocalized(Model.CategoryNameAr, Model.CategoryName);
    var currency = Loc.Get("Currency");

    var audienceDisplay = Loc.TranslateTargetAudience(Model.TargetAudience);

    Func<string, string> translatePoint = pt => {
        if (isRtl) return pt;
        if (pt.Contains("كوشيه") || pt.Contains("350")) return "Premium 350gsm cardstock";
        if (pt.Contains("زوايا") || pt.Contains("دائرية")) return "Safe rounded corners";
        if (pt.Contains("باركود") || pt.Contains("نطق") || pt.Contains("QR")) return "Audio pronunciation QR code";
        if (pt.Contains("ماء") || pt.Contains("تنظيف")) return "Waterproof & wipeable";
        if (pt.Contains("وجهين") || pt.Contains("بطاقة")) return $"{Model.CardCount} Double-sided cards";
        if (pt.Contains("مثال") || pt.Contains("جملة") || pt.Contains("تمارين") || pt.Contains("جمل")) return "Example sentence for each word";
        if (pt.Contains("كلمة") || pt.Contains("كلمات")) return $"{Model.CardCount} Illustrated words";
        if (pt.Contains("تقسيم") || pt.Contains("أصوات") || pt.Contains("الأصوات")) return "Sound-group markers";
        if (pt.Contains("رسمة") || pt.Contains("رسوم") || pt.Contains("صور")) return "Illustration on every card";
        if (pt.Contains("مجموعتين") || pt.Contains("ألوان")) return "Color-coded flashcard groups";
        if (pt.Contains("ألعاب") || pt.Contains("أنشطة")) return "Interactive games & activities";
        return pt;
    };

    var rawKeyPoints = (!isRtl && !string.IsNullOrWhiteSpace(Model.BackKeyPointsEn))
        ? Model.BackKeyPointsEn
        : Model.BackKeyPoints;
}

<div class="flip-card-scene">
    <div class="flip-card" data-product-id="@Model.Id">
        <div class="flip-card-inner">

            <!-- Front Face: Compact Artwork, Clear Price & Direct Add-to-Cart -->
            <div class="flip-card-front">
                <!-- Compact Artwork with direct Click to Details -->
                <div class="card-artwork group relative">
                    <!-- Clickable Artwork Image Link -->
                    <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug" 
                       class="w-full h-full flex items-center justify-center cursor-pointer"
                       title="@primaryTitle">
                        <img src="@firstImage" alt="@primaryTitle" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </a>

                    <!-- Category Pill (Top Start Corner) -->
                    <span class="category-pill-compact">
                        @categoryDisplay
                    </span>

                    <!-- Wishlist Toggle Heart Button (Top End Corner, completely separate from category pill) -->
                    <button type="button"
                            onclick="event.stopPropagation()"
                            @@click.stop="$store.wishlist.toggle(@Model.Id)"
                            class="wishlist-card-btn"
                            :class="{ '!text-rose-500 !bg-rose-50 !border-rose-300': $store.wishlist && $store.wishlist.has(@Model.Id), 'text-slate-400 hover:text-rose-500': !$store.wishlist || !$store.wishlist.has(@Model.Id) }"
                            title="@Loc.Get("AddToWishlist")">
                        <svg class="w-4 h-4 transition-colors pointer-events-none" :fill="$store.wishlist && $store.wishlist.has(@Model.Id) ? 'currentColor' : 'none'" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                        </svg>
                    </button>

                    <!-- Quick Flip Button (Bottom End Corner) -->
                    <button type="button" 
                            data-action="flip-card"
                            onclick="event.stopPropagation(); this.closest('.flip-card').classList.toggle('is-flipped')" 
                            class="flip-hint-badge"
                            title="@Loc.Get("FlipCard")">
                        <svg class="w-3.5 h-3.5 text-[#D4AF37] pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </button>
                </div>

                <!-- Info Body -->
                <div class="p-2.5 sm:p-3 flex flex-col justify-between flex-grow">
                    <div class="space-y-1">
                        <!-- Grade / Audience & Count Tag -->
                        <div class="flex items-center justify-between text-[10px] sm:text-[11px] font-bold text-slate-500">
                            <span class="truncate text-slate-600">@audienceDisplay</span>
                            <span class="text-[#8D6711] bg-amber-50 px-1.5 py-0.5 rounded shrink-0">@Loc.Get("CardsCountLabel", Model.CardCount)</span>
                        </div>

                        <!-- Card Title (Clickable link to details) -->
                        <h3 class="text-xs sm:text-sm font-black text-slate-900 leading-snug line-clamp-1 hover:text-[#B88E23] transition-colors">
                            <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug">
                                @primaryTitle
                            </a>
                        </h3>
                    </div>

                    <!-- Price & Actions Bar -->
                    <div class="pt-2 border-t border-slate-100 mt-auto">
                        <div class="flex items-baseline justify-between mb-1.5">
                            <span class="text-sm sm:text-base font-black text-slate-900">
                                @Model.Price.ToString("F0") <small class="text-[10px] font-bold text-[#8D6711]">@currency</small>
                            </span>
                            @if (Model.InStock)
                            {
                                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    <span>@Loc.Get("InStock")</span>
                                </span>
                            }
                            else
                            {
                                <span class="text-[10px] font-bold text-rose-500">@Loc.Get("OutOfStock")</span>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex items-center gap-1.5">
                            @if (Model.InStock)
                            {
                                <button type="button"
                                        hx-post="/Cart/AddToCart?productId=@Model.Id&quantity=1"
                                        hx-target="#cart-drawer-container"
                                        hx-swap="innerHTML"
                                        onclick="event.stopPropagation()"
                                        class="btn-gold-primary flex-1 py-1.5 sm:py-2 px-2 rounded-lg font-black text-[11px] sm:text-xs flex items-center justify-center gap-1 shadow-xs min-h-[34px] sm:min-h-[36px]"
                                        title="@Loc.Get("AddToCart")">
                                    <svg class="w-3.5 h-3.5 text-slate-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                    </svg>
                                    <span>@Loc.Get("AddToCart")</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" disabled class="flex-1 py-1.5 px-2 rounded-lg bg-slate-100 text-slate-400 font-bold text-[11px] cursor-not-allowed border border-slate-200 min-h-[34px]">
                                    @Loc.Get("OutOfStock")
                                </button>
                            }

                            <!-- Details Icon Link -->
                            <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug" 
                               onclick="event.stopPropagation()"
                               class="p-1.5 sm:p-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors flex items-center justify-center shrink-0 min-h-[34px] sm:min-h-[36px] min-w-[34px] sm:min-w-[36px]"
                               title="@Loc.Get("Details")">
                                <svg class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Back Face: Real Back Image (on Details when 2+ images) or Interactive Preview -->
            <div class="flip-card-back">
                @if (backImage is not null)
                {
                    <div class="flex items-center justify-between border-b border-[#D4AF37]/20 pb-1.5 mb-2">
                        <span class="text-[10px] font-bold text-[#D4AF37]">@Loc.GetLocalized("معاينة ضهر الكارت", "Back Side Preview")</span>
                        <button type="button" 
                                data-action="flip-card"
                                onclick="event.stopPropagation(); this.closest('.flip-card').classList.remove('is-flipped')"
                                class="text-[10px] text-[#FBF6E5]/80 hover:text-white flex items-center gap-1 font-bold cursor-pointer">
                            <span>@Loc.Get("FrontFace")</span>
                            <svg class="w-3 h-3 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                        </button>
                    </div>

                    <div class="flex-1 min-h-0 rounded-xl overflow-hidden border border-[#D4AF37]/30 bg-white p-1 mb-2 flex items-center justify-center">
                        <img src="@backImage" alt="@primaryTitle" class="w-full h-full object-contain" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
                    {
                        <div class="flex justify-center mb-1">
                            <button type="button"
                                    onclick="event.stopPropagation(); window.playAudioNote(this, '@Model.AudioUrl')"
                                    class="audio-quick-btn px-3 py-1 rounded-lg bg-emerald-700/80 hover:bg-emerald-600 text-white border border-emerald-400 transition-all flex items-center gap-1.5 text-[10px] font-black cursor-pointer">
                                <span>@Loc.Get("TeacherVoiceButton")</span>
                                <span class="soundwave-container hidden">
                                    <span class="soundwave-bar"></span>
                                    <span class="soundwave-bar"></span>
                                    <span class="soundwave-bar"></span>
                                </span>
                            </button>
                        </div>
                    }
                    else if (Model.SampleWords != null && Model.SampleWords.Count > 0)
                    {
                        var wordsToSay = string.Join(", ", Model.SampleWords.Select(w => w.Word.Replace("'", "")));
                        <div class="flex justify-center mb-1">
                            <button type="button"
                                    onclick="event.stopPropagation(); window.playQuickCardPronunciation(this, '@wordsToSay')"
                                    class="audio-quick-btn px-3 py-1 rounded-lg bg-[#D4AF37]/25 hover:bg-[#D4AF37]/45 text-[#D4AF37] border border-[#D4AF37]/40 transition-all flex items-center gap-1.5 text-[10px] font-black cursor-pointer">
                                <svg class="w-3 h-3 text-[#D4AF37] speaker-icon pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                </svg>
                                <span class="audio-btn-label">@Loc.Get("PronounceWordsButton")</span>
                                <span class="soundwave-container hidden">
                                    <span class="soundwave-bar"></span>
                                    <span class="soundwave-bar"></span>
                                    <span class="soundwave-bar"></span>
                                </span>
                            </button>
                        </div>
                    }
                }
                else
                {
                <div class="space-y-2">
                    <div class="flex items-center justify-between border-b border-[#D4AF37]/20 pb-1.5">
                        <span class="text-[10px] font-bold text-[#D4AF37]">@Loc.Get("CardContent")</span>
                        <button type="button" 
                                data-action="flip-card"
                                onclick="event.stopPropagation(); this.closest('.flip-card').classList.remove('is-flipped')"
                                class="text-[10px] text-[#FBF6E5]/80 hover:text-white flex items-center gap-1 font-bold cursor-pointer">
                            <span>@Loc.Get("FrontFace")</span>
                            <svg class="w-3 h-3 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                        </button>
                    </div>

                    <h4 class="text-xs sm:text-sm font-black text-white leading-tight line-clamp-1">
                        <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug" class="hover:text-[#D4AF37] transition-colors">
                            @primaryTitle
                        </a>
                    </h4>

                    <!-- English Preview Box (LTR) with click to details and Quick Audio Button -->
                    <div class="bg-black/30 p-2.5 rounded-lg border border-white/10 hover:border-[#D4AF37]/40 transition-colors space-y-2">
                        <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug"
                           class="back-preview-box block text-left en-card-content text-[10px] sm:text-[11px] text-[#FBF6E5]/90 leading-snug line-clamp-3">
                            @Model.BackPreviewText
                        </a>
                        @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
                        {
                            <div class="flex justify-end">
                                <button type="button" 
                                        onclick="event.stopPropagation(); window.playAudioNote(this, '@Model.AudioUrl')"
                                        class="audio-quick-btn px-2 py-0.5 rounded bg-emerald-700/80 hover:bg-emerald-600 text-white border border-emerald-400 transition-all flex items-center gap-1 text-[9px] font-black cursor-pointer"
                                        title="@Loc.Get("ListenTeacherVoice")">
                                    <span>@Loc.Get("TeacherVoiceButton")</span>
                                    <span class="soundwave-container hidden">
                                        <span class="soundwave-bar"></span>
                                        <span class="soundwave-bar"></span>
                                        <span class="soundwave-bar"></span>
                                    </span>
                                </button>
                            </div>
                        }
                        else if (Model.SampleWords != null && Model.SampleWords.Count > 0)
                        {
                            var wordsToSay = string.Join(", ", Model.SampleWords.Select(w => w.Word.Replace("'", "")));
                            <div class="flex justify-end">
                                <button type="button" 
                                        onclick="event.stopPropagation(); window.playQuickCardPronunciation(this, '@wordsToSay')"
                                        class="audio-quick-btn px-2 py-0.5 rounded bg-[#D4AF37]/25 hover:bg-[#D4AF37]/45 text-[#D4AF37] border border-[#D4AF37]/40 transition-all flex items-center gap-1 text-[9px] font-black cursor-pointer"
                                        title="@Loc.Get("ListenPronounceWords")">
                                    <svg class="w-2.5 h-2.5 text-[#D4AF37] speaker-icon pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                    </svg>
                                    <span class="audio-btn-label">@Loc.Get("PronounceWordsButton")</span>
                                    <span class="soundwave-container hidden">
                                        <span class="soundwave-bar"></span>
                                        <span class="soundwave-bar"></span>
                                        <span class="soundwave-bar"></span>
                                    </span>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Key Features Points -->
                    <div class="space-y-1 my-1">
                        @foreach (var point in (rawKeyPoints ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3))
                        {
                            var displayPoint = (!isRtl && !string.IsNullOrWhiteSpace(Model.BackKeyPointsEn)) ? point : translatePoint(point);
                            <div class="flex items-center gap-1 text-[10px] sm:text-[11px] text-[#FBF6E5]/90 truncate">
                                <svg class="w-3 h-3 text-[#D4AF37] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                                <span class="truncate">@displayPoint</span>
                            </div>
                        }
                    </div>
                </div>
                }

                <!-- Back Actions -->
                <div class="pt-2 border-t border-[#D4AF37]/20 mt-auto space-y-1.5">
                    <div class="flex items-baseline justify-between">
                        <span class="text-[10px] text-[#FBF6E5]/70">@Loc.Get("PriceLabel")</span>
                        <span class="text-sm sm:text-base font-black text-white">@Model.Price.ToString("F0") <small class="text-[10px] font-bold text-[#D4AF37]">@currency</small></span>
                    </div>

                    <div class="flex items-center gap-1.5">
                        @if (Model.InStock)
                        {
                            <button type="button"
                                    hx-post="/Cart/AddToCart?productId=@Model.Id&quantity=1"
                                    hx-target="#cart-drawer-container"
                                    hx-swap="innerHTML"
                                    onclick="event.stopPropagation()"
                                    class="btn-gold-primary flex-1 py-1.5 rounded-lg font-black text-[11px] sm:text-xs flex items-center justify-center gap-1 shadow-sm min-h-[34px]">
                                <svg class="w-3.5 h-3.5 text-slate-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                                <span>@Loc.Get("AddToCart")</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" disabled class="flex-1 py-1.5 rounded-lg bg-[#290A2E] text-[#8C7B8E] font-bold text-[11px] cursor-not-allowed border border-[#D4AF37]/20 min-h-[34px]">
                                @Loc.Get("OutOfStock")
                            </button>
                        }

                        <!-- Details Icon Link on Back Face -->
                        <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug" 
                           onclick="event.stopPropagation()"
                           class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-bold text-[11px] sm:text-xs transition-colors flex items-center justify-center min-h-[34px] border border-white/20 shrink-0"
                           title="@Loc.Get("Details")">
                            <span>@Loc.Get("Details")</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
