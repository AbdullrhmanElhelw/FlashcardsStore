@model IReadOnlyList<OrderSummaryDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة طلبات الفلاش كاردز - أكاديمية خلود النادي";
    var currentStatus = ViewBag.CurrentStatus as OrderStatus?;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-6 mb-6 gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="hover:underline">لوحة التحكم</a>
                <span>/</span>
                <span class="text-slate-900">الطلبات</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">سجل طلبات العملاء</h1>
        </div>

        <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-slate-500 bg-white px-3 py-1.5 rounded-lg border border-slate-200 shadow-2xs">
                إجمالي الطلبات: <strong class="text-slate-900">@(((dynamic?)ViewBag.PagedInfo)?.TotalCount ?? Model.Count)</strong>
            </span>
        </div>
    </div>

    <!-- Status Filters Navigation Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-4 scrollbar-none">
        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-search="@searchTerm"
           class="admin-tab-pill @(!currentStatus.HasValue ? "active" : "")">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>كافة الطلبات</span>
            <span class="tab-count">@Model.Count</span>
        </a>

        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="PendingVerification" asp-route-search="@searchTerm"
           class="admin-tab-pill @(currentStatus == OrderStatus.PendingVerification ? "active" : "")">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>قيد المراجعة والتحويل</span>
        </a>

        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="WhatsAppPending" asp-route-search="@searchTerm"
           class="admin-tab-pill @(currentStatus == OrderStatus.WhatsAppPending ? "active" : "")">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.761.815 2.796.815 3.18 0 5.766-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm9.969 5.766c0 5.421-4.409 9.83-9.83 9.83-1.637 0-3.174-.403-4.524-1.111l-5.646 1.479 1.509-5.508c-.808-1.408-1.269-3.04-1.269-4.69 0-5.421 4.409-9.83 9.83-9.83 5.421 0 9.83 4.409 9.83 9.83z" />
            </svg>
            <span>طلبات واتساب</span>
        </a>

        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="Approved" asp-route-search="@searchTerm"
           class="admin-tab-pill @(currentStatus == OrderStatus.Approved ? "active" : "")">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>المعتمدة</span>
        </a>

        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="Shipped" asp-route-search="@searchTerm"
           class="admin-tab-pill @(currentStatus == OrderStatus.Shipped ? "active" : "")">
            <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75a1.125 1.125 0 00-1.125-1.125H3.375A1.125 1.125 0 002.25 3.75v10.5" />
            </svg>
            <span>المشحونة</span>
        </a>

        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="Delivered" asp-route-search="@searchTerm"
           class="admin-tab-pill @(currentStatus == OrderStatus.Delivered ? "active" : "")">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>المستلمة</span>
        </a>

        <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="Rejected" asp-route-search="@searchTerm"
           class="admin-tab-pill @(currentStatus == OrderStatus.Rejected ? "active" : "")">
            <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span>المرفوضة</span>
        </a>
    </div>

    <!-- Smart Orders Search Bar -->
    <div class="mb-6 bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-2xs">
        <form asp-controller="AdminOrders" asp-action="Orders" method="get" class="flex flex-col sm:flex-row items-center gap-3">
            @if (currentStatus.HasValue)
            {
                <input type="hidden" name="status" value="@currentStatus" />
            }
            <div class="relative flex-grow w-full">
                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text" 
                       name="search" 
                       value="@searchTerm" 
                       placeholder="ابحث برقم الطلب (e.g. ORD-)، اسم العميل، رقم الهاتف، أو المحافظة..." 
                       class="w-full pr-10 pl-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] bg-slate-50/60" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit" class="admin-btn-primary px-5 py-2.5 text-xs font-black whitespace-nowrap w-full sm:w-auto">
                    <span>بحث</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-controller="AdminOrders" asp-action="Orders" asp-route-status="@currentStatus" 
                       class="admin-btn-secondary px-4 py-2.5 text-xs font-bold whitespace-nowrap text-slate-600 hover:text-slate-900 w-full sm:w-auto text-center">
                        <span>إلغاء البحث</span>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Orders Table Container -->
    <div class="admin-table-container">
        <!-- Mobile Cards -->
        <div class="md:hidden divide-y divide-slate-100">
            @if (!Model.Any())
            {
                <div class="py-12 text-center text-slate-400 font-bold text-sm">لا توجد طلبات تطابق معايير البحث.</div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    <div class="p-4 space-y-3 bg-white">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <a asp-controller="AdminOrders" asp-action="OrderDetails" asp-route-id="@order.Id" class="font-mono font-black text-sm text-[#8D6711] hover:underline">@order.OrderNumber</a>
                                <div class="font-black text-slate-900 text-sm mt-0.5">@order.CustomerName</div>
                                <div class="text-xs text-slate-500"><span dir="ltr" class="font-mono">@order.CustomerPhone</span> • @order.Governorate</div>
                            </div>
                            <div id="status-card-@order.Id" class="shrink-0">
                                <partial name="_OrderStatusBadge" model="order.Status" />
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs pt-1">
                            <span class="font-black text-slate-900 text-sm">@order.GrandTotal.ToString("F0") ج.م</span>
                            <span class="text-slate-400">@order.OrderDate.ToString("yyyy/MM/dd")</span>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100">
                            @if (order.Status == OrderStatus.PendingVerification || order.Status == OrderStatus.WhatsAppPending)
                            {
                                <button type="button"
                                        hx-post="/Admin/Approve?id=@order.Id"
                                        hx-target="#status-card-@order.Id"
                                        onclick="return confirmOrderAction('اعتماد', '@order.OrderNumber')"
                                        class="flex-1 py-2 px-3 rounded-xl bg-emerald-100 text-emerald-800 hover:bg-emerald-200 text-xs font-bold text-center">اعتماد</button>
                                <button type="button"
                                        hx-post="/Admin/Reject?id=@order.Id&reason=عدم_صحة_التحويل"
                                        hx-target="#status-card-@order.Id"
                                        onclick="return confirmOrderAction('رفض', '@order.OrderNumber')"
                                        class="flex-1 py-2 px-3 rounded-xl bg-rose-100 text-rose-800 hover:bg-rose-200 text-xs font-bold text-center">رفض</button>
                            }
                            <a asp-controller="AdminOrders" asp-action="OrderDetails" asp-route-id="@order.Id"
                               class="flex-1 py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold text-center">تفاصيل</a>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Desktop Table -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full admin-table">
                <thead>
                    <tr>
                        <th>رقم الطلب</th>
                        <th>اسم العميل</th>
                        <th>الهاتف والمحافظة</th>
                        <th>طريقة الدفع</th>
                        <th>المبلغ</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th>الإجراء السريع</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-slate-400">
                                لا توجد طلبات تطابق هذا التصنيف
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="font-mono font-black text-[#290A2E]">
                                    <a asp-controller="AdminOrders" asp-action="OrderDetails" asp-route-id="@order.Id" class="hover:underline">
                                        @order.OrderNumber
                                    </a>
                                </td>
                                <td class="font-bold text-slate-900">
                                    @order.CustomerName
                                    <span class="block text-[11px] text-slate-400 font-normal">@order.CustomerType</span>
                                </td>
                                <td>
                                    <span dir="ltr" class="font-mono text-xs block">@order.CustomerPhone</span>
                                    <span class="text-xs text-slate-500">@order.Governorate</span>
                                </td>
                                <td>
                                    @if (order.PaymentMethod == PaymentMethod.WalletTransfer)
                                    {
                                        <span class="text-xs font-bold text-[#290A2E] bg-[#18061A]/5 border border-[#D4AF37]/30 px-2 py-0.5 rounded-md inline-flex items-center gap-1">
                                            <span>محفظة</span>
                                            @if (order.HasPaymentProof)
                                            {
                                                <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                                </svg>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md">
                                            واتساب
                                        </span>
                                    }
                                </td>
                                <td class="font-black text-slate-900">
                                    @order.GrandTotal.ToString("F0") ج.م
                                </td>
                                <td id="status-cell-@order.Id">
                                    <partial name="_OrderStatusBadge" model="order.Status" />
                                </td>
                                <td class="text-xs text-slate-400">
                                    @order.OrderDate.ToString("yyyy/MM/dd")
                                </td>
                                <td>
                                    <div class="flex items-center gap-1.5">
                                        @if (order.Status == OrderStatus.PendingVerification || order.Status == OrderStatus.WhatsAppPending)
                                        {
                                            <!-- Fast Approve via HTMX -->
                                            <button type="button"
                                                    hx-post="/Admin/Approve?id=@order.Id"
                                                    hx-target="#status-cell-@order.Id"
                                                    onclick="return confirmOrderAction('اعتماد', '@order.OrderNumber')"
                                                    title="اعتماد الطلب وخصم المخزون"
                                                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-emerald-100 text-emerald-800 hover:bg-emerald-200 text-xs font-bold transition-colors">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                                </svg>
                                                <span>اعتماد</span>
                                            </button>

                                            <!-- Fast Reject via HTMX -->
                                            <button type="button"
                                                    hx-post="/Admin/Reject?id=@order.Id&reason=عدم_صحة_التحويل"
                                                    hx-target="#status-cell-@order.Id"
                                                    onclick="return confirmOrderAction('رفض', '@order.OrderNumber')"
                                                    title="رفض الطلب وإلغاء حجز المخزون"
                                                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-rose-100 text-rose-800 hover:bg-rose-200 text-xs font-bold transition-colors">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                                <span>رفض</span>
                                            </button>
                                        }

                                        <a asp-controller="AdminOrders" asp-action="OrderDetails" asp-route-id="@order.Id" 
                                           class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors">
                                            تفاصيل
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <partial name="_AdminPagination" />

</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
