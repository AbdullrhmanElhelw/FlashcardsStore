@model UpdateProductDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تعديل باقة الفلاش كاردز - " + Model.NameAr;
    var categories = ViewBag.Categories as IReadOnlyList<CategoryDto> ?? new List<CategoryDto>();
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="productImageEditor('@Model.ImageUrl')">

    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-6 mb-8">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="hover:underline">لوحة التحكم</a>
                <span>/</span>
                <a asp-controller="AdminProducts" asp-action="Products" class="hover:underline">كروت الفلاش كاردز</a>
                <span>/</span>
                <span class="text-slate-900">تعديل</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">تعديل: @Model.NameAr</h1>
        </div>

        <div class="flex items-center gap-2">
            <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug" target="_blank" class="admin-btn-secondary">
                <span>معاينة بالمتجر ↗</span>
            </a>
            <a asp-controller="AdminProducts" asp-action="Products" class="admin-btn-secondary">
                <span>إلغاء</span>
            </a>
        </div>
    </div>

    <!-- Form -->
    <form asp-controller="AdminProducts" asp-action="EditProduct" method="post" enctype="multipart/form-data" hx-boost="false" class="space-y-8">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Slug" type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold"></div>
        }

        <!-- Section 1: Basic Information -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-5">
            <h2 class="text-base font-black text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37]"></span>
                <span>البيانات الأساسية للباقة</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">اسم الباقة بالعربية</label>
                    <input asp-for="NameAr" class="admin-form-input" />
                    <span asp-validation-for="NameAr" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">الاسم بالإنجليزية</label>
                    <input asp-for="Name" class="admin-form-input font-mono" />
                    <span asp-validation-for="Name" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">القسم التعليمي *</label>
                    <select asp-for="CategoryId" required class="admin-form-select">
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.NameAr (@cat.Name)</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-xs text-rose-600 mt-1 block"></span>
                </div>
            </div>
            <p class="text-[11px] text-slate-400 font-medium">يمكنك إدخال اسم الباقة بالعربية أو الإنجليزية أو كليهما (أحدهما إلزامي على الأقل).</p>
        </div>

        <!-- Section 2: Pricing, Stock & Specs -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-5">
            <h2 class="text-base font-black text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37]"></span>
                <span>الأسعار والمخزون والمواصفات</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">السعر للباك (ج.م) *</label>
                    <input asp-for="Price" type="number" step="1" required class="admin-form-input font-bold" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">عدد الكروت في الباك *</label>
                    <input asp-for="CardCount" type="number" step="1" required class="admin-form-input" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">الكمية المتوفرة بالمخزن *</label>
                    <input asp-for="StockQuantity" type="number" step="1" required class="admin-form-input" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">الفئة المستهدفة / السن</label>
                    @{
                        var knownAudiences = new[] { "رياض الأطفال (KG)", "ابتدائي (الصفوف 1-3)", "ابتدائي (الصفوف 4-6)", "إعدادي", "الأطفال من سن 4 إلى 7 سنوات", "سن 6 إلى 10 سنوات", "سن 7 إلى 13 سنة", "أولياء الأمور والمعلمين" };
                    }
                    <select asp-for="TargetAudience" class="admin-form-select">
                        <option value="">-- اختر الفئة المستهدفة --</option>
                        @if (!string.IsNullOrWhiteSpace(Model.TargetAudience) && !knownAudiences.Contains(Model.TargetAudience))
                        {
                            <option value="@Model.TargetAudience">@Model.TargetAudience</option>
                        }
                        @foreach (var aud in knownAudiences)
                        {
                            <option value="@aud">@aud</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">المرحلة الدراسية</label>
                    @{
                        var knownGrades = new (string Val, string Label)[] {
                            ("kg", "رياض الأطفال (KG1 - KG2)"),
                            ("primary-1-3", "الصفوف 1 - 3 ابتدائي"),
                            ("primary-4-6", "الصفوف 4 - 6 ابتدائي"),
                            ("prep", "المرحلة الإعدادية (Prep)"),
                            ("all", "جميع المستويات")
                        };
                    }
                    <select asp-for="GradeLevel" class="admin-form-select">
                        <option value="">-- اختر المرحلة الدراسية --</option>
                        @if (!string.IsNullOrWhiteSpace(Model.GradeLevel) && knownGrades.All(g => !g.Val.Equals(Model.GradeLevel, StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@Model.GradeLevel">@Model.GradeLevel</option>
                        }
                        @foreach (var g in knownGrades)
                        {
                            <option value="@g.Val">@g.Label</option>
                        }
                    </select>
                </div>

                <div class="flex items-center gap-6 pt-6">
                    <label class="inline-flex items-center gap-2 text-sm font-bold text-slate-800 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-[#D4AF37] rounded border-slate-300 focus:ring-[#D4AF37]" />
                        <span>مفعل بالمتجر</span>
                    </label>

                    <label class="inline-flex items-center gap-2 text-sm font-bold text-slate-800 cursor-pointer">
                        <input asp-for="IsFeatured" type="checkbox" class="w-4 h-4 text-[#D4AF37] rounded border-slate-300 focus:ring-[#D4AF37]" />
                        <span>مميز بالرئيسية</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Section 3: Product Photos & Card Images Upload (Multi-Image Support) -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37]"></span>
                    <span>صور وتصميم الكارت (رفع صور حقيقية)</span>
                </h2>
                <span class="text-xs font-bold text-slate-400">يمكنك تعديل الصور الحالية وإضافة صور جديدة للباقة</span>
            </div>

            <!-- Hidden input to send back surviving existing images -->
            <input type="hidden" name="existingImages" :value="existingImagesJoined" />

            <!-- Existing Saved Images Gallery -->
            <div x-show="existingImages.length > 0" class="space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700">
                        الصور الحالية للباقة (<span x-text="existingImages.length"></span> صور):
                    </span>
                    <span class="text-[11px] text-slate-400">انقر على ✕ لحذف أي صورة غير مرغوبة</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
                    <template x-for="(img, idx) in existingImages" :key="idx">
                        <div class="admin-image-thumb group">
                            <img :src="img" alt="Card Artwork" />
                            <button type="button" class="remove-btn" @@click.stop="removeExisting(idx)" title="حذف هذه الصورة">
                                ✕
                            </button>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Drag & Drop Dropzone for Adding More Images -->
            <div class="admin-dropzone"
                 :class="{ 'dragover': isDragging }"
                 @@dragover.prevent="isDragging = true"
                 @@dragleave.prevent="isDragging = false"
                 @@drop.prevent="isDragging = false; handleFiles($event)"
                 @@click="$refs.editFileInput.click()">
                
                <div class="flex flex-col items-center justify-center space-y-2 pointer-events-none">
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 text-[#B88E23] flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="text-sm font-bold text-slate-800">
                        اضغط هنا لإضافة صور جديدة من جهازك أو اسحب الصور إلى هذا المربع
                    </div>
                    <p class="text-xs text-slate-400">
                        يدعم صيغ JPG, PNG, WEBP — يمكنك تحديد عدة صور معاً
                    </p>
                </div>

                <input type="file"
                       id="editImageFilesInput"
                       x-ref="editFileInput"
                       name="imageFiles"
                       multiple
                       accept="image/*"
                       class="hidden"
                       @@change="handleFiles($event)" />
            </div>

            <!-- Previews for Newly Selected Files -->
            <div x-show="newPreviews.length > 0" class="space-y-3 pt-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700">
                        صور جديدة محددة للإضافة (<span x-text="newPreviews.length"></span> صور):
                    </span>
                    <button type="button" @@click="clearNewFiles()" class="text-xs font-bold text-rose-600 hover:underline">
                        إلغاء الصور الجديدة
                    </button>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
                    <template x-for="(p, idx) in newPreviews" :key="idx">
                        <div class="admin-image-thumb group">
                            <img :src="p.url" :alt="p.name" />
                            <button type="button" class="remove-btn" @@click.stop="removeNewPreview(idx)" title="إلغاء">
                                ✕
                            </button>
                            <span class="absolute bottom-1 right-1 bg-black/70 text-white text-[9px] px-1.5 py-0.5 rounded font-mono" x-text="p.size"></span>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Optional manual fallback or custom URL (subtle) -->
            <div class="pt-2 border-t border-slate-100">
                <details class="text-xs">
                    <summary class="font-bold text-slate-500 cursor-pointer hover:text-slate-700">أو تعديل مسار/رابط الصور يدوياً (مفصولة بفواصل)</summary>
                    <div class="pt-2">
                        <input asp-for="ImageUrl" placeholder="/images/cards/... أو رابط مباشر" class="admin-form-input font-mono text-xs" />
                    </div>
                </details>
            </div>
        </div>

        <!-- Section 4: Descriptions & Learning Points -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-5">
            <div>
                <h2 class="text-base font-black text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37]"></span>
                    <span>الوصف ومحتوى ظهر الكارت التعليمي</span>
                </h2>
                <p class="text-xs text-slate-400 font-medium mt-1">
                    يمكنك كتابة الوصف بالعربية أو الإنجليزية أو كليهما، وسيقوم المتجر تلقائياً بعرض الوصف المطابق للغة التي يختارها العميل.
                </p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">الوصف بالعربية</label>
                    <textarea asp-for="DescriptionAr" rows="2" class="admin-form-textarea"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">الوصف بالإنجليزية (English Description)</label>
                    <textarea asp-for="Description" rows="2" class="admin-form-textarea font-mono text-xs"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">نموذج محتوى ظهر الكارت (Preview)</label>
                    <input asp-for="BackPreviewText" class="admin-form-input font-mono text-xs" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">النقاط التعليمية المميزة بالعربية (مفصولة بفواصل , )</label>
                    <input asp-for="BackKeyPoints" class="admin-form-input" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">النقاط التعليمية المميزة بالإنجليزية (English Key Points)</label>
                    <input asp-for="BackKeyPointsEn" placeholder="350gsm laminated cardstock, Safe rounded corners, Native audio QR, Double-sided cards" class="admin-form-input font-mono text-xs" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">كلمات النطق التفاعلي للباقة (Sample Words)</label>
                    <textarea asp-for="SampleWords" rows="2" placeholder="light | The light is bright, night | Good night, knight | The brave knight" class="admin-form-textarea font-mono text-xs"></textarea>
                    <p class="text-[11px] text-slate-500 mt-1">افصل بين الكلمات بفاصلة (<code>,</code>). يمكنك إضافة جملة مثال بعد علامة <code>|</code>. لو تركته فارغاً لن تظهر كلمات افتراضية.</p>
                </div>
            </div>
        </div>

        <!-- Section 5: Teacher Voice Note & Audio Pronunciation Recording -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-5" x-data="voiceNoteRecorder('@Model.AudioUrl')">
            <input type="hidden" name="existingAudio" value="@Model.AudioUrl" />

            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <span>التسجيل والنطق الصوتي للباقة (بصوت ميس خلود 🎙️)</span>
                </h2>
                <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                    Voice Note مخصص
                </span>
            </div>

            <p class="text-xs text-slate-500 leading-relaxed">
                سجّلي نطق الكلمات وشرح الباقة بصوتكِ مباشرة للطفل والأم، أو ارفعي ملفاً صوتياً مسجلاً من هاتفك (MP3, M4A, WAV, WebM). سيظهر هذا الصوت للعملاء في صفحة الكارت لتعزيز مصداقية وتأسيس الأكاديمية.
            </p>

            <!-- Current Audio Status (if any) -->
            @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
            {
                <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🔊</span>
                        <div>
                            <span class="text-xs font-bold text-emerald-900 block">الملف الصوتي الحالي للباقة:</span>
                            <span class="text-[11px] font-mono text-emerald-700">@Model.AudioUrl</span>
                        </div>
                    </div>
                    <audio src="@Model.AudioUrl" controls class="h-8 max-w-full"></audio>
                </div>
            }

            <!-- Recording & Upload Controls Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
                
                <!-- Option A: In-Browser Live Voice Recorder -->
                <div class="p-4 rounded-xl border-2 border-dashed border-emerald-200 bg-emerald-50/40 flex flex-col justify-between space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-emerald-950 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500" :class="{ 'animate-ping': isRecording }"></span>
                            <span>تسجيل جديد من المايكروفون</span>
                        </span>
                        <span x-show="isRecording" class="text-xs font-mono font-black text-rose-600 bg-rose-100 px-2 py-0.5 rounded-md" x-text="formatTime(recordingTime)"></span>
                    </div>

                    <!-- Record Controls -->
                    <div class="flex items-center gap-2">
                        <template x-if="!isRecording">
                            <button type="button" 
                                    @@click="startRecording()" 
                                    class="flex-1 py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-xs transition cursor-pointer">
                                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                                </svg>
                                <span x-text="hasRecording ? 'إعادة تسجيل صوتي جديد' : 'بدء تسجيل فويس نوت جديد'"></span>
                            </button>
                        </template>

                        <template x-if="isRecording">
                            <button type="button" 
                                    @@click="stopRecording()" 
                                    class="flex-1 py-2.5 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-xs transition animate-pulse cursor-pointer">
                                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
                                </svg>
                                <span>إيقاف وحفظ الفويس نوت ⏹️</span>
                            </button>
                        </template>

                        <button type="button" 
                                x-show="hasRecording" 
                                @@click="resetRecording()" 
                                class="p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 text-xs font-bold transition cursor-pointer"
                                title="إلغاء التسجيل الجديد">
                            ✕
                        </button>
                    </div>

                    <p class="text-[11px] text-emerald-800 font-medium">
                        تسجيل فويس نوت جديد سيحل محل الملف الحالي بعد الحفظ.
                    </p>
                </div>

                <!-- Option B: Upload Audio File from Computer / Phone -->
                <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/60 flex flex-col justify-between space-y-3">
                    <span class="text-xs font-black text-slate-800 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                        </svg>
                        <span>أو استبدال بملف صوتي جديد (MP3 / WAV / M4A)</span>
                    </span>

                    <input type="file" 
                           id="audioFileInput" 
                           name="audioFile" 
                           accept="audio/*,.mp3,.wav,.m4a,.ogg,.webm" 
                           @@change="handleManualFileUpload($event)"
                           class="admin-form-input text-xs" />

                    <p class="text-[11px] text-slate-400 font-medium">
                        اتركي هذا الحقل فارغاً إذا كنتِ ترغبين في الإبقاء على الصوت المسجل سابقاً.
                    </p>
                </div>

            </div>

            <!-- New Audio Player Preview Box -->
            <div x-show="hasRecording && audioPreviewUrl" class="p-3.5 bg-slate-900 text-white rounded-xl flex flex-col sm:flex-row items-center justify-between gap-3 shadow-md">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-[#D4AF37] text-slate-950 flex items-center justify-center font-bold text-xs shrink-0">
                        🎙️
                    </div>
                    <div>
                        <span class="text-xs font-bold text-[#D4AF37] block">معاينة الصوت الجديد:</span>
                        <span class="text-[11px] text-slate-300" x-text="statusMessage || 'الفويس نوت الجديد جاهز للحفظ مع الباقة'"></span>
                    </div>
                </div>

                <audio :src="audioPreviewUrl" controls class="h-9 w-full sm:w-64 max-w-full"></audio>
            </div>

            <!-- Error message if mic is blocked -->
            <div x-show="errorMessage" class="p-3 bg-rose-50 text-rose-700 rounded-xl text-xs font-bold border border-rose-200" x-text="errorMessage"></div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-end gap-3 pt-4">
            <a asp-controller="AdminProducts" asp-action="Products" class="admin-btn-secondary">إلغاء</a>
            <button type="submit" class="admin-btn-primary px-8">
                <span>حفظ التعديلات ✓</span>
            </button>
        </div>
    </form>

</div>
