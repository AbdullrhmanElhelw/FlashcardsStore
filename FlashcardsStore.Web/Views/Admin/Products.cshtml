@model IReadOnlyList<ProductDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة كروت الفلاش كاردز - CMS";
    var categories = ViewBag.Categories as IReadOnlyList<CategoryDto> ?? new List<CategoryDto>();
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-6 mb-6 gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="hover:underline">لوحة التحكم</a>
                <span>/</span>
                <span class="text-slate-900">كروت الفلاش كاردز</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">إدارة باقات الفلاش كاردز التعليمية</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">إضافة وتعديل وحذف البطاقات المطبوعة وتحديث الأسعار والمخزون</p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-controller="Admin" asp-action="CreateProduct" class="admin-btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>إضافة باقة جديدة</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-4 scrollbar-none">
        <a asp-controller="Admin" asp-action="Products" asp-route-search="@searchTerm"
           class="admin-tab-pill @(!selectedCategoryId.HasValue ? "active" : "")">
            <span>كافة الباقات</span>
            <span class="tab-count">@(((dynamic?)ViewBag.PagedInfo)?.TotalCount ?? Model.Count)</span>
        </a>

        @foreach (var cat in categories)
        {
            <a asp-controller="Admin" asp-action="Products" asp-route-categoryId="@cat.Id" asp-route-search="@searchTerm"
               class="admin-tab-pill @(selectedCategoryId == cat.Id ? "active" : "")">
                <span>@cat.NameAr</span>
                <span class="tab-count">@cat.ProductCount</span>
            </a>
        }
    </div>

    <!-- Product Search Bar -->
    <div class="mb-6 bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-2xs">
        <form asp-controller="Admin" asp-action="Products" method="get" class="flex flex-col sm:flex-row items-center gap-3">
            @if (selectedCategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@selectedCategoryId" />
            }
            <div class="relative flex-grow w-full">
                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text" 
                       name="search" 
                       value="@searchTerm" 
                       placeholder="ابحث باسم الباقة بالعربية أو الإنجليزية، المرحلة الدراسية..." 
                       class="w-full pr-10 pl-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] bg-slate-50/60" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit" class="admin-btn-primary px-5 py-2.5 text-xs font-black whitespace-nowrap w-full sm:w-auto">
                    <span>بحث</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-controller="Admin" asp-action="Products" asp-route-categoryId="@selectedCategoryId" 
                       class="admin-btn-secondary px-4 py-2.5 text-xs font-bold whitespace-nowrap text-slate-600 hover:text-slate-900 w-full sm:w-auto text-center">
                        <span>إلغاء البحث</span>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Products Table -->
    <div class="admin-table-container">
        <div class="overflow-x-auto">
            <table class="w-full admin-table text-right">
                <thead>
                    <tr>
                        <th>الباقة والتصميم</th>
                        <th>القسم</th>
                        <th>السعر</th>
                        <th>عدد الكروت</th>
                        <th>المخزون المتاح</th>
                        <th>الحالة بالمتجر</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400 font-bold">
                                لا توجد باقات فلاش كاردز مضافة في هذا القسم حالياً.
                            </td>
                        </tr>
                    }
                    @foreach (var product in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <!-- Card Info & Visual Preview -->
                            <td>
                                <div class="flex items-center gap-3.5">
                                    <div class="w-14 h-11 rounded-lg bg-amber-50 border border-amber-200 overflow-hidden flex-shrink-0 flex items-center justify-center p-1 shadow-2xs">
                                        <img src="@product.ImageUrl" alt="@product.Name" class="w-full h-full object-contain" />
                                    </div>
                                    <div>
                                        <div class="font-black text-slate-900 text-sm">@product.NameAr</div>
                                        <div class="text-xs font-semibold text-slate-400 font-mono">@product.Name</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Category -->
                            <td>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-[#8D6711] border border-amber-200">
                                    @product.CategoryNameAr
                                </span>
                            </td>

                            <!-- Price -->
                            <td>
                                <span class="font-black text-slate-900">@product.Price.ToString("F0")</span>
                                <span class="text-xs font-bold text-[#D4AF37]">ج.م</span>
                            </td>

                            <!-- Card Count -->
                            <td>
                                <span class="text-xs font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md">
                                    @product.CardCount كارت
                                </span>
                            </td>

                            <!-- Stock -->
                            <td>
                                <div>
                                    <span class="font-bold text-slate-900 text-sm">@product.AvailableStockQuantity</span>
                                    <span class="text-xs text-slate-400">باك متبقي</span>
                                    @if (product.ReservedStockQuantity > 0)
                                    {
                                        <div class="text-[11px] text-amber-700 font-semibold">(@product.ReservedStockQuantity محجوز)</div>
                                    }
                                </div>
                            </td>

                            <!-- Status Toggle -->
                            <td>
                                <button type="button" 
                                        hx-post="/Admin/ToggleProductStatus?id=@product.Id" 
                                        hx-swap="outerHTML" 
                                        class="cursor-pointer hover:opacity-80 transition"
                                        title="انقر لتغيير حالة العرض بالمتجر">
                                    <partial name="_ProductStatusBadge" model="product.IsActive" />
                                </button>
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@product.Slug" target="_blank"
                                       class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition" title="معاينة في المتجر">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </a>

                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@product.Id"
                                       class="p-2 text-[#B88E23] hover:text-[#8D6711] hover:bg-amber-50 rounded-lg transition" title="تعديل">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>

                                    <form asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" 
                                          onsubmit="return confirm('هل أنت متأكد من حذف باقة «@product.NameAr»؟');" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition" title="حذف">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <partial name="_Pagination" />

</div>
