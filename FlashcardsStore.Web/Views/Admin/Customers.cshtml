@model FlashcardsStore.Application.DTOs.Admin.AdminCustomersSummaryDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة العملاء وحسابات الموبايل";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-6 mb-8 gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="hover:underline">لوحة التحكم</a>
                <span>/</span>
                <span class="text-slate-900">العملاء</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">إدارة العملاء وحسابات التطبيق</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">متابعة الحسابات المسجلة من تطبيق الموبايل وعملاء الطلب المباشر من الموقع وسجل مشترياتهم</p>
        </div>

        <a asp-controller="AdminOrders" asp-action="Orders" class="admin-btn-secondary self-start sm:self-auto">
            <span>الانتقال إلى الطلبات</span>
        </a>
    </div>

    <!-- Quick Stats Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-slate-500 block">إجمالي العملاء</span>
                <span class="text-2xl font-black text-slate-900 mt-1 block">@Model.TotalCustomers</span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-purple-200 bg-purple-50/20 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-purple-800 block">حسابات تطبيق الموبايل المسجلة</span>
                <span class="text-2xl font-black text-purple-800 mt-1 block">@Model.MobileAccountCustomers</span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-amber-200 bg-amber-50/20 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-amber-700 block">عملاء الطلب المباشر (بدون حساب)</span>
                <span class="text-2xl font-black text-amber-700 mt-1 block">@Model.GuestCustomers</span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Customers" asp-route-filter="all" asp-route-search="@Model.SearchTerm"
               class="px-3.5 py-2 rounded-xl text-xs font-bold transition @(Model.FilterType == "all" ? "bg-[#290A2E] text-[#F6ECC9]" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                الكل (@Model.TotalCustomers)
            </a>
            <a asp-action="Customers" asp-route-filter="accounts" asp-route-search="@Model.SearchTerm"
               class="px-3.5 py-2 rounded-xl text-xs font-bold transition @(Model.FilterType == "accounts" ? "bg-purple-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                حسابات الموبايل (@Model.MobileAccountCustomers)
            </a>
            <a asp-action="Customers" asp-route-filter="guests" asp-route-search="@Model.SearchTerm"
               class="px-3.5 py-2 rounded-xl text-xs font-bold transition @(Model.FilterType == "guests" ? "bg-amber-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                طلب مباشر (@Model.GuestCustomers)
            </a>
        </div>

        <form asp-action="Customers" method="get" class="flex items-center gap-2 w-full md:w-auto">
            <input type="hidden" name="filter" value="@Model.FilterType" />
            <input type="text"
                   name="search"
                   value="@Model.SearchTerm"
                   placeholder="ابحث بالاسم أو الموبايل أو الإيميل أو المحافظة..."
                   class="w-full md:w-72 px-3.5 py-2 text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-[#D4AF37]" />
            <button type="submit" class="px-4 py-2 rounded-xl bg-[#D4AF37] hover:bg-[#b89427] text-[#18061A] font-black text-xs transition shrink-0">
                بحث
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="Customers" asp-route-filter="@Model.FilterType" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold transition shrink-0">
                    مسح
                </a>
            }
        </form>
    </div>

    <!-- Customers Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        @if (Model.Customers.Count == 0)
        {
            <div class="p-12 text-center">
                <p class="text-slate-500 font-bold text-sm">لا يوجد عملاء مطابقون لبحثك حالياً.</p>
            </div>
        }
        else
        {
            <!-- Mobile Cards -->
            <div class="md:hidden divide-y divide-slate-100">
                @foreach (var c in Model.Customers)
                {
                    var waPhone = (c.WhatsAppNumber ?? c.PhoneNumber).Trim().TrimStart('+');
                    if (waPhone.StartsWith("0") && waPhone.Length == 11) { waPhone = "2" + waPhone; }

                    <div class="p-4 space-y-2.5 bg-white">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <div class="font-black text-slate-900 text-sm truncate">@c.FullName</div>
                                <div class="text-xs text-slate-500 font-mono truncate">@(string.IsNullOrWhiteSpace(c.Email) ? "—" : c.Email)</div>
                            </div>
                            @if (c.HasMobileAccount)
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-purple-50 text-purple-800 border border-purple-200 shrink-0">حساب موبايل</span>
                            }
                            else
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200 shrink-0">طلب مباشر</span>
                            }
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600">
                            <span dir="ltr" class="font-mono font-bold text-slate-800">@c.PhoneNumber</span>
                            <span>@(string.IsNullOrWhiteSpace(c.Governorate) ? "—" : c.Governorate)</span>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                            <div class="text-xs">
                                <strong class="text-slate-900">@c.OrdersCount طلب</strong> •
                                <strong class="text-[#8D6711]">@c.TotalSpent.ToString("N0") ج.م</strong>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(waPhone))
                                {
                                    <a href="https://wa.me/@waPhone" target="_blank" class="px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">واتساب</a>
                                }
                                <a asp-controller="AdminOrders" asp-action="Orders" asp-route-search="@c.PhoneNumber"
                                   class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-800 text-xs font-bold border border-slate-200">الطلبات</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop Table -->
            <div class="hidden md:block overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-right">
                    <thead class="bg-slate-50">
                        <tr class="text-[11px] font-black text-slate-500 uppercase tracking-wider">
                            <th class="px-5 py-3.5">العميل</th>
                            <th class="px-5 py-3.5">نوع الحساب</th>
                            <th class="px-5 py-3.5">التواصل</th>
                            <th class="px-5 py-3.5">المحافظة / المدينة</th>
                            <th class="px-5 py-3.5">الطلبات والمشتريات</th>
                            <th class="px-5 py-3.5">تاريخ التسجيل</th>
                            <th class="px-5 py-3.5 text-center">إجراء</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @foreach (var c in Model.Customers)
                        {
                            var waPhone = (c.WhatsAppNumber ?? c.PhoneNumber).Trim().TrimStart('+');
                            if (waPhone.StartsWith("0") && waPhone.Length == 11) { waPhone = "2" + waPhone; }

                            <tr class="hover:bg-slate-50/70 transition">
                                <td class="px-5 py-4">
                                    <div class="font-black text-slate-900">@c.FullName</div>
                                    <div class="text-xs text-slate-500 font-mono mt-0.5">@(string.IsNullOrWhiteSpace(c.Email) ? "—" : c.Email)</div>
                                </td>
                                <td class="px-5 py-4">
                                    @if (c.HasMobileAccount)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-black bg-purple-50 text-purple-800 border border-purple-200">
                                            حساب موبايل مسجل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            طلب مباشر
                                        </span>
                                    }
                                </td>
                                <td class="px-5 py-4">
                                    <div class="font-mono font-bold text-slate-800">@c.PhoneNumber</div>
                                    @if (!string.IsNullOrWhiteSpace(waPhone))
                                    {
                                        <a href="https://wa.me/@waPhone" target="_blank"
                                           class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 hover:underline mt-0.5">
                                            واتساب ↗
                                        </a>
                                    }
                                </td>
                                <td class="px-5 py-4 text-xs text-slate-600">
                                    @if (string.IsNullOrWhiteSpace(c.Governorate) && string.IsNullOrWhiteSpace(c.City))
                                    {
                                        <span class="text-slate-400">لم يحدد عنواناً بعد</span>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-slate-800">@c.Governorate</span>
                                        @if (!string.IsNullOrWhiteSpace(c.City))
                                        {
                                            <span> • @c.City</span>
                                        }
                                    }
                                </td>
                                <td class="px-5 py-4">
                                    <div class="font-black text-slate-900">@c.OrdersCount طلب</div>
                                    <div class="text-xs font-bold text-[#8D6711]">@c.TotalSpent.ToString("N0") ج.م</div>
                                </td>
                                <td class="px-5 py-4 text-xs text-slate-500">
                                    @c.CreatedAt.ToString("yyyy/MM/dd")
                                </td>
                                <td class="px-5 py-4 text-center">
                                    <a asp-controller="AdminOrders" asp-action="Orders" asp-route-search="@c.PhoneNumber"
                                       class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-amber-50 hover:text-[#8D6711] text-slate-700 text-xs font-bold border border-slate-200 transition">
                                        عرض الطلبات
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <partial name="_AdminPagination" />
    </div>
</div>
