@model AdminLoginDto
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "تسجيل دخول لوحة تحكم المعلمة";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/80 shadow-2xl space-y-6 relative overflow-hidden">
        <div class="absolute top-0 right-1/2 translate-x-1/2 w-48 h-2 bg-[#D4AF37] rounded-b-full"></div>

        <div class="text-center space-y-3">
            <a asp-controller="Catalog" asp-action="Index" class="inline-block transition-transform hover:scale-105">
                <img src="~/images/brand/logo.png" alt="Kholoud Elnady English Academy" class="h-16 w-auto mx-auto object-contain drop-shadow-md" />
            </a>
            <div>
                <h1 class="text-xl font-black text-slate-900">لوحة تحكم الأكاديمية</h1>
                <p class="text-xs text-slate-500 mt-0.5">أكاديمية خلود النادي لتعليم اللغة الإنجليزية • إدارة الطلبات والتحويلات</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-bold"></div>

        <form asp-controller="AdminAuth" asp-action="LoginSubmit" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div>
                <label asp-for="Username" class="block text-xs font-bold text-slate-700 mb-1.5">اسم المستخدم</label>
                <div class="relative">
                    <input asp-for="Username" dir="ltr" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:border-[#D4AF37] text-sm font-mono text-right" placeholder="admin" required />
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                        </svg>
                    </div>
                </div>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-bold text-slate-700 mb-1.5">كلمة المرور</label>
                <div class="relative">
                    <input asp-for="Password" type="password" dir="ltr" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:border-[#D4AF37] text-sm font-mono text-right" placeholder="••••••••" required />
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                        </svg>
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full py-3.5 px-4 rounded-xl btn-gold-primary text-slate-950 font-black text-sm shadow-md flex items-center justify-center gap-2">
                <span>دخول إلى لوحة التحكم</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
            </button>
        </form>

        @if (Env.IsDevelopment())
        {
            <!-- Seeded Credentials Helper Notice (Development Only) -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs text-slate-600 space-y-1.5">
                <div class="flex items-center gap-1.5 font-extrabold text-slate-900">
                    <svg class="w-3.5 h-3.5 text-[#B88E23]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                    </svg>
                    <span>بيانات الدخول الافتراضية (Seeded Admin):</span>
                </div>
                <div class="flex items-center justify-between text-[11px] font-mono" dir="ltr">
                    <span>User: <strong>admin</strong></span>
                    <span>Password: <strong>Admin@12345</strong></span>
                </div>
            </div>
        }

    </div>
</div>
