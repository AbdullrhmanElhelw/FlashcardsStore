<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand Identity Palette (Matches FlashcardsStore Web) -->
    <Color x:Key="BrandInk">#18061A</Color>
    <Color x:Key="BrandPurple">#290A2E</Color>
    <Color x:Key="BrandPlumDeep">#190611</Color>
    <Color x:Key="BrandGold">#D4AF37</Color>
    <Color x:Key="BrandGoldDark">#B88E23</Color>
    <Color x:Key="BrandGoldLight">#F6ECC9</Color>
    <Color x:Key="BrandGoldSoft">#F3E9D1</Color>
    <Color x:Key="BrandPaper">#FAF8F5</Color>

    <!-- Surface & Borders -->
    <Color x:Key="SurfaceWhite">#FFFFFF</Color>
    <Color x:Key="CardBorder">#E8DEC4</Color>
    <Color x:Key="DividerGold">#D8CBAA</Color>
    <Color x:Key="ChipUnselectedBg">#FFFFFF</Color>
    <Color x:Key="ChipSelectedBg">#290A2E</Color>

    <!-- Semantic Colors -->
    <Color x:Key="SuccessGreen">#1F7A4C</Color>
    <Color x:Key="SuccessSoft">#E9F7EF</Color>
    <Color x:Key="WhatsAppGreen">#25D366</Color>
    <Color x:Key="WhatsAppDark">#37805B</Color>
    <Color x:Key="WhatsAppBorder">#8EAD94</Color>
    <Color x:Key="DangerRed">#B91C1C</Color>
    <Color x:Key="DangerSoft">#FEF2F2</Color>
    <Color x:Key="MutedText">#64748B</Color>
    <Color x:Key="TabUnselected">#C9B9CB</Color>

</ResourceDictionary>
