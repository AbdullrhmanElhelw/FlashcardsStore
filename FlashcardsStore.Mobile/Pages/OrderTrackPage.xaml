<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             xmlns:controls="clr-namespace:FlashcardsStore.Mobile.Controls"
             x:Class="FlashcardsStore.Mobile.Pages.OrderTrackPage"
             x:DataType="vm:OrderTrackViewModel"
             FlowDirection="{Binding Loc.FlowDirection}"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:BrandHeaderView Grid.Row="0"
                                  HeaderTitle="{Binding Loc[TrackHeader]}"
                                  HeaderSubtitle="{Binding Loc[TrackSub]}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

                <Border Style="{StaticResource CardBorderStyle}" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="أدخلي رقم الطلب ورقم الهاتف الذي سجلته عند الشراء." Style="{StaticResource MutedLabelStyle}" FontSize="13" />

                        <Label Text="رقم الطلب" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputBoxBorderStyle}">
                            <Entry Placeholder="مثال: EGY-20261120-1234" Text="{Binding OrderNumber}" Style="{StaticResource BrandEntryStyle}" />
                        </Border>

                        <Label Text="رقم الهاتف" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputBoxBorderStyle}">
                            <Entry Placeholder="رقم الهاتف المسجل بالطلب" Keyboard="Telephone" Text="{Binding PhoneNumber}" Style="{StaticResource BrandEntryStyle}" />
                        </Border>

                        <Button Text="ابحث عن الطلب"
                                Command="{Binding SearchOrderCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryPurpleButtonStyle}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" />

                <Border Style="{StaticResource CardBorderStyle}"
                        IsVisible="{Binding HasResult}"
                        BackgroundColor="#FFFDF8"
                        Stroke="{StaticResource BrandGold}"
                        Shadow="{Shadow Brush='#18061A', Opacity='0.08', Radius='10', Offset='0,4'}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding TrackingResult.OrderNumber, StringFormat='الطلب {0}'}" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource BrandPurple}" Stroke="Transparent" StrokeShape="RoundRectangle 10" Padding="10,4">
                                <Label Text="{Binding TrackingResult.GrandTotal, StringFormat='{0:0.##} ج.م'}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandGoldLight}" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />
                        <Label Text="{Binding TrackingResult.CustomerName, StringFormat='العميل: {0}'}" Style="{StaticResource BodyLabelStyle}" />
                        <Label Text="{Binding TrackingResult.StatusDescriptionAr, StringFormat='الحالة: {0}'}" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" TextColor="{StaticResource BrandPurple}" />
                        <Label Text="{Binding TrackingResult.ItemCount, StringFormat='عدد المنتجات: {0}'}" Style="{StaticResource BodyLabelStyle}" />
                        <Border BackgroundColor="{StaticResource BrandGoldSoft}" Stroke="#E8DAB8" StrokeShape="RoundRectangle 10" Padding="10,8">
                            <Label Text="{Binding ProofNote}" Style="{StaticResource BodyLabelStyle}" FontSize="12" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
