<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             xmlns:api="clr-namespace:FlashcardsStore.Mobile.Models.Api"
             xmlns:controls="clr-namespace:FlashcardsStore.Mobile.Controls"
             x:Class="FlashcardsStore.Mobile.Pages.OrderTrackPage"
             x:Name="ThisOrderTrackPage"
             x:DataType="vm:OrderTrackViewModel"
             FlowDirection="{Binding Loc.FlowDirection}"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:BrandHeaderView Grid.Row="0"
                                  HeaderTitle="{Binding Loc[TrackHeader]}"
                                  HeaderSubtitle="{Binding Loc[TrackSub]}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

                <!-- Authenticated Customer's Previous Orders -->
                <Border Style="{StaticResource CardBorderStyle}"
                        IsVisible="{Binding HasMyOrders}"
                        Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Loc[MyOrdersTitle]}" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <Label Text="{Binding Loc[TapOrderToTrack]}" Style="{StaticResource MutedLabelStyle}" FontSize="12" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyOrders}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="api:MyOrderSummary">
                                    <Border BackgroundColor="{StaticResource BrandPaper}"
                                            Stroke="{StaticResource CardBorder}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisOrderTrackPage}, Path=BindingContext.SelectMyOrderCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                                            <Label Text="{Binding OrderNumber}" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" />
                                            <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='{0:0} EGP'}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandGoldDark}" />
                                            <Label Grid.Row="1" Text="{Binding StatusDescriptionAr}" Style="{StaticResource MutedLabelStyle}" FontSize="12" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding OrderDate, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource MutedLabelStyle}" FontSize="11" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Loc[OrderTrackIntro]}" Style="{StaticResource MutedLabelStyle}" FontSize="13" />

                        <Label Text="{Binding Loc[OrderNumLabel]}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputBoxBorderStyle}">
                            <Entry Placeholder="{Binding Loc[OrderNumberExample]}" Text="{Binding OrderNumber}" Style="{StaticResource BrandEntryStyle}" />
                        </Border>

                        <Label Text="{Binding Loc[PhoneLabel]}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputBoxBorderStyle}">
                            <Entry Placeholder="{Binding Loc[OrderPhonePlaceholder]}" Keyboard="Telephone" Text="{Binding PhoneNumber}" Style="{StaticResource BrandEntryStyle}" />
                        </Border>

                        <Button Text="{Binding Loc[SearchOrderBtn]}"
                                Command="{Binding SearchOrderCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryPurpleButtonStyle}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" />

                <Border Style="{StaticResource CardBorderStyle}"
                        IsVisible="{Binding HasResult}"
                        BackgroundColor="#FFFDF8"
                        Stroke="{StaticResource BrandGold}"
                        Shadow="{Shadow Brush='#18061A', Opacity='0.08', Radius='10', Offset='0,4'}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding OrderLabel}" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource BrandPurple}" Stroke="Transparent" StrokeShape="RoundRectangle 10" Padding="10,4">
                                <Label Text="{Binding OrderTotalLabel}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandGoldLight}" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />
                        <Label Text="{Binding CustomerLabel}" Style="{StaticResource BodyLabelStyle}" />
                        <Label Text="{Binding StatusLabel}" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" TextColor="{StaticResource BrandPurple}" />
                        <Label Text="{Binding ProductCountLabel}" Style="{StaticResource BodyLabelStyle}" />
                        <Border BackgroundColor="{StaticResource BrandGoldSoft}" Stroke="#E8DAB8" StrokeShape="RoundRectangle 10" Padding="10,8">
                            <Label Text="{Binding ProofNote}" Style="{StaticResource BodyLabelStyle}" FontSize="12" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
