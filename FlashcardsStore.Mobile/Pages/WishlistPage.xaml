<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             xmlns:ui="clr-namespace:FlashcardsStore.Mobile.Models.Ui"
             x:Class="FlashcardsStore.Mobile.Pages.WishlistPage"
             x:Name="ThisWishlistPage"
             x:DataType="vm:WishlistViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="قائمة المفضلة" Style="{StaticResource HeadingLabelStyle}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" />

            <Border Style="{StaticResource CardBorderStyle}" IsVisible="{Binding IsEmpty}" Padding="24">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="♡" FontSize="36" HorizontalTextAlignment="Center" TextColor="{StaticResource BrandGold}" />
                    <Label Text="لم تضيفي أي باقة للمفضلة بعد" Style="{StaticResource BodyLabelStyle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10" IsVisible="{Binding HasItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="ui:ProductCardDisplayItem">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
                                <Image Source="{Binding FullImageUrl}" WidthRequest="90" HeightRequest="90" Aspect="AspectFit" />
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding NameAr}" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                                    <Label Text="{Binding Price, StringFormat='{0:0.##} ج.م'}" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandGoldDark}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="عرض"
                                                Command="{Binding Source={x:Reference ThisWishlistPage}, Path=BindingContext.OpenProductCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryCreamButtonStyle}"
                                                Padding="12,6" />
                                        <Button Text="للسلة"
                                                Command="{Binding Source={x:Reference ThisWishlistPage}, Path=BindingContext.AddToCartCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource PrimaryPurpleButtonStyle}"
                                                MinimumHeightRequest="36"
                                                FontSize="12"
                                                Padding="12,6" />
                                        <Button Text="إزالة"
                                                Command="{Binding Source={x:Reference ThisWishlistPage}, Path=BindingContext.RemoveFavoriteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource DangerRed}"
                                                FontFamily="Cairo"
                                                FontSize="12"
                                                Padding="6,6" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
