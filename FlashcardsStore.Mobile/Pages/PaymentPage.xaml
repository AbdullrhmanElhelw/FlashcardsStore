<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             xmlns:conv="clr-namespace:FlashcardsStore.Mobile.Converters"
             xmlns:controls="clr-namespace:FlashcardsStore.Mobile.Controls"
             x:Class="FlashcardsStore.Mobile.Pages.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             FlowDirection="{Binding Loc.FlowDirection}"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <controls:BrandHeaderView Grid.Row="0"
                                  HeaderTitle="{Binding Loc[PaymentHeader]}"
                                  HeaderSubtitle="{Binding Loc[PaymentSub]}"
                                  ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,28" Spacing="12">

                <!-- Dark Order Confirmed Banner -->
                <Border Stroke="{StaticResource BrandGold}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16"
                        Shadow="{Shadow Brush='#18061A', Opacity='0.12', Radius='10', Offset='0,4'}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#18061A" Offset="0.0" />
                            <GradientStop Color="#290A2E" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Loc[OrderPlacedSuccess]}" FontFamily="Cairo" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BrandGoldLight}" />
                        <Label Text="{Binding OrderNumberLabel}" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding TotalLabel}" FontFamily="Cairo" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandGold}" />
                        <Label Text="{Binding Loc[PaymentTransferInstructions]}" FontFamily="Cairo" FontSize="12" TextColor="#E6DDF0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Payment Details -->
                <Label Text="{Binding Loc[AvailableTransferDetails]}" Style="{StaticResource SectionTitleStyle}" />

                <Border Style="{StaticResource CardBorderStyle}" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Loc[VodafoneCashLabel]}" Style="{StaticResource MutedLabelStyle}" />
                            <Label Text="{Binding VodafoneCashNumber}" Style="{StaticResource SectionTitleStyle}" FontSize="17" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{Binding Loc[CopyBtn]}" Command="{Binding CopyVodafoneCommand}" Style="{StaticResource SecondaryCreamButtonStyle}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="InstaPay" Style="{StaticResource MutedLabelStyle}" />
                            <Label Text="{Binding InstaPayAddress}" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                            <Label Text="{Binding RecipientNameLabel}" Style="{StaticResource MutedLabelStyle}" IsVisible="{Binding InstaPayAccountName, Converter={StaticResource StringNotEmpty}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{Binding Loc[CopyBtn]}" Command="{Binding CopyInstaPayCommand}" Style="{StaticResource SecondaryCreamButtonStyle}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" IsVisible="{Binding HasPaymentInstructions}">
                    <Label Text="{Binding PaymentInstructionsAr}" Style="{StaticResource BodyLabelStyle}" FontSize="13" />
                </Border>

                <Button Text="{Binding Loc[WhatsAppPaymentOption]}"
                        Command="{Binding OpenWhatsAppCommand}"
                        IsVisible="{Binding HasWhatsAppLink}"
                        Style="{StaticResource WhatsAppOutlineButtonStyle}" />

                <!-- Upload Proof Card -->
                <Border Style="{StaticResource CardBorderStyle}" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Loc[UploadTransferReceipt]}" Style="{StaticResource SectionTitleStyle}" FontSize="16" />

                        <Label Text="{Binding Loc[WalletOrBank]}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <controls:BrandDropdown Title="{Binding Loc[SelectWallet]}"
                                                ItemsSource="{Binding WalletOptions}"
                                                SelectedItem="{Binding SelectedWallet}" />

                        <Label Text="{Binding Loc[SenderPhone]}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputBoxBorderStyle}">
                            <Entry Placeholder="{Binding Loc[SenderPhone]}" Keyboard="Telephone" Text="{Binding SenderPhone}" Style="{StaticResource BrandEntryStyle}" />
                        </Border>

                        <Label Text="{Binding Loc[TransactionReferenceOptional]}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputBoxBorderStyle}">
                            <Entry Placeholder="{Binding Loc[TransactionReference]}" Text="{Binding TransactionReference}" Style="{StaticResource BrandEntryStyle}" />
                        </Border>

                        <Border BackgroundColor="{StaticResource BrandGoldLight}" Stroke="{StaticResource BrandGold}" StrokeShape="RoundRectangle 12" HeightRequest="46">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickReceiptCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="icon_camera.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Label Text="{Binding Loc[ReceiptSelected]}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label Text="{Binding SelectedFileName}" Style="{StaticResource MutedLabelStyle}" HorizontalTextAlignment="Center" />

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />

                        <Button Text="{Binding Loc[SendReceipt]}"
                                Command="{Binding UploadReceiptCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryPurpleButtonStyle}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
