<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             xmlns:ui="clr-namespace:FlashcardsStore.Mobile.Models.Ui"
             xmlns:controls="clr-namespace:FlashcardsStore.Mobile.Controls"
             x:Class="FlashcardsStore.Mobile.Pages.CatalogPage"
             x:Name="ThisCatalogPage"
             x:DataType="vm:CatalogViewModel"
             FlowDirection="{Binding Loc.FlowDirection}"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Executive Navbar (Matches Web _Navbar.cshtml) -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border BackgroundColor="{StaticResource SurfaceWhite}"
                    StrokeThickness="0"
                    Padding="14,10"
                    Shadow="{Shadow Brush='#18061A', Opacity='0.06', Radius='8', Offset='0,3'}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                    <!-- Brand Emblem + Name -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#190611"
                                Stroke="{StaticResource BrandGold}"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0">
                            <Image Source="logo.png" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding Loc[BrandName]}"
                                   FontFamily="Cairo"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandInk}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Loc[BrandSubtitle]}"
                                   FontFamily="Cairo"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandGoldDark}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Language Switcher (AR / EN) -->
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource BrandPaper}"
                            Stroke="{StaticResource BrandGold}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,0"
                            HeightRequest="42">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleLanguageCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Loc.SwitchButtonLabel}"
                               FontFamily="Cairo"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandPurple}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    

                    <!-- Cart Action + Badge -->
                    <Grid Grid.Column="2" WidthRequest="46" HeightRequest="44">
                        <Border BackgroundColor="{StaticResource BrandGoldSoft}"
                                Stroke="#E2CE9F"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="42"
                                HeightRequest="42"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <ImageButton Source="home_cart.png"
                                         Command="{Binding OpenCartCommand}"
                                         BackgroundColor="Transparent"
                                         Padding="8" />
                        </Border>
                        <Border BackgroundColor="{StaticResource BrandPurple}"
                                Stroke="{StaticResource SurfaceWhite}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="20"
                                HeightRequest="20"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                InputTransparent="True"
                                IsVisible="{Binding HasCartItems}">
                            <Label Text="{Binding CartBadgeCount}"
                                   TextColor="White"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                </Grid>
            </Border>
            <BoxView HeightRequest="1.2" Color="#E8DAB8" />

            <!-- Sticky Search & Collapsible Filters Bar (Always Accessible Without Scrolling) -->
            <Border BackgroundColor="{StaticResource SurfaceWhite}"
                    StrokeThickness="0"
                    Padding="12,8"
                    Shadow="{Shadow Brush='#18061A', Opacity='0.04', Radius='6', Offset='0,2'}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,64,68" ColumnSpacing="6">
                        <Border Style="{StaticResource InputBoxBorderStyle}" HeightRequest="42" Padding="10,0">
                            <Entry x:Name="SearchEntry"
                                   Placeholder="{Binding Loc[SearchPlaceholder]}"
                                   Text="{Binding SearchQuery}"
                                   ReturnType="Search"
                                   ReturnCommand="{Binding SearchCommand}"
                                   VerticalOptions="Center"
                                   Style="{StaticResource BrandEntryStyle}" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="{Binding Loc[SearchBtn]}"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryGoldButtonStyle}"
                                HeightRequest="42"
                                MinimumHeightRequest="42"
                                FontSize="12"
                                Padding="0" />
                        <Button Grid.Column="2"
                                Text="{Binding Loc[FiltersBtn]}"
                                Command="{Binding ToggleFiltersCommand}"
                                Style="{StaticResource SecondaryCreamButtonStyle}"
                                HeightRequest="42"
                                MinimumHeightRequest="42"
                                FontSize="12"
                                Padding="0" />
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsFiltersExpanded}" Spacing="8" Padding="0,2,0,2">
                        <!-- Categories in Sticky Panel -->
                        <CollectionView ItemsSource="{Binding Categories}"
                                        HeightRequest="38"
                                        HorizontalScrollBarVisibility="Never"
                                        ItemsLayout="HorizontalList"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ui:CategoryChipItem">
                                    <Border Margin="3,2"
                                            Padding="11,4"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource CardBorder}"
                                            BackgroundColor="{StaticResource SurfaceWhite}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPurple}" />
                                                <Setter Property="Stroke" Value="{StaticResource BrandPurple}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.SelectCategoryCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayTitle}"
                                               FontFamily="Cairo"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource BrandInk}"
                                               VerticalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Grade Levels in Sticky Panel -->
                        <CollectionView ItemsSource="{Binding Grades}"
                                        HeightRequest="38"
                                        HorizontalScrollBarVisibility="Never"
                                        ItemsLayout="HorizontalList"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ui:GradeChipItem">
                                    <Border Margin="3,2"
                                            Padding="11,4"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource CardBorder}"
                                            BackgroundColor="{StaticResource BrandPaper}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                                <Setter Property="Stroke" Value="{StaticResource BrandGoldDark}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.SelectGradeCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayTitle}"
                                               FontFamily="Cairo"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource BrandInk}"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding Loc[SortByLabel]}" Style="{StaticResource MutedLabelStyle}" VerticalTextAlignment="Center" />
                            <controls:BrandDropdown Grid.Column="1"
                                                    Title="{Binding Loc[SortTitle]}"
                                                    ItemsSource="{Binding SortOptions}"
                                                    SelectedItem="{Binding SelectedSortOption}" />
                            <Button Grid.Column="2"
                                    Text="{Binding Loc[ClearFilters]}"
                                    Command="{Binding ClearFiltersCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource BrandPurple}"
                                    FontFamily="Cairo"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Padding="6,4" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Scrollable Store Content with Pull-to-Refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource BrandGold}">
            <ScrollView x:Name="HomeScroll">
                <VerticalStackLayout Spacing="12" Padding="0,10,0,28">

                    <!-- Announcement Banner -->
                    <Border IsVisible="{Binding HasAnnouncement}"
                            BackgroundColor="{StaticResource BrandGoldSoft}"
                            Stroke="#E8DAB8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8"
                            Margin="16,0">
                        <Label Text="{Binding AnnouncementText}"
                               Style="{StaticResource BodyLabelStyle}"
                               FontSize="12"
                               FontAttributes="Bold"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    

                    

                    <!-- Trust Highlights Strip -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="16,0">
                        <Border BackgroundColor="{StaticResource SurfaceWhite}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="6,7">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="icon_audio.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                <Label Text="{Binding Loc[TrustAudio]}" FontFamily="Cairo" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceWhite}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="6,7">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="icon_shield.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                <Label Text="{Binding Loc[TrustQuality]}" FontFamily="Cairo" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource SurfaceWhite}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="6,7">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="icon_truck.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                <Label Text="{Binding Loc[TrustShipping]}" FontFamily="Cairo" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Categories Chips -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6" Margin="16,0">
                            <BoxView WidthRequest="3" HeightRequest="16" Color="{StaticResource BrandGold}" VerticalOptions="Center" />
                            <Label Text="{Binding Loc[BrowseByCategory]}" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding Categories}"
                                        HeightRequest="44"
                                        Margin="12,0"
                                        HorizontalScrollBarVisibility="Never"
                                        ItemsLayout="HorizontalList"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ui:CategoryChipItem">
                                    <Border Margin="4,2"
                                            Padding="12,6"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="1.2"
                                            Stroke="{StaticResource CardBorder}"
                                            BackgroundColor="{StaticResource SurfaceWhite}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPurple}" />
                                                <Setter Property="Stroke" Value="{StaticResource BrandPurple}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.SelectCategoryCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="{Binding IconName}" WidthRequest="17" HeightRequest="17" IsVisible="{Binding HasIcon}" />
                                            <Label Text="{Binding DisplayTitle}"
                                                   FontFamily="Cairo"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandInk}"
                                                   VerticalTextAlignment="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>


                    <!-- Loading / Error -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" Margin="18,0" />

                    <!-- Featured Products Carousel -->
                    <VerticalStackLayout Spacing="8" Padding="16,4" IsVisible="{Binding HasFeatured}">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="3" HeightRequest="20" Color="{StaticResource BrandGold}" VerticalOptions="Center" />
                            <Label Text="{Binding Loc[FeaturedTitle]}" Style="{StaticResource SectionTitleStyle}" FontSize="19" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding FeaturedProducts}"
                                        HeightRequest="296"
                                        HorizontalScrollBarVisibility="Never"
                                        ItemsLayout="HorizontalList"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ui:ProductCardDisplayItem">
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            WidthRequest="178"
                                            Margin="0,2,10,6"
                                            Padding="10"
                                            Shadow="{Shadow Brush='#18061A', Opacity='0.07', Radius='10', Offset='0,4'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.OpenProductCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6">
                                            <Border BackgroundColor="{StaticResource BrandPaper}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 12"
                                                     HeightRequest="116"
                                                     Padding="6">
                                                <Grid>
                                                    <Image Source="logo.png" Aspect="AspectFit" Opacity="0.16" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Image Source="{Binding FullImageUrl}" Aspect="AspectFit" />
                                                    <Border BackgroundColor="{StaticResource SuccessSoft}"
                                                            Stroke="#A7DFC0"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="6,2"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="End"
                                                            IsVisible="{Binding HasTeacherVoice}">
                                                        <HorizontalStackLayout Spacing="3">
                                                            <Image Source="icon_mic.png" WidthRequest="11" HeightRequest="11" VerticalOptions="Center" />
                                                            <Label Text="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.Loc[ByTeacher]}" FontFamily="Cairo" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource SuccessGreen}" VerticalTextAlignment="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                    <Button Text="{Binding FavoriteIcon}"
                                                            Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.ToggleFavoriteCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{StaticResource SurfaceWhite}"
                                                            TextColor="{StaticResource BrandPurple}"
                                                            FontSize="14"
                                                            WidthRequest="30"
                                                            HeightRequest="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start" />
                                                </Grid>
                                            </Border>
                                            <Label Text="{Binding DisplayName}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DisplayPrice}" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandGoldDark}" />
                                            <Button Text="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.Loc[AddToCart]}"
                                                    Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.AddToCartCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsEnabled="{Binding InStock}"
                                                    Style="{StaticResource PrimaryPurpleButtonStyle}"
                                                    FontSize="12"
                                                    MinimumHeightRequest="36"
                                                    Padding="8,6" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    

                    <!-- Full Catalog Section -->
                    <VerticalStackLayout x:Name="ProductsSection" Spacing="10" Padding="16,4">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="3" HeightRequest="20" Color="{StaticResource BrandGold}" VerticalOptions="Center" />
                            <Label Text="{Binding Loc[AllCardsTitle]}" Style="{StaticResource SectionTitleStyle}" FontSize="19" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ResultSummary}" Style="{StaticResource MutedLabelStyle}" TextColor="{StaticResource BrandGoldDark}" />

                        <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ui:ProductCardDisplayItem">
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            Padding="10"
                                            Shadow="{Shadow Brush='#18061A', Opacity='0.06', Radius='8', Offset='0,3'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.OpenProductCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="5">
                                            <Border BackgroundColor="{StaticResource BrandPaper}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 12"
                                                     HeightRequest="118"
                                                     Padding="6">
                                                <Grid>
                                                    <Image Source="logo.png" Aspect="AspectFit" Opacity="0.16" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Image Source="{Binding FullImageUrl}" Aspect="AspectFit" />
                                                    <Border BackgroundColor="{StaticResource SuccessSoft}"
                                                            Stroke="#A7DFC0"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="6,2"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="End"
                                                            IsVisible="{Binding HasTeacherVoice}">
                                                        <HorizontalStackLayout Spacing="3">
                                                            <Image Source="icon_mic.png" WidthRequest="11" HeightRequest="11" VerticalOptions="Center" />
                                                            <Label Text="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.Loc[ByTeacher]}" FontFamily="Cairo" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource SuccessGreen}" VerticalTextAlignment="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                    <Button Text="{Binding FavoriteIcon}"
                                                            Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.ToggleFavoriteCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{StaticResource SurfaceWhite}"
                                                            TextColor="{StaticResource BrandPurple}"
                                                            FontSize="14"
                                                            WidthRequest="30"
                                                            HeightRequest="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start" />
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <Label Text="{Binding DisplayCategory}" Style="{StaticResource MutedLabelStyle}" FontSize="10" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding DisplayCardCount}" FontFamily="Cairo" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource BrandGoldDark}" />
                                            </Grid>
                                            <Label Text="{Binding DisplayName}" Style="{StaticResource BodyLabelStyle}" FontSize="13" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <Label Text="{Binding DisplayPrice}" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandGoldDark}" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding DisplayStockText}" Style="{StaticResource MutedLabelStyle}" FontSize="10" VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Button Text="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.Loc[AddToCart]}"
                                                    Command="{Binding Source={x:Reference ThisCatalogPage}, Path=BindingContext.AddToCartCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsEnabled="{Binding InStock}"
                                                    Style="{StaticResource PrimaryPurpleButtonStyle}"
                                                    FontSize="12"
                                                    MinimumHeightRequest="36"
                                                    Padding="8,6" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Pagination -->
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,8">
                            <Button Text="{Binding Loc[Previous]}"
                                    Command="{Binding PreviousPageCommand}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    Style="{StaticResource SecondaryCreamButtonStyle}" />
                            <Label Text="{Binding PageLabel}" Style="{StaticResource MutedLabelStyle}" VerticalTextAlignment="Center" />
                            <Button Text="{Binding Loc[Next]}"
                                    Command="{Binding NextPageCommand}"
                                    IsEnabled="{Binding CanGoNext}"
                                    Style="{StaticResource SecondaryCreamButtonStyle}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
