<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             xmlns:controls="clr-namespace:FlashcardsStore.Mobile.Controls"
             x:Class="FlashcardsStore.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- ==================== 1. GUEST / LOGIN VIEW ==================== -->
        <Grid IsVisible="{Binding IsNotSignedIn}">
            <!-- Top-Right Luxury Plum & Gold Corner Wave -->
            <Path Data="M 0,0 L 108,0 C 92,48 52,78 0,92 Z"
                  Fill="#4B1633"
                  Stroke="{StaticResource BrandGold}"
                  StrokeThickness="1.5"
                  HorizontalOptions="Start"
                  VerticalOptions="Start"
                  InputTransparent="True" />

            <ScrollView>
                <VerticalStackLayout Padding="24,22,24,28" Spacing="10">

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,4,0,2">
                        <Image Source="logo_gold.png" Aspect="AspectFit" HeightRequest="84" WidthRequest="170" HorizontalOptions="Center" />
                        <Label Text="أهلاً بعودتك" Style="{StaticResource HeadingLabelStyle}" FontSize="24" HorizontalTextAlignment="Center" />
                        <Label Text="سجّلي الدخول لمتابعة طلباتك وبطاقات طفلك"
                               Style="{StaticResource MutedLabelStyle}"
                               FontSize="13"
                               TextColor="{StaticResource BrandInk}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Gold Ornamental Divider -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,0,0,6">
                        <BoxView HeightRequest="1" WidthRequest="24" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                        <Label Text="♡" FontSize="15" TextColor="{StaticResource BrandGoldDark}" VerticalTextAlignment="Center" />
                        <BoxView HeightRequest="1" WidthRequest="24" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="البريد الإلكتروني" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" Margin="6,0" />
                    <Border BackgroundColor="{StaticResource SurfaceWhite}" Stroke="{StaticResource DividerGold}" StrokeThickness="1.2" StrokeShape="RoundRectangle 26" HeightRequest="52" Padding="16,0">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                            <Image Source="auth_email.png" WidthRequest="19" HeightRequest="19" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="أدخلي بريدك الإلكتروني" Keyboard="Email" Text="{Binding Email}" VerticalOptions="Center" Style="{StaticResource BrandEntryStyle}" />
                        </Grid>
                    </Border>

                    <Label Text="كلمة المرور" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" Margin="6,4,6,0" />
                    <Border BackgroundColor="{StaticResource SurfaceWhite}" Stroke="{StaticResource DividerGold}" StrokeThickness="1.2" StrokeShape="RoundRectangle 26" HeightRequest="52" Padding="16,0">
                        <Grid ColumnDefinitions="22,*,36" ColumnSpacing="10">
                            <Image Source="auth_lock.png" WidthRequest="19" HeightRequest="19" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="أدخلي كلمة المرور" IsPassword="{Binding IsPasswordHidden}" Text="{Binding Password}" VerticalOptions="Center" Style="{StaticResource BrandEntryStyle}" />
                            <ImageButton Grid.Column="2" Source="auth_eye.png" Command="{Binding TogglePasswordVisibilityCommand}" BackgroundColor="Transparent" Padding="6" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />

                    <Button Text="—   تسجيل الدخول   —"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#4B1633"
                            TextColor="White"
                            FontFamily="Cairo"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="26"
                            HeightRequest="52"
                            Margin="0,6,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />

                    <Label Text="نسيت كلمة المرور؟"
                           FontFamily="Cairo"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandInk}"
                           TextDecorations="Underline"
                           HorizontalOptions="Start"
                           Margin="6,2">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,4">
                        <BoxView HeightRequest="1" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="أو" FontFamily="Cairo" FontSize="14" TextColor="{StaticResource BrandGoldDark}" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                    </Grid>

                    <!-- WhatsApp Pill Button -->
                    <Border BackgroundColor="{StaticResource SurfaceWhite}" Stroke="{StaticResource WhatsAppBorder}" StrokeThickness="1.3" StrokeShape="RoundRectangle 26" HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ContactWhatsAppCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Image Source="icon_whatsapp.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="تواصلي معنا عبر واتساب" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource WhatsAppDark}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,6">
                        <Label Text="ليس لديك حساب؟" Style="{StaticResource BodyLabelStyle}" VerticalOptions="Center" />
                        <Label Text="إنشاء حساب جديد" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandGoldDark}" TextDecorations="Underline" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Subtle Onboarding Link for Guest -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,6,0,0">
                        <Image Source="icon_sparkles.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                        <Label Text="عرض الجولة التعريفية للمتجر" FontFamily="Cairo" FontSize="12" TextColor="{StaticResource MutedText}" VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReplayOnboardingCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ==================== 2. SIGNED-IN ACCOUNT & SETTINGS VIEW ==================== -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSignedIn}">
            <controls:BrandHeaderView Grid.Row="0"
                                      HeaderTitle="حسابي والإعدادات"
                                      HeaderSubtitle="إدارة حسابك وتفضيلات التطبيق" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16,14,16,28" Spacing="14">

                    <!-- Member Card -->
                    <Border Stroke="{StaticResource BrandGold}"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 20"
                            Padding="18"
                            Shadow="{Shadow Brush='#18061A', Opacity='0.14', Radius='12', Offset='0,5'}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#190611" Offset="0.0" />
                                <GradientStop Color="#3A102A" Offset="0.6" />
                                <GradientStop Color="#190611" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                            <Border BackgroundColor="#2A0B1E" Stroke="{StaticResource BrandGold}" StrokeThickness="1.5" StrokeShape="RoundRectangle 28" WidthRequest="56" HeightRequest="56" VerticalOptions="Center">
                                <Label Text="{Binding CustomerInitial}" FontFamily="Cairo" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource BrandGoldLight}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="5">
                                    <Image Source="icon_sparkles.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                    <Label Text="عضو أكاديمية خلود النادي" FontFamily="Cairo" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandGold}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding CustomerName}" FontFamily="Cairo" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BrandGoldLight}" />
                                <Label Text="{Binding CustomerEmail}" FontFamily="Cairo" FontSize="12" TextColor="#E6DDF0" />
                                <Label Text="{Binding CustomerPhone}" FontFamily="Cairo" FontSize="12" TextColor="#D9CEE0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Quick Account Shortcuts -->
                    <Label Text="الوصول السريع" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="10,12" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenOrdersCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Image Source="home_orders.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                                <Label Text="تتبع طلباتي" FontFamily="Cairo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="10,12" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenWishlistCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Image Source="home_favorite.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                                <Label Text="المفضلة" FontFamily="Cairo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,12" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Image Source="home_cart.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                                <Label Text="السلة" FontFamily="Cairo" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandInk}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- App & Support Settings Card -->
                    <Label Text="المساعدة والدعم" Style="{StaticResource SectionTitleStyle}" FontSize="16" Margin="0,4,0,0" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14,6" Shadow="{Shadow Brush='#18061A', Opacity='0.05', Radius='8', Offset='0,3'}">
                        <VerticalStackLayout Spacing="0">

                            <!-- Replay Onboarding -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ReplayOnboardingCommand}" />
                                </Grid.GestureRecognizers>
                                <Image Source="icon_sparkles.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="إعادة عرض الجولة التعريفية" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="←" FontSize="15" TextColor="{StaticResource BrandGoldDark}" VerticalTextAlignment="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                            <!-- WhatsApp Support -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ContactWhatsAppCommand}" />
                                </Grid.GestureRecognizers>
                                <Image Source="icon_whatsapp.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="تواصل مباشر مع ميس خلود (واتساب)" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="←" FontSize="15" TextColor="{StaticResource WhatsAppDark}" VerticalTextAlignment="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Logout -->
                    <Button Text="تسجيل الخروج"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="#4B1633"
                            TextColor="White"
                            FontFamily="Cairo"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="26"
                            HeightRequest="50"
                            Margin="0,6,0,0" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>
