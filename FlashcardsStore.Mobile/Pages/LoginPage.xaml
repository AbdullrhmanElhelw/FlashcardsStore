<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashcardsStore.Mobile.ViewModels"
             x:Class="FlashcardsStore.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Top-Right Luxury Plum & Gold Corner Wave (Matches Reference) -->
        <Path Data="M 0,0 L 108,0 C 92,48 52,78 0,92 Z"
              Fill="#4B1633"
              Stroke="{StaticResource BrandGold}"
              StrokeThickness="1.5"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Padding="24,22,24,28" Spacing="10">

                <!-- Brand Header -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,4,0,2">
                    <Image Source="logo_gold.png" Aspect="AspectFit" HeightRequest="86" WidthRequest="175" HorizontalOptions="Center" />
                    <Label Text="أهلاً بعودتك" Style="{StaticResource HeadingLabelStyle}" FontSize="24" HorizontalTextAlignment="Center" />
                    <Label Text="سجّلي الدخول لمتابعة طلباتك وبطاقات طفلك"
                           Style="{StaticResource MutedLabelStyle}"
                           FontSize="13"
                           TextColor="{StaticResource BrandInk}"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding IsNotSignedIn}" />
                </VerticalStackLayout>

                <!-- Gold Ornamental Divider -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,0,0,6">
                    <BoxView HeightRequest="1" WidthRequest="24" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                    <Label Text="♡" FontSize="15" TextColor="{StaticResource BrandGoldDark}" VerticalTextAlignment="Center" />
                    <BoxView HeightRequest="1" WidthRequest="24" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Signed-Out: Login Form -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNotSignedIn}">
                    <Label Text="البريد الإلكتروني" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" Margin="6,0" />
                    <Border BackgroundColor="{StaticResource SurfaceWhite}"
                            Stroke="{StaticResource DividerGold}"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 26"
                            HeightRequest="52"
                            Padding="16,0">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                            <Image Source="auth_email.png" WidthRequest="19" HeightRequest="19" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="أدخلي بريدك الإلكتروني"
                                   Keyboard="Email"
                                   Text="{Binding Email}"
                                   VerticalOptions="Center"
                                   Style="{StaticResource BrandEntryStyle}" />
                        </Grid>
                    </Border>

                    <Label Text="كلمة المرور" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" Margin="6,4,6,0" />
                    <Border BackgroundColor="{StaticResource SurfaceWhite}"
                            Stroke="{StaticResource DividerGold}"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 26"
                            HeightRequest="52"
                            Padding="16,0">
                        <Grid ColumnDefinitions="22,*,36" ColumnSpacing="10">
                            <Image Source="auth_lock.png" WidthRequest="19" HeightRequest="19" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="أدخلي كلمة المرور"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   Text="{Binding Password}"
                                   VerticalOptions="Center"
                                   Style="{StaticResource BrandEntryStyle}" />
                            <ImageButton Grid.Column="2"
                                         Source="auth_eye.png"
                                         Command="{Binding TogglePasswordVisibilityCommand}"
                                         BackgroundColor="Transparent"
                                         Padding="6"
                                         WidthRequest="32"
                                         HeightRequest="32"
                                         VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasError}"
                           HorizontalTextAlignment="Center" />

                    <!-- Pill Primary Button -->
                    <Button Text="—   تسجيل الدخول   —"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#4B1633"
                            TextColor="White"
                            FontFamily="Cairo"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="26"
                            HeightRequest="52"
                            Margin="0,6,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandGold}" />

                    <Label Text="نسيت كلمة المرور؟"
                           FontFamily="Cairo"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandInk}"
                           TextDecorations="Underline"
                           HorizontalOptions="Start"
                           Margin="6,2">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,4">
                        <BoxView HeightRequest="1" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="أو" FontFamily="Cairo" FontSize="14" TextColor="{StaticResource BrandGoldDark}" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource DividerGold}" VerticalOptions="Center" />
                    </Grid>

                    <!-- WhatsApp Pill Outline Button -->
                    <Border BackgroundColor="{StaticResource SurfaceWhite}"
                            Stroke="{StaticResource WhatsAppBorder}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 26"
                            HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ContactWhatsAppCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Image Source="icon_whatsapp.png" WidthRequest="22" HeightRequest="22" />
                            <Label Text="تواصلي معنا عبر واتساب"
                                   FontFamily="Cairo"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource WhatsAppDark}"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Register Footer Link -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8">
                        <Label Text="ليس لديك حساب؟" Style="{StaticResource BodyLabelStyle}" VerticalOptions="Center" />
                        <Label Text="إنشاء حساب جديد"
                               FontFamily="Cairo"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandGoldDark}"
                               TextDecorations="Underline"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Signed-In: Profile Summary -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsSignedIn}">
                    <Border Stroke="{StaticResource BrandGold}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="18"
                            Shadow="{Shadow Brush='#18061A', Opacity='0.12', Radius='10', Offset='0,4'}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A0B1E" Offset="0.0" />
                                <GradientStop Color="#4B1633" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="عضو أكاديمية خلود النادي" FontFamily="Cairo" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandGold}" />
                            <Label Text="{Binding CustomerName}" FontFamily="Cairo" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource BrandGoldLight}" />
                            <Label Text="{Binding CustomerEmail, StringFormat='البريد الإلكتروني: {0}'}" FontFamily="Cairo" FontSize="13" TextColor="#E6DDF0" />
                            <Label Text="{Binding CustomerPhone, StringFormat='رقم الهاتف: {0}'}" FontFamily="Cairo" FontSize="13" TextColor="#E6DDF0" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="تسجيل الخروج"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="#4B1633"
                            TextColor="White"
                            FontFamily="Cairo"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="26"
                            HeightRequest="50" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
