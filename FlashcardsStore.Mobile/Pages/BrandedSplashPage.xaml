<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashcardsStore.Mobile.Pages.BrandedSplashPage"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#190611" Offset="0.0" />
            <GradientStop Color="#2D0C22" Offset="0.5" />
            <GradientStop Color="#190611" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- Subtle Gold & Plum Corner Accents -->
        <Path Data="M 0,0 L 140,0 C 115,65 65,105 0,120 Z"
              Fill="#3A102A"
              Stroke="#55D4AF37"
              StrokeThickness="1.2"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              InputTransparent="True" />

        <Path Data="M 140,120 L 0,120 C 25,55 75,15 140,0 Z"
              Fill="#3A102A"
              Stroke="#44D4AF37"
              StrokeThickness="1.2"
              HorizontalOptions="End"
              VerticalOptions="End"
              InputTransparent="True" />

        <!-- Center Brand Emblem & Typography -->
        <VerticalStackLayout x:Name="BrandMark"
                             Spacing="10"
                             Padding="28"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <Border BackgroundColor="#220818"
                    Stroke="#55D4AF37"
                    StrokeThickness="1.2"
                    StrokeShape="RoundRectangle 95"
                    WidthRequest="190"
                    HeightRequest="190"
                    Padding="20"
                    HorizontalOptions="Center"
                    Shadow="{Shadow Brush='#D4AF37', Opacity='0.18', Radius='24', Offset='0,0'}">
                <Image Source="logo_gold.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Gold Ornamental Divider -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,8,0,2">
                <BoxView HeightRequest="1" WidthRequest="28" Color="#66D4AF37" VerticalOptions="Center" />
                <Label Text="✦" FontSize="13" TextColor="{StaticResource BrandGold}" VerticalTextAlignment="Center" />
                <BoxView HeightRequest="1" WidthRequest="28" Color="#66D4AF37" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="BrandTitle"
                   Text="أكاديمية خلود النادي"
                   FontFamily="Cairo"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandGoldLight}"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="BrandSubtitle"
                   Text="بطاقات الفلاش كاردز التعليمية التفاعلية"
                   FontFamily="Cairo"
                   FontSize="13"
                   TextColor="{StaticResource BrandGold}"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource BrandGold}"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
