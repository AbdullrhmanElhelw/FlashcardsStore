<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:FlashcardsStore.Mobile.Models.Ui"
             x:Class="FlashcardsStore.Mobile.Pages.BrandPickerPage"
             x:Name="ThisPickerPage"
             BackgroundColor="#8818061A"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid Padding="24">
        <Border x:Name="PickerCard"
                BackgroundColor="{StaticResource SurfaceWhite}"
                Stroke="{StaticResource BrandGold}"
                StrokeThickness="1.2"
                StrokeShape="RoundRectangle 22"
                Padding="18,18"
                VerticalOptions="Center"
                MaximumHeightRequest="480"
                Shadow="{Shadow Brush='#18061A', Opacity='0.25', Radius='20', Offset='0,8'}">

            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

                <!-- Header -->
                <VerticalStackLayout Grid.Row="0" Spacing="6">
                    <Label x:Name="TitleLabel"
                           Style="{StaticResource SectionTitleStyle}"
                           FontSize="17"
                           HorizontalTextAlignment="Center" />
                    <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />
                </VerticalStackLayout>

                <!-- Options List -->
                <CollectionView Grid.Row="1"
                                x:Name="OptionsList"
                                SelectionMode="None"
                                MaximumHeightRequest="320">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ui:PickerOptionItem">
                            <Border Margin="0,3"
                                    Padding="14,11"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource CardBorder}"
                                    BackgroundColor="{StaticResource BrandPaper}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldSoft}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandGold}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOptionTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Label}"
                                           FontFamily="Cairo"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource BrandInk}"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1"
                                           Text="✓"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource BrandPurple}"
                                           IsVisible="{Binding IsSelected}"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Cancel -->
                <Button x:Name="CancelButton"
                        Grid.Row="2"
                        Clicked="OnCancelClicked"
                        Style="{StaticResource SecondaryCreamButtonStyle}"
                        MinimumHeightRequest="44" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
