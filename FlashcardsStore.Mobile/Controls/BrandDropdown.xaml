<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashcardsStore.Mobile.Controls.BrandDropdown">

    <Border BackgroundColor="{StaticResource SurfaceWhite}"
            Stroke="{StaticResource CardBorder}"
            StrokeThickness="1.2"
            StrokeShape="RoundRectangle 14"
            Padding="14,10"
            MinimumHeightRequest="46">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnDropdownTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label x:Name="DisplayLabel"
                   FontFamily="Cairo"
                   FontSize="14"
                   TextColor="{StaticResource BrandInk}"
                   VerticalTextAlignment="Center"
                   LineBreakMode="TailTruncation" />
            <Label Grid.Column="1"
                   Text="⌄"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandGoldDark}"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>
