<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>FlashcardsStore.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<EnableDefaultAndroidItems>false</EnableDefaultAndroidItems>

		<ApplicationTitle>أكاديمية خلود النادي</ApplicationTitle>
		<ApplicationId>com.kholoudelnady.flashcards</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<AndroidManifestPlaceholders>usesCleartextTraffic=false</AndroidManifestPlaceholders>
		<PublishReadyToRun>false</PublishReadyToRun>

		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<AndroidManifestPlaceholders>usesCleartextTraffic=true</AndroidManifestPlaceholders>
	</PropertyGroup>

	<ItemGroup>
		<!-- Brand icon & splash (same logo as the website) -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#18061A" BaseSize="128,128" />
		<MauiSplashScreen Include="Resources\Splash\splash_logo.png" Color="#260B18" BaseSize="250,250" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
